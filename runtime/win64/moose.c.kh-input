      for(int i=0;i<3;i++){ u64 e=mem+(u64)i*ENT; wr32(g,e+0x48,(u32)k3[i]); wr64(g,e+0x50,z3[i]); wr64(g,e+0x58,0x144000000ull+0x100000ull*(u64)i);
          if(i<2) snprintf((char*)hp(g,e+4),32,i?"obj/T31B.mdlx":"obj/T31A.mdlx"); else memcpy(hp(g,e+4),"ab\1",3);
          wr32(g,e+0x70,i<2?(u32)kh_call(g,F_PTR2ID,mem+(u64)(i+1)*ENT,0,0,0):0); }

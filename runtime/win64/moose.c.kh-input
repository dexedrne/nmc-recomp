        f=fopen(p,"w"); fputs("[kh2.cache]\nplayer = 0x100\n[kh2.data]\n",f); fclose(f); CHECK(ini_parse(p,&c)==1 && c.cache_kib==122880 && !c.has_data && c.data_kib==0 && c.add_kib[1]==256);   /* missing cache size: the DLL's 120 MiB */

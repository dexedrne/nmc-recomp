      u64 c0[2][2]; for(int i=0;i<2;i++) for(int j=0;j<2;j++) c0[i][j]=c_patch[i][j];
      for(int m=0;m<4;m++){                                                                    /* every combination of the two switches */
          k.has_scd=1; k.scd_priority=(m&1)?1:0; k.has_fast=1; k.fast_title=(m&2)?1:0;
          apply_hacks(g,&k,1);
          CHECK(!memcmp(hp(g,GS_BASE+0x927e2),(m&1)?new0:old0,5) && !memcmp(hp(g,GS_BASE+0x2b46eb),(m&2)?new1:old1,5));   /* the image holds the patch exactly when it is on */
          CHECK(rd8(g,GS_BASE+0x927e1)!=0x31 && rd8(g,GS_BASE+0x927e7)==0x48 && rd8(g,GS_BASE+0x2b46f0)!=0x11);       /* nothing next to the 5 bytes is touched */

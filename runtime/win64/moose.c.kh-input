/* moose.c : the heap-size part of the mod's second DLL, KH2Moose.dll ("KH2 Memory Origin Overhauling System Enhancement"), which the
 * NMC mod ships with KH2Moose.ini next to it.  Everything below was read from the DLL's and the exe's disassembly (objdump; no
 * DLL code was executed); nothing here is copied from either.
 *
 * What the exe does (vanilla):
 *   cache  a static 30 MiB array in .bss, [0x140bf33c0, 0x1429f33c0).  Its start is a code constant at two sites
 *          (lea reg,[rip+0x140bf33c0]); the top-of-free pointer is the global [0x140749740] (initial value 0x1429f33c0).
 *          Entries (resources: +1 state byte, +0x44 flags, +0x48 kind, +0x50 size, +0x58 address, +0x60 saved address, +0x70 id of
 *          the next entry; list head [0x1429f33c8], tail [0x1429f33d0]) are laid out bottom-up by 0x39d590 after every change;
 *          0x39d300 cuts temporary chunks from the top.  Kinds 1010 / 2300..2399 / 2410..2419 / 2420..2429 / 5000..5099 /
 *          5100..5199 live in reserved blocks whose sizes are the ints [0x1429fb428 + 4*index] (index 1 magic, 2 player, 3 and 4
 *          the two friends, 5 drive, 6 menu), set by 0x39e260 (index, size) and 0x39e270 (player, friend).
 *   data   a static 768 KiB array in .bss, [0x142a254c0, 0x142ae54c0), a bump heap: next free byte in [0x142a25488]; 0x3e5f90
 *          resets it (lea rax,[pool]), 0x3e5f30 releases every block from the pool start (lea rbx,[pool]).  The allocators
 *          (0x3e5ee0, 0x3e5fa0, 0x3e6010) never check the end of the pool.
 *
 * What KH2Moose does to it (ini keys in KiB; the sites are found by byte patterns, each must match exactly once):
 *   [kh2.cache] size   buffer = operator new(size, align 0x2000000) = _aligned_malloc(size, 32 MiB): one window of the object-id
 *                      table per 32 MiB, aligned (512 MiB = 16 windows).  Writes: [0x140bf33c0] = buffer (the first 8 bytes of the
 *                      old static pool now hold the pointer), [0x140749740] = buffer + size.  Code: 0x39d719 `lea r14,[0x140bf33c0]`
 *                      (4c 8d 35 a0 5c 85 00) and 0x39dac1 `lea rdi,[0x140bf33c0]` (48 8d 3d f8 58 85 00) are re-encoded as
 *                      `mov reg,[0x140bf33c0]`: the base is read from the pointer.  A missing key means 122,880 KiB, 0 = leave it.
 *   [kh2.data] size    buffer as above; [0x142a254c0] = buffer; 0x3e5f90 `lea rax,[0x142a254c0]` (48 8d 05 29 f5 63 02) and
 *                      0x3e5f3d `lea rbx,[0x142a254c0]` (48 8d 1d 7c f5 63 02) become `mov reg,[0x142a254c0]`.  Missing or 0 = leave it.
 *   [kh2.cache] magic / player / friend / drive / menu  ("reserved block size increases", each at most 0x1fffff KiB): inline hooks
 *                      at the entry of 0x39e260 (size += increase of that index: 1 magic, 2 player, 3 and 4 friend, 5 drive,
 *                      6 menu) and of 0x39e270 (player += player increase, friend += friend increase); signed saturating adds.
 *   [kh2.fixes] scd_priority  (Task 23; DLL 0x180003050; a missing key means 1, value 0 = nothing.)  Bit 1 "Voice": the 5-byte
 *                      `call 0x1400ae1e0` at exe 0x927e2 (the lookup in the sound priority table; `test rax,rax / je` follows) is
 *                      re-encoded as `xor eax,eax` and a 3-byte NOP (31 c0 0f 1f 00): the lookup always "finds nothing".  Bit 2
 *                      "Sound effects" is a second patch at exe 0x92758 (not set in the shipped ini: a named fatal here).
 *   [kh2.hacks] fast_title    (Task 23; DLL 0x180001fba; a missing key means OFF.)  exe 0x2b46eb `lea edi,[r12-0xc]` (edi = 8)
 *                      becomes `mov edi,0x11` (bf 11 00 00 00), the value the other branch loads at 0x1402b46fc.  (An earlier
 *                      version of this comment and implementation notes said `mov edi,0`: wrong, the request's immediate is 0x11.)
 *                      Both patches go through the DLL's 0x18000b640: VirtualProtect, the encoder library writes the instruction,
 *                      the rest of the 5 bytes is filled from the DLL's NOP table.  tools/gen_mod_moose.py reads the request
 *                      fields, the patterns and the NOP bytes from the DLL file and writes gen/mod_moose_table.h; the two
 *                      functions (0x92680, 0x2b4590) are re-lifted from the patched image by the Task 12 mechanism, and the hooks
 *                      below run the patched body only when the ini turns the patch on (kh_moose_init), the vanilla body otherwise.
 *   [kh2.hacks] no_death (a missing key means off; a patch at exe 0x404d60) and test_crash (a deliberate write to address 0):
 *                      not set in the shipped ini, a named fatal here if someone sets them.
 *   [kh2.hacks] attempt_continue_after_exception_but_probably_make_things_worse  (DLL 0x180002144; a missing key means ON, as does
 *                      the shipped value 1.)  The DLL registers a FIRST-CHANCE vectored exception handler (0x18000c670:
 *                      AddVectoredExceptionHandler(1, 0x18000bbf0)).  NOT emulated here (see kh_moose_fault_note); what it does,
 *                      decoded from the listing and its four jump tables (0xc360 / 0xc36c by exception code, 0xc3fc / 0xc510 by
 *                      register id):
 *                        1. It logs the exception, then gives up (returns 0 = EXCEPTION_CONTINUE_SEARCH, the game dies as without
 *                           the DLL) when there is no record, when ExceptionFlags has EXCEPTION_NONCONTINUABLE, or when the code is
 *                           not one of:
 *                             0xC0000005 access violation, 0x80000002 datatype misalignment, 0xC0000006 in-page error,
 *                             0xC000008C array bounds exceeded      -- these four only with NumberParameters >= 1 and
 *                                                                     ExceptionInformation[0] <= 1, i.e. a READ or a WRITE (not 8,
 *                                                                     an instruction fetch: a call / jump to a bad address);
 *                             0xC000008D..0xC0000091 and 0xC0000093..0xC0000095 (the floating-point codes except stack check, integer
 *                             divide by zero, integer overflow) -- without a parameter test.
 *                        2. It decodes the instruction at ExceptionAddress (64-bit mode, the DLL's disassembler library); decode
 *                           failure = give up.
 *                        3. For every operand that is a REGISTER and is WRITTEN by the instruction it changes the thread context:
 *                           64- and 32-bit general registers = 0; 16-bit ones: `Rxx &= 0xffff0000`, low 8-bit ones `&= 0xffffff00`,
 *                           AH/CH/DH/BH `&= 0xffff00ff` (the masks are 32-bit constants and-ed as qwords, so bits 32..63 are cleared
 *                           as well); x87 / MMX registers and XMM0..15 = 0; the x87 control, status and tag words = 0; segment
 *                           registers = 0; DR0..DR3 = 0 with their enable bits in DR7 cleared; a write of the flags register is
 *                           ignored.  It GIVES UP (the game dies) when a written register is IP / EIP / RIP (so a call, jmp or
 *                           ret is never skipped), XMM16+ / YMM / ZMM / TMM, or any id from 204 on other than DR0..DR3 (table,
 *                           control, test, bound, mask registers ...).  Memory operands are not touched: a faulting store is
 *                           simply lost, a faulting load leaves 0 in its destination register.
 *                        4. EFlags: the flags the instruction modifies or sets to 0 are cleared, the ones it sets to 1 are set.
 *                        5. Rip += the instruction's length; it returns -1 = EXCEPTION_CONTINUE_EXECUTION.  (The first time it also
 *                           marks the game's window title.)
 *                      So with this ini the modded PC game runs on through null / wild reads and writes and divisions by zero
 *                      in game or DLL code, where the unmodded game (and this port) stops.
 *
 * What this file does: the same data writes at start-up, with the buffers taken from the id zone as 32 MiB-aligned page runs
 * (ga_pages_aligned: committed on demand, deterministic addresses).  A lifted function cannot have one instruction re-encoded, so
 * the four functions that contain the patched instructions are replaced by hand-written equivalents that take the pool start as a
 * parameter: 0x39d590 (cache layout), 0x39dab0 (free cache bytes), 0x3e5f30 and 0x3e5f90 (data heap).  Each is checked against the
 * untouched lifted original in the selftest (same inputs, the vanilla pool start: identical memory afterwards).  The two block-size
 * functions are wrapper hooks.  KHNMC_MOOSE_HEAPS=0 keeps the vanilla sizes (every hook passes through to the lifted original);
 * without $KHNMC_DATA/dll/KH2Moose.ini (or $KHNMC_MOOSE_INI) nothing is changed either, and the start-up line says so. */
#include "khnmc_rt.h"
#include <errno.h>
#include <unistd.h>
#include <signal.h>
#ifdef __APPLE__
#include <sys/ucontext.h>          /* <ucontext.h> itself refuses to be included on Darwin without _XOPEN_SOURCE; the type is all that is needed here (as runtime/core.c) */
#else
#include <ucontext.h>
#endif
#include <sys/wait.h>
#include "mod_moose_table.h"                      /* generated by tools/gen_mod_moose.py: the two ini-switched code patches */

#define CACHE_STATIC  (GS_BASE+0xbf33c0ull)       /* start of the static cache pool; with Moose: holds the pointer to the new one */
#define CACHE_STATIC_SIZE 0x1e00000ull
#define CACHE_TOP     (GS_BASE+0x749740ull)       /* top of the free part of the cache */
#define LIST_HEAD     (GS_BASE+0x29f33c8ull)
#define LIST_TAIL     (GS_BASE+0x29f33d0ull)
#define TMP_HEAD      (GS_BASE+0x29f33d8ull)
#define TMP_TAIL      (GS_BASE+0x29f33e0ull)
#define EVICT_OBJ     (GS_BASE+0x29f33e8ull)      /* object whose vtable slot 2 takes an evicted entry */
#define LAYOUT_TOP    (GS_BASE+0x29f33f0ull)
#define BLK           (GS_BASE+0x29fb428ull)      /* 7 ints: reserved block sizes */
#define DATA_STATIC   (GS_BASE+0x2a254c0ull)
#define DATA_STATIC_SIZE 0xc0000ull
#define DATA_PTR      (GS_BASE+0x2a25488ull)
#define F_PTR2ID      (GS_BASE+0x4ad240ull)
#define F_ID2PTR      (GS_BASE+0x4ad270ull)
#define F_REINSERT    (GS_BASE+0x39dd70ull)
#define F_UNLINK      (GS_BASE+0x39e2a0ull)
#define F_BAR_RELEASE (GS_BASE+0x3a6a10ull)
void orig_f_39d590(KCtx *g); void orig_f_39dab0(KCtx *g); void orig_f_3e5f30(KCtx *g); void orig_f_3e5f90(KCtx *g); void orig_f_39e260(KCtx *g); void orig_f_39e270(KCtx *g);

typedef struct { s64 cache_kib, data_kib, add_kib[5]; int has_cache, has_data; char err[160];              /* add_kib: magic, player, friend, drive, menu */
                 s64 scd_priority, fast_title, cont, no_death, test_crash; int has_scd, has_fast, has_cont, has_no_death, has_test_crash; } MooseCfg;
static int cache_moved, data_moved, blocks_on;          /* which parts are applied */
static int force_static;                                 /* selftest: run the replacements on the vanilla pools */
static u64 cache_base, cache_size, data_base, data_size;
static s32 add_bytes[5];
static char ini_path[1024]; static const char *state="not initialised";
static int continue_on, continue_default;                /* [kh2.hacks] attempt_continue_after_exception_...: the DLL's exception handler is installed (default: key missing) */
int kh_moose_continue_on(void){ return continue_on; }
static int patch_on[KH_MOOSE_NPATCH];                    /* the ini turns the code patch on: its function runs the body re-lifted from the patched image */
static _Atomic u64 c_patch[KH_MOOSE_NPATCH][2];          /* calls of the function with the patch off / on */
static _Atomic u64 c_layout, c_free_q, c_data_reset, c_data_release, c_blk_set, c_party_set, c_evict;
static u64 hw_cache_bottom, hw_cache_top_used, hw_data, hw_entries;     /* high-water marks (bytes), sampled once per game frame and at every layout */

/* ---- the DLL's arithmetic -------------------------------------------------------------------------------------------------------- */
static s32 sat_add(s32 a,s32 b){                         /* 0x180003470 */
    if(a>=0) return b>=0x7fffffff-a?0x7fffffff:a+b;
    return b<=(s32)(0x80000000u-(u32)a)?(s32)0x80000000u:a+b;
}
static s32 blk_add_for(int index){                       /* 0x180003010: the table starts one int before `magic`; indices 4.. use the entry before */
    int k=index-(index>=4); return (k>=1&&k<=5)?add_bytes[k-1]:0;
}

/* ---- the four functions with a patched instruction, pool start as a parameter ----------------------------------------------------- */
static u64 id2p(KCtx *g,u32 id){ return kh_call(g,F_ID2PTR,id,0,0,0); }
static u32 p2id(KCtx *g,u64 p){ return p?(u32)kh_call(g,F_PTR2ID,p,0,0,0):0; }      /* 0x4ad240 returns 0 for NULL without touching the table */
/* 0x39d590: lay the cache out again */
static void cache_layout(KCtx *g,u64 base){
    wr64(g,TMP_TAIL,0); wr64(g,TMP_HEAD,0);
    /* 1. entries of kind >= 10000 leave the list and are queued, in list order */
    for(u64 e=rd64(g,LIST_HEAD),next;e;e=next){
        next=id2p(g,rd32(g,e+0x70)); u64 head=rd64(g,LIST_HEAD), prev;
        if((s32)rd32(g,e+0x48)<10000) continue;
        if(e==head){ wr64(g,LIST_HEAD,id2p(g,rd32(g,e+0x70))); prev=0; }
        else { prev=head; while(id2p(g,rd32(g,prev+0x70))!=e) prev=id2p(g,rd32(g,prev+0x70)); wr32(g,prev+0x70,p2id(g,id2p(g,rd32(g,e+0x70)))); }
        if(rd64(g,LIST_TAIL)==e) wr64(g,LIST_TAIL,prev);
        wr32(g,e+0x70,0);
        if(!rd64(g,TMP_TAIL)){ wr64(g,TMP_TAIL,e); wr64(g,TMP_HEAD,e); }
        else { wr32(g,rd64(g,TMP_TAIL)+0x70,p2id(g,e)); wr32(g,e+0x70,0); wr64(g,TMP_TAIL,e); }
    }
    /* 2. ... and are inserted again by 0x39dd70 (sorted by kind) */
    for(u64 e=rd64(g,TMP_HEAD),next;e;e=next){ next=id2p(g,rd32(g,e+0x70)); kh_call(g,F_REINSERT,e,0,0,0); }
    /* 3. addresses: negative kinds from the top down, the others bottom-up; a reserved block is opened at the running pointer when
     *    its first entry comes by.  An entry of kind >= 10000 that ends above the top, or is the 129th or later, is evicted. */
    u64 top=rd64(g,CACHE_TOP), G=base, P[7]={0,0,0,0,0,0,0}; u32 count=0;
    for(u64 e=rd64(g,LIST_HEAD),next;e;e=next,count++){
        next=id2p(g,rd32(g,e+0x70));
        wr32(g,e+0x44,0);
        s32 kind=(s32)rd32(g,e+0x48);
        if(kind<0){ top-=rd64(g,e+0x50); wr64(g,e+0x58,top); continue; }
        int b=0;
        if(kind==0x3f2) b=1; else if((u32)(kind-0x8fc)<=0x63u) b=2; else if((u32)(kind-0x96a)<=9u) b=3; else if((u32)(kind-0x974)<=9u) b=4;
        else if((u32)(kind-0x1388)<=0x63u) b=5; else if((u32)(kind-0x13ec)<=0x63u && (s32)rd32(g,BLK+24)>0) b=6;
        u64 *slot=b?&P[b]:&G;
        if(!*slot){ *slot=G; G+=(u64)(s64)(s32)rd32(g,BLK+4ull*(u64)b); }               /* the block starts at the running pointer, which skips its reserved size */
        u64 addr=*slot, end=addr+rd64(g,e+0x50);
        wr64(g,e+0x58,addr); *slot=end; if(end>G) G=end;
        if(kind>=10000 && (end>top || (s32)count>=0x80)){
            u64 saved=rd64(g,e+0x60); wr64(g,e+0x58,saved);
            if(rd8(g,e+1)==3){
                atomic_fetch_add(&c_evict,1);
                kh_call(g,F_BAR_RELEASE,saved,1,0,0); kh_call(g,F_UNLINK,e,0,0,0);
                u64 obj=rd64(g,EVICT_OBJ); kh_call(g,rd64(g,rd64(g,obj)+0x10),obj,e,0,0);
            }
        }
    }
    wr64(g,LAYOUT_TOP,top);
}
/* 0x39dab0: bytes between the highest bottom entry and the lowest top entry (32-bit, as the original computes it) */
static u32 cache_free_bytes(KCtx *g,u64 base){
    u64 hi=rd64(g,CACHE_TOP), lo=base;
    for(u64 e=rd64(g,LIST_HEAD);e;e=id2p(g,rd32(g,e+0x70))){
        s32 kind=(s32)rd32(g,e+0x48); if(kind>=10000) continue;
        u64 addr=rd64(g,e+0x58); if(kind<0) hi=addr; else lo=rd64(g,e+0x50)+addr;
    }
    return (u32)hi-(u32)lo;
}
/* 0x3e5f30: release every block of the data heap (header: +0 size, +8 "is an archive" flag), then mark the heap closed */
static void data_release_all(KCtx *g,u64 base){
    u64 end=rd64(g,DATA_PTR);
    for(u64 b=base;b<end;){ if(rd32(g,b+8)){ kh_call(g,F_BAR_RELEASE,b+0x10,1,0,0); end=rd64(g,DATA_PTR); } b+=0x10+(u64)rd32(g,b); }
    wr64(g,DATA_PTR,0);
}
static u64 cur_cache_base(KCtx *g){ return force_static?CACHE_STATIC:cache_moved?rd64(g,CACHE_STATIC):0; }   /* the patched code reads the pointer every time */
static u64 cur_data_base(KCtx *g){ return force_static?DATA_STATIC:data_moved?rd64(g,DATA_STATIC):0; }
static void sample(KCtx *g);
void f_39d590(KCtx *g){ atomic_fetch_add(&c_layout,1); u64 b=cur_cache_base(g); if(!b){ orig_f_39d590(g); sample(g); return; } cache_layout(g,b); sample(g); KH_RET(g); }
void f_39dab0(KCtx *g){ atomic_fetch_add(&c_free_q,1); u64 b=cur_cache_base(g); if(!b){ orig_f_39dab0(g); return; } SET_RAX(g,cache_free_bytes(g,b)); KH_RET(g); }
void f_3e5f30(KCtx *g){ atomic_fetch_add(&c_data_release,1); u64 b=cur_data_base(g); if(!b){ orig_f_3e5f30(g); return; } data_release_all(g,b); KH_RET(g); }
void f_3e5f90(KCtx *g){ atomic_fetch_add(&c_data_reset,1); u64 b=cur_data_base(g); if(!b){ orig_f_3e5f90(g); return; } wr64(g,DATA_PTR,b); SET_RAX(g,b); KH_RET(g); }
/* the two inline hooks of cache_adjust_blocks */
void f_39e260(KCtx *g){ atomic_fetch_add(&c_blk_set,1); if(blocks_on) KH_RDX(g)=(u64)(u32)sat_add((s32)KH_RDX(g),blk_add_for((int)(s32)KH_RCX(g))); orig_f_39e260(g); }
void f_39e270(KCtx *g){ atomic_fetch_add(&c_party_set,1); if(blocks_on){ KH_RDX(g)=(u64)(u32)sat_add((s32)KH_RDX(g),add_bytes[2]); KH_RCX(g)=(u64)(u32)sat_add((s32)KH_RCX(g),add_bytes[1]); } orig_f_39e270(g); }

/* ---- the two ini-switched code patches (Task 23): exe 0x92680 (scd_priority bit 1) and exe 0x2b4590 (fast_title) ------------------ */
void orig_f_92680(KCtx *g); void mod_f_92680(KCtx *g); void orig_f_2b4590(KCtx *g); void mod_f_2b4590(KCtx *g);
static KhFn patch_body[KH_MOOSE_NPATCH][2]={{orig_f_92680,mod_f_92680},{orig_f_2b4590,mod_f_2b4590}};   /* [patch][off / on]; replaced by recorders in the selftest */
void kh_phase_title_entry(void);                         /* phase_log.c: the title.Layout.task counter stays in front */
void f_92680(KCtx *g){ int on=patch_on[0]; atomic_fetch_add(&c_patch[0][on],1); patch_body[0][on](g); }
void kh_phase_title_exit(void);                          /* ... and learns that the title task returned (Task 27: the route's title conditions) */
void f_2b4590(KCtx *g){ kh_phase_title_entry(); int on=patch_on[1]; atomic_fetch_add(&c_patch[1][on],1); patch_body[1][on](g); kh_phase_title_exit(); }
struct kh_mod_static_fn { u32 rva; KhFn mod, orig; int chained; };
extern const struct kh_mod_static_fn kh_mod_moose_fn_table[]; extern const u32 kh_mod_moose_fn_count;
extern KhFn kh_lookup(u64 target);

/* ---- usage statistics (both modes): how much of the pools the game really uses --------------------------------------------------- */
static u64 tab_id2p(u32 id){ if(!id) return 0; u64 b; u32 v=id&0x7fffffffu; memcpy(&b,(void*)((uintptr_t)(GS_BASE+0x2b0d720ull+8ull*(v>>25))+gs_bias),8); return b|(v&0x1ffffffu); }   /* read-only decode: no guest call from a statistics path */
static void sample(KCtx *g){
    u64 base=cache_moved?rd64(g,CACHE_STATIC):CACHE_STATIC, size=cache_moved?cache_size:CACHE_STATIC_SIZE, top=rd64(g,CACHE_TOP);
    if(top>=base && top<=base+size && base+size-top>hw_cache_top_used) hw_cache_top_used=base+size-top;
    u64 n=0; for(u64 e=rd64(g,LIST_HEAD);e&&GA_OK(e)&&GA_OK(e+0x78)&&n<100000;e=tab_id2p(rd32(g,e+0x70)),n++){
        s32 kind=(s32)rd32(g,e+0x48); u64 addr=rd64(g,e+0x58), end=addr+rd64(g,e+0x50);
        if(kind>=0 && addr>=base && end<=base+size && end-base>hw_cache_bottom) hw_cache_bottom=end-base; }
    if(n>hw_entries) hw_entries=n;
    u64 db=data_moved?rd64(g,DATA_STATIC):DATA_STATIC, dp=rd64(g,DATA_PTR); if(dp>db && dp-db>hw_data && dp-db<(1ull<<40)) hw_data=dp-db;
}
void kh_moose_game_frame(KCtx *g){ sample(g); }

/* ---- the ini --------------------------------------------------------------------------------------------------------------------- */
static int ini_parse(const char *path,MooseCfg *c){     /* 1 = read; 0 = no such file; -1 = c->err says what is wrong */
    memset(c,0,sizeof *c); FILE *f=fopen(path,"r"); if(!f) return 0;
    char line[512], sec[64]=""; int rc=1;
    while(fgets(line,sizeof line,f)){
        char *s=line; while(*s==' '||*s=='\t') s++; size_t n=strlen(s); while(n&&(s[n-1]=='\n'||s[n-1]=='\r'||s[n-1]==' '||s[n-1]=='\t')) s[--n]=0;
        if(!*s||*s==';'||*s=='#') continue;
        if(*s=='['){ char *e=strchr(s,']'); if(e){ *e=0; snprintf(sec,sizeof sec,"%s",s+1); } continue; }
        char *eq=strchr(s,'='); if(!eq) continue; *eq=0; char *key=s, *val=eq+1; size_t kn=strlen(key); while(kn&&(key[kn-1]==' '||key[kn-1]=='\t')) key[--kn]=0; while(*val==' '||*val=='\t') val++;
        static const char *const blk[5]={"magic","player","friend","drive","menu"}; s64 *dst=NULL; int *flag=NULL;
        if(!strcmp(sec,"kh2.cache")){ if(!strcmp(key,"size")){ dst=&c->cache_kib; flag=&c->has_cache; } else for(int i=0;i<5;i++) if(!strcmp(key,blk[i])) dst=&c->add_kib[i]; }
        else if(!strcmp(sec,"kh2.data")&&!strcmp(key,"size")){ dst=&c->data_kib; flag=&c->has_data; }
        else if(!strcmp(sec,"kh2.fixes")&&!strcmp(key,"scd_priority")){ dst=&c->scd_priority; flag=&c->has_scd; }
        else if(!strcmp(sec,"kh2.hacks")){
            if(!strcmp(key,"fast_title")){ dst=&c->fast_title; flag=&c->has_fast; }
            else if(!strcmp(key,"attempt_continue_after_exception_but_probably_make_things_worse")){ dst=&c->cont; flag=&c->has_cont; }
            else if(!strcmp(key,"no_death")){ dst=&c->no_death; flag=&c->has_no_death; }
            else if(!strcmp(key,"test_crash")){ dst=&c->test_crash; flag=&c->has_test_crash; }
        }
        if(!dst) continue;
        char *end; errno=0; long long v=strtoll(val,&end,0);
        if(end==val||errno){ snprintf(c->err,sizeof c->err,"[%s] %s=%s is not a number",sec,key,val); rc=-1; break; }
        *dst=v; if(flag) *flag=1;
    }
    fclose(f);
    if(rc==1) for(int i=0;i<5;i++) if((u64)c->add_kib[i]>0x1fffffull){ snprintf(c->err,sizeof c->err,"invalid block size %lld KiB (the DLL accepts 0..0x1fffff)",(long long)c->add_kib[i]); rc=-1; }
    if(rc==1 && (c->cache_kib<0||c->data_kib<0||c->cache_kib>(64ll<<20)||c->data_kib>(64ll<<20))){ snprintf(c->err,sizeof c->err,"pool size out of range (cache %lld KiB, data %lld KiB)",(long long)c->cache_kib,(long long)c->data_kib); rc=-1; }
    if(rc==1 && !c->has_cache) c->cache_kib=0x7800000>>10;      /* the DLL's default when the key is missing: 122,880 KiB */
    return rc;
}
/* the exe must be the build the DLL's patterns match: the same bytes at the same places, else nothing is applied */
static const struct { u32 rva; u8 n; u8 b[19]; } sites[]={
    {0x39daba,16,{@KHINPUT(array,pc/kh2fm.exe,3788474,16,a90542efbf86d226419e95913448de15e9faa892b9105eb0c4d4add193728a20)@}},
    {0x39d719,11,{@KHINPUT(array,pc/kh2fm.exe,3787545,11,d0f2101ca8af436a2aa0f5b0327303bb72c06ce9439734651a758598a4b295d7)@}},
    {0x3e5f90,15,{@KHINPUT(array,pc/kh2fm.exe,4084624,15,529e2118c17468e51bed744f737b2fdd7e4ef4e90c1c2e22316ea9adbc19d969)@}},
    {0x3e5f36,17,{@KHINPUT(array,pc/kh2fm.exe,4084534,17,35a5f7269d259c18af7860ff237d33cee9cd0bd2fb044c49cd7db3b76dceb42e)@}},
    {0x39e260,14,{@KHINPUT(array,pc/kh2fm.exe,3790432,14,8c9a2bac633f4dc90ef028d66ebd5ebf5732e1e206e4dfd6526f287d7f4775f1)@}},
    {0x39e270,19,{@KHINPUT(array,pc/kh2fm.exe,3790448,19,37b3f887f877777574279084e350d321f026bd0b599a1c116dab509e333dac6f)@}},
};
static int sites_ok(KCtx *g,u32 *bad){ for(unsigned i=0;i<sizeof sites/sizeof*sites;i++) if(memcmp(hp(g,GS_BASE+sites[i].rva),sites[i].b,sites[i].n)){ if(bad) *bad=sites[i].rva; return 0; } return 1; }
static void apply(KCtx *g,const MooseCfg *c){
    if(c->cache_kib){
        if(rd64(g,CACHE_TOP)!=CACHE_STATIC+CACHE_STATIC_SIZE||rd64(g,CACHE_STATIC)||rd64(g,LIST_HEAD))
            kh_fatal(g,"moose: the cache is not in its initial state (top %llx, first pool bytes %llx, list head %llx): the pool can only be replaced before the game uses it",(unsigned long long)rd64(g,CACHE_TOP),(unsigned long long)rd64(g,CACHE_STATIC),(unsigned long long)rd64(g,LIST_HEAD));
        cache_size=(u64)c->cache_kib<<10; cache_base=ga_pages_aligned(cache_size,GA_WIN,GA_SRC_POOL);
        if(!cache_base) kh_fatal(g,"moose: no room for a cache of %llu bytes",(unsigned long long)cache_size);
        wr64(g,CACHE_STATIC,cache_base); wr64(g,CACHE_TOP,cache_base+cache_size); cache_moved=1;
    }
    if(c->data_kib){
        if(rd64(g,DATA_STATIC)||rd64(g,DATA_PTR)) kh_fatal(g,"moose: the data heap is not in its initial state (first pool bytes %llx, pointer %llx)",(unsigned long long)rd64(g,DATA_STATIC),(unsigned long long)rd64(g,DATA_PTR));
        data_size=(u64)c->data_kib<<10; data_base=ga_pages_aligned(data_size,GA_WIN,GA_SRC_POOL);
        if(!data_base) kh_fatal(g,"moose: no room for a data heap of %llu bytes",(unsigned long long)data_size);
        wr64(g,DATA_STATIC,data_base); data_moved=1;
    }
    for(int i=0;i<5;i++){ add_bytes[i]=(s32)((u32)c->add_kib[i]<<10); if(add_bytes[i]) blocks_on=1; }
}
/* the value the DLL works with for a key: the ini's, or the DLL's default when the key is missing */
static s64 patch_value(const MooseCfg *c,int i){
    if(!strcmp(kh_moose_patches[i].key,"scd_priority")) return c->has_scd?c->scd_priority:kh_moose_patches[i].dflt;
    if(!strcmp(kh_moose_patches[i].key,"fast_title")) return c->has_fast?c->fast_title:kh_moose_patches[i].dflt;
    return 0;
}
static int patch_wanted(const MooseCfg *c,int i){ s64 v=patch_value(c,i); return kh_moose_patches[i].bit?(v&kh_moose_patches[i].bit)!=0:v!=0; }
/* the code patches and the exception-handler switch; `write` = also put the patch bytes into the image, as the DLL does */
static void apply_hacks(KCtx *g,const MooseCfg *c,int write){
    if(c->has_test_crash&&c->test_crash) kh_fatal(g,"moose: [kh2.hacks] test_crash=%lld: the DLL writes to address 0 on purpose here (its crash test)",(long long)c->test_crash);
    if(c->has_no_death&&c->no_death) kh_fatal(g,"moose: [kh2.hacks] no_death=%lld: the DLL would patch exe 0x404d60 (not set in the shipped ini, not ported)",(long long)c->no_death);
    if(((c->has_scd?c->scd_priority:1)&2)) kh_fatal(g,"moose: [kh2.fixes] scd_priority=%lld has bit 2 (sound effects): the DLL would patch exe 0x92758 (not set in the shipped ini, not ported)",(long long)c->scd_priority);
    for(int i=0;i<KH_MOOSE_NPATCH;i++){
        const struct kh_moose_patch *p=&kh_moose_patches[i]; patch_on[i]=0;
        if(!patch_wanted(c,i)) continue;
        if(memcmp(hp(g,GS_BASE+p->rva),p->old_,5)&&memcmp(hp(g,GS_BASE+p->rva),p->new_,5))
            kh_fatal(g,"moose: [%s] %s: the exe does not have the expected bytes at rva 0x%x (the DLL's \"Pattern not found.\")",p->section,p->key,p->rva);
        if(write) memcpy(hp(g,GS_BASE+p->rva),p->new_,5);
        patch_on[i]=1;
    }
    continue_default=!c->has_cont; continue_on=c->has_cont?c->cont!=0:1;
}
static void unapply_hacks(KCtx *g){                       /* selftest only */
    for(int i=0;i<KH_MOOSE_NPATCH;i++){ if(patch_on[i]&&!memcmp(hp(g,GS_BASE+kh_moose_patches[i].rva),kh_moose_patches[i].new_,5)) memcpy(hp(g,GS_BASE+kh_moose_patches[i].rva),kh_moose_patches[i].old_,5); patch_on[i]=0; }
    continue_on=continue_default=0;
}
/* the re-lifted bodies must be linked behind the two hooks (Makefile MOD_MOOSE_FUNCS; tools/check_mod_static_link.py --choice) */
static void check_link(KCtx *g){
    if(kh_mod_moose_fn_count!=KH_MOOSE_NPATCH) kh_fatal(g,"moose-link: gen/mod_static_lifted.c has %u KH2Moose functions, gen/mod_moose_table.h lists %d",kh_mod_moose_fn_count,KH_MOOSE_NPATCH);
    static const KhFn own[KH_MOOSE_NPATCH]={f_92680,f_2b4590};
    for(int i=0;i<KH_MOOSE_NPATCH;i++){ const struct kh_mod_static_fn *f=NULL;
        for(u32 k=0;k<kh_mod_moose_fn_count;k++) if(kh_mod_moose_fn_table[k].rva==kh_moose_patches[i].func) f=&kh_mod_moose_fn_table[k];
        if(!f||!f->chained||f->mod==f->orig||!f->mod||kh_lookup(GS_BASE+kh_moose_patches[i].func)!=own[i])
            kh_fatal(g,"moose-link: f_%x is not the runtime hook in front of a distinct re-lifted body",kh_moose_patches[i].func); }
}
static void unapply(KCtx *g){                             /* selftest only: back to the vanilla image state */
    if(cache_moved){ wr64(g,CACHE_STATIC,0); wr64(g,CACHE_TOP,CACHE_STATIC+CACHE_STATIC_SIZE); ga_pages_free_src(cache_base,cache_size,GA_SRC_POOL); }
    if(data_moved){ wr64(g,DATA_STATIC,0); ga_pages_free_src(data_base,data_size,GA_SRC_POOL); }
    cache_moved=data_moved=blocks_on=0; cache_base=cache_size=data_base=data_size=0; memset(add_bytes,0,sizeof add_bytes);
}
static void hacks_line(void){
    fprintf(stderr,"kh: moose: code patches: scd_priority voice (exe 0x927e2 call -> xor eax,eax) %s, fast_title (exe 0x2b46eb -> mov edi,0x11) %s; "
                   "exception handler (attempt_continue_after_exception_...) on the PC: %s%s\n",patch_on[0]?"ON":"off",patch_on[1]?"ON":"off",
            continue_on?"ON":"off",continue_on?(continue_default?" (key missing: the DLL's default); not emulated, see the fault report":"; not emulated, see the fault report"):"");
}
void kh_moose_init(KCtx *g){
    check_link(g);
    const char *e=getenv("KHNMC_MOOSE_HEAPS"); int heaps=!(e&&*e=='0');
    const char *pe=getenv("KHNMC_MOOSE_PATCHES"); int patches=!(pe&&*pe=='0');                 /* A/B switch for the two code patches only */
    if((e=getenv("KHNMC_MOOSE_INI"))&&*e) snprintf(ini_path,sizeof ini_path,"%s",e);
    else { const char *root=getenv("KHNMC_DATA"); snprintf(ini_path,sizeof ini_path,"%s/dll/KH2Moose.ini",root?root:"data"); }
    MooseCfg c; int rc=ini_parse(ini_path,&c);
    if(rc==0){ state="off (no KH2Moose.ini): vanilla pool sizes"; fprintf(stderr,"kh: moose: no ini at %s: vanilla pool sizes (cache 30 MiB, data 768 KiB), no code patch, no exception handler on the PC either\n",ini_path); return; }
    if(rc<0) kh_fatal(g,"moose: %s: %s",ini_path,c.err);
    if(patches) apply_hacks(g,&c,1);
    else { continue_default=!c.has_cont; continue_on=c.has_cont?c.cont!=0:1; fprintf(stderr,"kh: moose: KHNMC_MOOSE_PATCHES=0: the ini's code patches are NOT applied\n"); }
    hacks_line();
    if(!heaps){ state="off (KHNMC_MOOSE_HEAPS=0): vanilla pool sizes"; fprintf(stderr,"kh: moose: %s\n",state); return; }
    u32 bad=0; if(!sites_ok(g,&bad)) kh_fatal(g,"moose: the exe does not have the expected bytes at rva 0x%x (the DLL's \"Pattern not found.\"): pool sizes cannot be applied to this build",bad);
    apply(g,&c); state="on";
    fprintf(stderr,"kh: moose: %s: cache %llu MiB at 0x%llx..0x%llx (was 30 MiB static at 0x140bf33c0), data heap %llu MiB at 0x%llx (was 768 KiB static at 0x142a254c0), "
                   "reserved block increases (KiB): magic %lld player %lld friend %lld drive %lld menu %lld\n",ini_path,(unsigned long long)(cache_size>>20),(unsigned long long)cache_base,(unsigned long long)(cache_base+cache_size),
            (unsigned long long)(data_size>>20),(unsigned long long)data_base,(long long)c.add_kib[0],(long long)c.add_kib[1],(long long)c.add_kib[2],(long long)c.add_kib[3],(long long)c.add_kib[4]);
}
/* Called from the runtime's signal handler (core.c on_sig) right after the "SIGNAL" line.  The DLL's exception handler is NOT
 * emulated; this says what it would have done on the modded PC, and why the port cannot do the same. */
void kh_moose_fault_note(FILE *f,int sig,void *addr,void *uctx){
    if(!continue_on) return;
    const char *access="";
#if defined(__x86_64__) && defined(__linux__)
    if(uctx&&(sig==SIGSEGV||sig==SIGBUS)){ const ucontext_t *uc=uctx; unsigned long long err=(unsigned long long)uc->uc_mcontext.gregs[REG_ERR];
        access=(err&0x10)?" (this one was an INSTRUCTION FETCH: the handler does not take those, the PC game stops as well)":(err&2)?" (this one was a WRITE)":" (this one was a READ)"; }
#else
    (void)uctx;
#endif
    (void)addr;
    if(sig!=SIGSEGV&&sig!=SIGBUS&&sig!=SIGFPE){
        fprintf(f,"kh: moose: KH2Moose's exception handler (on in the ini) does not take this kind of fault (it takes access violations on a read or write, in-page errors, "
                  "integer divide / overflow and the floating-point codes): the modded PC game stops here as well.\n");
        return; }
    fprintf(f,"kh: moose: NOTE: KH2Moose.ini has [kh2.hacks] attempt_continue_after_exception_but_probably_make_things_worse on%s.  If this fault is a guest instruction\n"
              "kh: moose:   %s%s, the MODDED PC GAME WOULD NOT HAVE STOPPED HERE: the DLL's first-chance exception handler\n"
              "kh: moose:   (0x18000bbf0) decodes the faulting instruction, sets every register that instruction writes to 0 (16- and 8-bit registers: that part, plus bits 32..63),\n"
              "kh: moose:   clears the flags it modifies, drops a faulting store, adds the instruction's length to RIP and continues.  It gives up (and the PC game dies too) for a\n"
              "kh: moose:   call / jmp / ret through a bad pointer or any other instruction that writes RIP, for an instruction fetch from a bad address, for an instruction it\n"
              "kh: moose:   cannot decode, for writes of XMM16+/YMM/ZMM or system registers, and for non-continuable exceptions.\n"
              "kh: moose:   This port cannot continue the same way: the fault is in host code compiled from lifted C (or in the runtime), where one guest instruction is many host\n"
              "kh: moose:   instructions and guest registers live in host registers, in KCtx and in temporaries; there is no host address that means \"the next guest instruction\" and\n"
              "kh: moose:   no host register set that means \"the registers this guest instruction writes\", so the handler's skip cannot be reproduced exactly.\n",
            continue_default?" (the key is missing: the DLL's default)":"",
            sig==SIGFPE?"dividing by zero (or another arithmetic exception)":"reading or writing a bad address",access);
}
/* Task 31 (what holds the id zone; read-only, KHNMC_IDTABLE_REPORT=1): the resource cache's entries at the end of the run, in list
 * order: kind, size, address and the bytes +4.. of the entry when they read as a name (resources keep their file name there; an entry
 * without one prints "-").  The HD textures GetRemasteredAsset hands out for a model live as long as the model's resource does. */
static void cache_entries_report(FILE *f){
    const char *e=getenv("KHNMC_IDTABLE_REPORT"); if(!e||!*e||*e=='0') return;
    u64 n=0, bytes=0, ent=0;
    if(GA_OK(LIST_HEAD)) memcpy(&ent,(void*)((uintptr_t)LIST_HEAD+gs_bias),8);
    while(ent && GA_OK(ent) && GA_OK(ent+0x78) && n<4096){
        const u8 *p=(const u8*)((uintptr_t)ent+gs_bias); s32 kind; u64 size,addr; u32 nx; memcpy(&kind,p+0x48,4); memcpy(&size,p+0x50,8); memcpy(&addr,p+0x58,8); memcpy(&nx,p+0x70,4);
        char nm[64]; int k=0; for(;k<63 && p[4+k]>=0x20 && p[4+k]<0x7f;k++) nm[k]=(char)p[4+k]; nm[k]=0; if(k<4) snprintf(nm,sizeof nm,"-");
        fprintf(f,"kh: moose cache: entry %3llu kind %5d %8.1f KiB at 0x%llx  %s\n",(unsigned long long)n,kind,(double)size/1024.0,(unsigned long long)addr,nm);
        if(kind>=0 && kind<10000) bytes+=size; n++; ent=tab_id2p(nx); }
    fprintf(f,"kh: moose cache: %llu entries, %.1f MiB in entries of kind 0..9999\n",(unsigned long long)n,(double)bytes/1048576.0);
}
void kh_moose_report(FILE *f){
    cache_entries_report(f);
    fprintf(f,"kh: moose report: code patches: scd_priority voice %s (0x92680 calls: %llu patched body, %llu vanilla body), fast_title %s (0x2b4590 calls: %llu patched, %llu vanilla); "
              "PC exception handler %s (not emulated)\n",patch_on[0]?"on":"off",(unsigned long long)c_patch[0][1],(unsigned long long)c_patch[0][0],
            patch_on[1]?"on":"off",(unsigned long long)c_patch[1][1],(unsigned long long)c_patch[1][0],continue_on?"on":"off");
    u64 csz=cache_moved?cache_size:CACHE_STATIC_SIZE, dsz=data_moved?data_size:DATA_STATIC_SIZE;
    fprintf(f,"kh: moose report: heaps=%s; cache %llu KiB (%s): most used from the bottom %llu KiB, from the top %llu KiB, most entries %llu, layouts=%llu evictions=%llu free-queries=%llu; "
              "data heap %llu KiB (%s): most used %llu KiB%s; block-size calls: set=%llu party=%llu, data resets=%llu releases=%llu\n",
            state,(unsigned long long)(csz>>10),cache_moved?"moved":"static, in the image",(unsigned long long)(hw_cache_bottom>>10),(unsigned long long)(hw_cache_top_used>>10),(unsigned long long)hw_entries,
            (unsigned long long)c_layout,(unsigned long long)c_evict,(unsigned long long)c_free_q,(unsigned long long)(dsz>>10),data_moved?"moved":"static, in the image",(unsigned long long)(hw_data>>10),
            hw_data>dsz?"  <== BEYOND THE POOL: the original has no check there, the globals behind the pool were overwritten":"",
            (unsigned long long)c_blk_set,(unsigned long long)c_party_set,(unsigned long long)c_data_reset,(unsigned long long)c_data_release);
}

/* ==============================================================================================================================
 * selftest.  The replacements run on the VANILLA pool start against the untouched lifted originals: same list, same globals, the
 * real callees (0x39dd70 reinsert, 0x39e2a0 unlink, 0x3a6a10 archive release, the eviction object's method): the memory afterwards
 * must be identical byte for byte.  Then the mod's sizes are applied and removed again.
 * ============================================================================================================================ */
#define CHECK(c) do{ checks++; if(!(c)){ fails++; fprintf(stderr,"moose selftest FAIL: %s (line %d)\n",#c,__LINE__); } }while(0)
#define ENT 0x80u
#define MAXENT 200
static u32 rs=0x2545f491u; static u32 mrnd(void){ rs^=rs<<13; rs^=rs>>17; rs^=rs<<5; return rs; }
static struct { int n; u64 obj[64], ent[64]; } evlog;
static void st_evict(KCtx *g){ if(evlog.n<64){ evlog.obj[evlog.n]=A0(g); evlog.ent[evlog.n]=A1(g); } evlog.n++; KH_RET(g); }
static struct { int n; int which[8]; u64 rcx[8], rsp[8], ret[8]; } pl;                      /* which body a patched function's hook ran */
static void st_body(KCtx *g,int which){ if(pl.n<8){ pl.which[pl.n]=which; pl.rcx[pl.n]=KH_RCX(g); pl.rsp[pl.n]=KH_RSP(g); pl.ret[pl.n]=rd64(g,KH_RSP(g)); } pl.n++; KH_RAX(g)=0xb0d70000u+(u32)which; KH_RET(g); }
static void st_b00(KCtx *g){ st_body(g,0); } static void st_b01(KCtx *g){ st_body(g,1); } static void st_b10(KCtx *g){ st_body(g,2); } static void st_b11(KCtx *g){ st_body(g,3); }
static int st_child(void (*body)(void),char *out,size_t cap){                              /* run body in a child, stderr captured; returns its exit status */
    FILE *log=kh_tmpfile(); if(!log) return -1; fflush(stderr);
    pid_t c=kh_fork(); if(c<0){ fclose(log); return -1; }                                    /* callers ask kh_fork_ok() first */
    if(!c){ dup2(fileno(log),2); body(); _exit(99); }
    int st=0; waitpid(c,&st,0); rewind(log); size_t n=fread(out,1,cap-1,log); out[n]=0; fclose(log);
    return WIFEXITED(st)?WEXITSTATUS(st):-1;
}
static volatile uintptr_t st_bad=0x10;
static void st_fault_write(void){ continue_on=1; continue_default=0; *(volatile char *)st_bad=1; }
static void st_fault_read(void){ continue_on=1; continue_default=1; volatile char c=*(volatile char *)st_bad; (void)c; }
static void st_fault_exec(void){ continue_on=1; ((void (*)(void))st_bad)(); }
static void st_fault_div(void){ continue_on=1; volatile int z=0; volatile int r=7/z; (void)r; }
static void st_fault_off(void){ continue_on=0; *(volatile char *)st_bad=1; }
static KCtx *st_g; static MooseCfg st_cfg;
static void st_fatal_cfg(void){ apply_hacks(st_g,&st_cfg,0); }
typedef struct { u8 glob[0x30], blk[28]; u64 top, dataptr; } Globals;
static void glob_get(KCtx *g,Globals *s){ memset(s,0,sizeof *s); memcpy(s->glob,hp(g,LIST_HEAD),sizeof s->glob); memcpy(s->blk,hp(g,BLK),sizeof s->blk); s->top=rd64(g,CACHE_TOP); s->dataptr=rd64(g,DATA_PTR); }
static void glob_put(KCtx *g,const Globals *s){ memcpy(hp(g,LIST_HEAD),s->glob,sizeof s->glob); memcpy(hp(g,BLK),s->blk,sizeof s->blk); wr64(g,CACHE_TOP,s->top); wr64(g,DATA_PTR,s->dataptr); }
int kh_moose_selftest(KCtx *g){
    int checks=0,fails=0;
    /* 0. the ini as shipped (CRLF, comments, commented-out keys) and the DLL's rules */
    { char p[KH_TMP_MAX]; kh_tmp_path(p,sizeof p,"khnmc-moose-XXXXXX"); int fd=mkstemp(p); FILE *f=fd>=0?fdopen(fd,"w"):NULL; CHECK(f!=NULL);
      if(f){ fputs("; All sizes are KiB.\r\n\r\n[kh2.cache]\r\n; Game default: 30720; 0 to skip replacement\r\nsize=524288\r\n; Reserved block size increases\r\nplayer=32768\r\n;menu=0\r\n;magic=0\r\nfriend=32768\r\n;drive=0\r\n\r\n"
                   "[kh2.data]\r\n;size=0\r\nsize=131072\r\n\r\n[kh2.fixes]\r\n; Bitfield:\r\n;  1: Voice\r\n;  2: Sound effects (may cause deafening sound levels)\r\nscd_priority=1\r\n\r\n[kh2.hacks]\r\nfast_title=1\r\n"
                   "attempt_continue_after_exception_but_probably_make_things_worse=1",f); fclose(f);          /* the shipped file: no newline behind the last key */
        MooseCfg c; CHECK(ini_parse(p,&c)==1 && c.cache_kib==524288 && c.data_kib==131072 && c.add_kib[0]==0 && c.add_kib[1]==32768 && c.add_kib[2]==32768 && c.add_kib[3]==0 && c.add_kib[4]==0 && c.has_cache && c.has_data);
        CHECK(c.has_scd && c.scd_priority==1 && c.has_fast && c.fast_title==1 && c.has_cont && c.cont==1 && !c.has_no_death && !c.has_test_crash);
        CHECK(patch_wanted(&c,0) && patch_wanted(&c,1));                                                         /* as shipped: both code patches on */
        /* Task 23: the DLL's rules for the three switches.  scd_priority: missing = 1, bit 1 = the voice patch; fast_title: missing = off,
         * any non-zero value = on; the exception handler: missing = ON, 0 = off */
        static const struct { const char *ini; int scd, fast, cont; } sw[]={
            {"[kh2.cache]\nsize=0\n",1,0,1},{"[kh2.fixes]\nscd_priority=0\n[kh2.hacks]\nfast_title=0\nattempt_continue_after_exception_but_probably_make_things_worse=0\n",0,0,0},
            {"[kh2.fixes]\nscd_priority=1\n",1,0,1},{"[kh2.hacks]\nfast_title=5\n",1,1,1},{"[kh2.hacks]\nfast_title=-1\nattempt_continue_after_exception_but_probably_make_things_worse=7\n",1,1,1},
            {"[kh2.fixes]\nfast_title=1\n[kh2.hacks]\nscd_priority=0\n",1,0,1},                                 /* keys in the wrong section are not the DLL's keys */
            {"[kh2.fixes]\nscd_priority = 0x1\n[kh2.hacks]\nno_death=0\ntest_crash=0\n",1,0,1},
            {"[kh2.fixes]\nscd_priority=4\n",0,0,1},{"[kh2.fixes]\nscd_priority=5\n",1,0,1}};                       /* a bitfield: only bit 1 is the voice patch */
        int sv_on[KH_MOOSE_NPATCH], sv_c=continue_on, sv_d=continue_default; memcpy(sv_on,patch_on,sizeof sv_on);
        for(unsigned i=0;i<sizeof sw/sizeof *sw;i++){ f=fopen(p,"w"); fputs(sw[i].ini,f); fclose(f); MooseCfg k; CHECK(ini_parse(p,&k)==1);

    /* ---- Task 23: the two code patches.  Image bytes, the hook's choice of body, the link behind it ---- */
    { int sv_on[KH_MOOSE_NPATCH], sv_c=continue_on, sv_d=continue_default; memcpy(sv_on,patch_on,sizeof sv_on); u8 sv_b[KH_MOOSE_NPATCH][5];
      for(int i=0;i<KH_MOOSE_NPATCH;i++) memcpy(sv_b[i],hp(g,GS_BASE+kh_moose_patches[i].rva),5);
      static const u8 old0[5]={0xe8,0xf9,0xb9,0x01,0x00}, new0[5]={0x31,0xc0,0x0f,0x1f,0x00}, old1[5]={0x41,0x8d,0x7c,0x24,0xf4}, new1[5]={0xbf,0x11,0x00,0x00,0x00};   /* from the DLL listing, not from the generated table */

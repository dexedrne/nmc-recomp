        for(int v=0;v<2;v++){ force_static=v; wr64(g,DATA_PTR,0x1234); u64 r=kh_call(g,GS_BASE+0x3e5f90,0,0,0,0); if(rd64(g,DATA_PTR)!=DATA_STATIC||r!=DATA_STATIC) ok=0;
            rs=0x9e3779b9u+(u32)t; memset(hp(g,DATA_STATIC),0,sizeof sv_dpool); u64 b=DATA_STATIC; int nb=(int)(mrnd()%9);
            for(int i=0;i<nb;i++){ u32 sz=(mrnd()%3+1)*0x40; wr32(g,b,sz); wr32(g,b+4,0x23234141u); wr32(g,b+8,mrnd()%2); b+=0x10+sz; }       /* blocks as 0x3e5ee0 / 0x3e6010 write them; archives with no entries */
            wr64(g,DATA_PTR,b); kh_call(g,GS_BASE+0x3e5f30,0,0,0,0);
            if(v==0){ memcpy(poolA,hp(g,DATA_STATIC),sizeof poolA); pA=rd64(g,DATA_PTR); rA=(u32)nb; } else { pB=rd64(g,DATA_PTR); rB=(u32)nb; if(memcmp(poolA,hp(g,DATA_STATIC),sizeof poolA)||pA!=pB||pA!=0||rA!=rB) ok=0; } }
        force_static=0; } CHECK(ok); }
    memcpy(hp(g,DATA_STATIC),sv_dpool,sizeof sv_dpool);
    /* the hooks pass through while nothing is applied: block sizes arrive unchanged */
    kh_call(g,GS_BASE+0x39e260,6,0xc0000,0,0); CHECK(rd32(g,BLK+24)==0xc0000);
    kh_call(g,GS_BASE+0x39e270,0x111000,0x222000,0,0); CHECK(rd32(g,BLK+8)==0x111000 && rd32(g,BLK+16)==0x222000 && rd32(g,BLK+12)==0x222000);
    glob_put(g,&sv); memcpy(hp(g,GS_BASE+0x2b0d720ull),sv_tab,sizeof sv_tab); wr32(g,GS_BASE+0x2b0d920ull,sv_guard); wr64(g,CACHE_STATIC,sv_cs); wr64(g,DATA_STATIC,sv_ds);

    /* the mod's sizes, applied to the vanilla image and removed again */
    if(rd64(g,CACHE_TOP)==CACHE_STATIC+CACHE_STATIC_SIZE && !rd64(g,CACHE_STATIC) && !rd64(g,LIST_HEAD) && !rd64(g,DATA_STATIC) && !rd64(g,DATA_PTR)){
        MooseCfg c; memset(&c,0,sizeof c); c.cache_kib=524288; c.data_kib=131072; c.add_kib[1]=32768; c.add_kib[2]=32768; apply(g,&c);
        u64 idlo=0,idhi=0; extern int ga_zone_get(int,u64*,u64*,u64*,u64*,u64*); ga_zone_get(0,&idlo,&idhi,NULL,NULL,NULL);
        CHECK(cache_moved && data_moved && blocks_on && cache_size==(512ull<<20) && data_size==(128ull<<20));
        CHECK(!(cache_base&(GA_WIN-1)) && !(data_base&(GA_WIN-1)) && cache_base>=idlo && cache_base+cache_size<=idhi && data_base>=idlo && data_base+data_size<=idhi);   /* 16 + 4 whole windows of the id zone */
        CHECK(rd64(g,CACHE_STATIC)==cache_base && rd64(g,CACHE_TOP)==cache_base+cache_size && rd64(g,DATA_STATIC)==data_base);
        CHECK((u32)kh_call(g,GS_BASE+0x39dab0,0,0,0,0)==(u32)cache_size);                                       /* empty cache: all 512 MiB free */
        kh_call(g,GS_BASE+0x3e5f90,0,0,0,0); CHECK(rd64(g,DATA_PTR)==data_base); wr64(g,DATA_PTR,0);
        kh_call(g,GS_BASE+0x39e260,6,0xc0000,0,0); CHECK(rd32(g,BLK+24)==0xc0000);                               /* menu: no increase in the ini */
        kh_call(g,GS_BASE+0x39e260,2,0x100000,0,0); CHECK(rd32(g,BLK+8)==0x100000+(32768u<<10));                 /* player */
        kh_call(g,GS_BASE+0x39e260,3,0x100000,0,0); kh_call(g,GS_BASE+0x39e260,4,0x200000,0,0); CHECK(rd32(g,BLK+12)==0x100000+(32768u<<10) && rd32(g,BLK+16)==0x200000+(32768u<<10));   /* both friends */
        kh_call(g,GS_BASE+0x39e260,1,0x1000,0,0); kh_call(g,GS_BASE+0x39e260,5,0x2000,0,0); kh_call(g,GS_BASE+0x39e260,0,0x3000,0,0); CHECK(rd32(g,BLK+4)==0x1000 && rd32(g,BLK+20)==0x2000 && rd32(g,BLK)==0x3000);
        kh_call(g,GS_BASE+0x39e270,0x111000,0x222000,0,0); CHECK(rd32(g,BLK+8)==0x111000+(32768u<<10) && rd32(g,BLK+16)==0x222000+(32768u<<10) && rd32(g,BLK+12)==0x222000+(32768u<<10));
        /* a small list is laid out inside the new pool: a plain entry at its start, a player entry opens its (enlarged) block, a top entry hangs from the new top */
        for(int i=0;i<64;i++) wr64(g,GS_BASE+0x2b0d720ull+8ull*i,~0ull); wr32(g,GS_BASE+0x2b0d920ull,0x80000000u);
        memset(hp(g,mem),0,3*ENT); wr32(g,mem+0x48,7); wr64(g,mem+0x50,0x1000); wr32(g,mem+ENT+0x48,2300); wr64(g,mem+ENT+0x50,0x2000); wr32(g,mem+2*ENT+0x48,(u32)-3); wr64(g,mem+2*ENT+0x50,0x4000);
        wr32(g,mem+0x70,(u32)kh_call(g,F_PTR2ID,mem+ENT,0,0,0)); wr32(g,mem+ENT+0x70,(u32)kh_call(g,F_PTR2ID,mem+2*ENT,0,0,0));
        wr64(g,LIST_HEAD,mem); wr64(g,LIST_TAIL,mem+2*ENT); wr32(g,BLK,0); wr32(g,BLK+8,0x111000+(32768u<<10));
        kh_call(g,GS_BASE+0x39d590,0,0,0,0);
        CHECK(rd64(g,mem+0x58)==cache_base && rd64(g,mem+ENT+0x58)==cache_base+0x1000 && rd64(g,mem+2*ENT+0x58)==cache_base+cache_size-0x4000 && rd64(g,LAYOUT_TOP)==cache_base+cache_size-0x4000);
        CHECK((u32)kh_call(g,GS_BASE+0x39dab0,0,0,0,0)==(u32)(cache_size-0x4000-0x3000));                        /* lowest top entry minus the end of the last bottom entry */
        glob_put(g,&sv); memcpy(hp(g,GS_BASE+0x2b0d720ull),sv_tab,sizeof sv_tab); wr32(g,GS_BASE+0x2b0d920ull,sv_guard);
        u64 cb=cache_base; unapply(g);
        CHECK(!cache_moved && rd64(g,CACHE_STATIC)==0 && rd64(g,CACHE_TOP)==CACHE_STATIC+CACHE_STATIC_SIZE && rd64(g,DATA_STATIC)==0 && cb);
    } else { fails++; fprintf(stderr,"moose selftest FAIL: the image's pool globals are not in their initial state\n"); }
    hw_cache_bottom=hw_sv[0]; hw_cache_top_used=hw_sv[1]; hw_data=hw_sv[2]; hw_entries=hw_sv[3];
    atomic_store(&c_layout,0); atomic_store(&c_free_q,0); atomic_store(&c_data_reset,0); atomic_store(&c_data_release,0); atomic_store(&c_blk_set,0); atomic_store(&c_party_set,0); atomic_store(&c_evict,0);
    free(init); free(resA); ga_free(mem); ga_free(obj); ga_free(vt);
    fprintf(stderr,"kh: moose selftest: %d checks, %d failures (layout trials: %d identical of %d; %d with evictions, %d with reserved blocks, %d with re-queued entries)\n",checks,fails,same,trials,with_evict,with_blocks,with_tmp);
    return fails;
}

            {"[kh2.hacks]\nno_death=1\n","no_death=1"},{"[kh2.hacks]\ntest_crash=1\n","test_crash=1"}};
        for(unsigned i=0;i<sizeof bad/sizeof *bad;i++){ char out[4096]; f=fopen(p,"w"); fputs(bad[i].ini,f); fclose(f); st_g=g; CHECK(ini_parse(p,&st_cfg)==1);
            if(kh_fork_ok()) CHECK(st_child(st_fatal_cfg,out,sizeof out)==3 && strstr(out,bad[i].msg)!=NULL);

static pthread_mutex_t files_lock=PTHREAD_MUTEX_INITIALIZER;
static unsigned real_packages;
void orig_f_106000(KCtx *g);
void orig_f_1063d0(KCtx *g);
void orig_f_106700(KCtx *g);
void orig_f_106790(KCtx *g);
void orig_f_106870(KCtx *g);
int kh_data_denied(KCtx *g,const char *rel,const char *what);        /* data_deny.c (task 32): KHNMC_DATA_DENY */
void kh_data_deny_remastered(KCtx *g,const char *rel);
void kh_music_note_file(KCtx *g,const char *path,int hit,long long size);   /* music_log.c (task 32): bgm/ and vagstream/ requests */

static int real_package(const char *name){
    if(!getenv("KHNMC_PKGDIR")) return 0;
    char win[2048],host[2048]; struct stat st;
    const char *exts[]={"hed","pkg"};
    for(int i=0;i<2;i++){
        if(snprintf(win,sizeof win,"%s.%s",name,exts[i])>=(int)sizeof win ||
           !kh_winpath(win,host,sizeof host)||stat(host,&st)||!S_ISREG(st.st_mode)) return 0;
    }
    return 1;
}
static int package_fallback(const char *path){
    char normalized[2048]; size_t n=strlen(path);
    if(!real_packages||n>=sizeof normalized) return 0;
    for(size_t i=0;i<=n;i++) normalized[i]=path[i]=='\\'?'/':path[i];
    for(char *p=normalized;*p;){ size_t len=strcspn(p,"/");
        if(len==2&&!strncmp(p,"..",2)) return 0; p+=len; if(*p) p++; }
    return 1;
}
static void file_log(KCtx *g,const char *path,const char *source,int size){
    kh_phase_file(g,path); kh_music_note_file(g,path,source!=NULL,size);
    { extern void kh_warp_file_event(KCtx *,const char *,const char *); kh_warp_file_event(g,path,source); }   /* task 33: attributed to a debug warp while one is watched */
    const char *log=getenv("KHNMC_FILELOG"); FILE *lf=fopen(log?log:"filelog.txt","a");
    if(!lf) kh_fatal(g,"cannot append file log %s",log?log:"filelog.txt");
    int failed=fprintf(lf,"%s %s %d %s\n",source?"HIT":"MISS",source?source:"NONE",size,path)<0;
    if(fclose(lf)||failed) kh_fatal(g,"cannot write file log");
}

void f_106000(KCtx *g){
    u64 obj=A0(g); const char *name=gstr(g,A1(g));
    if(real_package(name)){
        orig_f_106000(g);
        if(!rd64(g,obj+8)||(s32)rd32(g,obj+0x10)<0)
            kh_fatal(g,"real package constructor failed: %s",name);
        real_packages++;
        fprintf(stderr,"kh: real package registered: %s (%u entries)\n",name,rd32(g,obj+0x14));
        return;
    }
    fprintf(stderr,"kh: empty package registered: %s\n",name);
    memset(hp(g,obj),0,0x260);
    wr64(g,obj,GS_BASE+0x585fb0);
    wr64(g,obj+8,ga_calloc(1,32)); /* non-NULL is the package-ready flag; count stays zero */
    if(!rd64(g,obj+8)) kh_fatal(g,"empty package table allocation failed");
    wr32(g,obj+0x10,-1);
    snprintf(hp(g,obj+0x20),260,"%s.pkg",name);
    SET_RAX(g,obj); KH_RET(g);
}

static int normalize(const char *s,char *out,size_t cap){
    size_t n=strlen(s); if(n>=cap) return 0;
    for(size_t i=0;i<=n;i++) out[i]=s[i]=='\\'?'/':s[i];
    return 1;
}
static int relative(KCtx *g,const char *path,char *rel,size_t cap){
    char base[2048];
    if(!normalize(path,rel,cap)||!normalize(gstr(g,GS_BASE+0x2bd4340),base,sizeof base)) return 0;
    size_t n=strlen(base);
    if(n&&!strncasecmp(rel,base,n)&&rel[n]=='/') memmove(rel,rel+n+1,strlen(rel+n+1)+1);
    /* Reject absolute and parent paths before using the shared Windows resolver. */
    if(rel[0]=='/'||strchr(rel,':')) return 0;
    for(char *p=rel;*p;){ size_t n=strcspn(p,"/"); if(n>=512||(n==2&&!strncmp(p,"..",2))) return 0; p+=n; if(*p) p++; }
    return 1;
}
static _Atomic int player_look;
_Thread_local int kh_loading_look=-1;

/* Preload can enqueue a read on another thread. Keep the decision until the
 * game's event teardown, and serialize changes with read + HD registration. */
static _Atomic int scene_pack; /* 0 outside, -1 missing for this event, 1 available */
static const char *const scene_files[]={
    KH_SCENE_MDLX, "remastered/" KH_SCENE_MDLX "/-0.dds",
    "remastered/" KH_SCENE_MDLX "/-1.dds", "remastered/" KH_SCENE_MDLX "/-2.dds"
};

const char *kh_scene_root(void){
    const char *root=getenv("KHNMC_SCENE_ROXAS_DIR");
    return root?root:"private/scene-roxas";
}
static const char *look_root(int look){
    if(look==2){
        const char *root=getenv("KHNMC_LOOK_HOODED_DIR");
        return root?root:"private/looks/xion-hooded";
    }
    const char *root=getenv("KHNMC_LOOK_DIR");
    return root?root:"private/looks/xion";
}
const char *kh_look_root(void){return look_root(kh_look_enabled());}
int kh_scene_path(const char *rel,char *host,size_t cap){
    const char *root=kh_scene_root();
    struct stat st;
    return *root && strlen(root)+strlen(rel)+2<=cap && kh_resolve_ci(root,rel,host,cap) &&
           !stat(host,&st) && S_ISREG(st.st_mode) && st.st_size>0 && st.st_size<=INT_MAX && !access(host,R_OK);
}

int kh_scene_pack_ready(void){
    char host[4096];
    for(size_t i=0;i<sizeof scene_files/sizeof *scene_files;i++)
        if(!kh_scene_path(scene_files[i],host,sizeof host)) return 0;
    return 1;
}

void kh_scene_pack_begin(void){
    if(scene_pack) return;
    pthread_mutex_lock(&files_lock);
    if(!scene_pack){
        char host[4096];
        int ok=1;
        if(kh_look_enabled()){
            if(!kh_look_available(KH_SCENE_MDLX,host,sizeof host)){
                kh_warn("scene-xion-asset: %s unavailable for this event",KH_SCENE_MDLX);
                ok=0;
            }
        }else for(size_t i=0;i<sizeof scene_files/sizeof *scene_files;i++){
            if(kh_scene_path(scene_files[i],host,sizeof host)) continue;
            fprintf(stderr,"kh: scene Roxas: missing overlay %s; keeping Sora for this event\n",scene_files[i]);
            ok=0; break;
        }
        scene_pack=ok?1:-1;
    }
    pthread_mutex_unlock(&files_lock);
}

void kh_scene_pack_end(void){
    if(!scene_pack) return;
    pthread_mutex_lock(&files_lock);
    scene_pack=0;
    pthread_mutex_unlock(&files_lock);
}

int kh_scene_pack_active(void){ return scene_pack==1; }

int kh_scene_key(const char *rel){
    for(size_t i=0;i<sizeof scene_files/sizeof *scene_files;i++)
        if(!strcasecmp(rel,scene_files[i])) return KH_SCENE_MODEL;
    return 0;
}

/* Menus may retain the returned guest address for the lifetime of a page. */
static u64 name_overlays;
static const char roxas[]="@KHINPUT(slash,data/msg/us/he.bar,15561,5,6371a57675507ca2b56b55306572693e0b838cda8d98eeecb9ec54a9dd62947b)@",xion[]="@KHINPUT(slash,data/msg/us/po.bar,13217,4,3841ba554755fe34fbbe96d4378902dcb824fa5bb69ca360c5ceb31d86e155f6)@";
static pthread_mutex_t names_lock=PTHREAD_MUTEX_INITIALIZER;
/* Each overlay keeps both the source bytes and a stable display buffer. */
static int menu_name(int id,const u8 *src,size_t at){
    id&=0x7fff;
    switch(id){
    case 0x51f: case 0x52d: case 0x534a: case 0x2ce8: case 0x2d0c: case 0x2e9a:
        return !at && !src[5];
    case 0x453a: case 0x50e5: case 0x511d: case 0x533f:
        return at==(id==0x453a?5:0) && (src[at+5]==0xec || src[at+5]==0xee);
    default: return 0;
    }
}
static size_t render_name(KCtx *g,int id,const u8 *src,u8 *dst,int menus,int selected,int *matched){
    size_t i=0,n=0;
    while(src[i]){
        if(i>=65536) kh_fatal(g,"look-name-message-length: %#x",id);
        size_t step=1+(src[i]<32?kh_route_message_ctl_args(src[i]):0);
        if(!strncmp((const char *)src+i,roxas,5) && (!menus || menu_name(id,src,i))){
            *matched=1;
            if(dst) memcpy(dst+n,selected?xion:roxas,selected?4:5);
            i+=5; n+=selected?4:5;
        }else{
            if(dst) memcpy(dst+n,src+i,step);
            i+=step; n+=step;
        }
    }
    if(dst) dst[n]=0;
    return i+1;
}
static void update_name(KCtx *g,u64 e){
    unsigned size=rd32(g,e+8); int matched=0;
    render_name(g,rd16(g,e+12),hp(g,e+16+size),hp(g,e+16),rd8(g,e+14),kh_look_enabled(),&matched);
}
void kh_look_set(KCtx *g,int selected){
    pthread_mutex_lock(&files_lock);
    pthread_mutex_lock(&names_lock);
    player_look=selected;
    for(u64 e=name_overlays;e;e=rd64(g,e)) update_name(g,e);
    pthread_mutex_unlock(&names_lock);
    pthread_mutex_unlock(&files_lock);
}
u64 kh_look_name(KCtx *g,int id,u64 original){
    if(!original) return 0;
    /* These native mission and rematch messages name the opposing Roxas. */
    switch(id&0x7fff){
    case 0x377a: case 0x48bc: case 0x491a: case 0x4ed9: case 0x4f43: return original;
    }
    const char *policy=kh_menu_choice("KHNMC_LOOK_NAMES");
    int menus=policy && !strcmp(policy,"menus"),matched=0;
    if(policy && *policy && !menus && strcmp(policy,"all")) kh_fatal(g,"look-name-policy: expected all or menus");
    const u8 *src=hp(g,original);
    size_t size=render_name(g,id,src,NULL,menus,0,&matched);
    if(!matched) return original;
    id&=0x7fff;
    pthread_mutex_lock(&names_lock);
    u64 e=name_overlays;
    while(e){
        if(rd32(g,e+8)==size && rd16(g,e+12)==id && rd8(g,e+14)==menus &&
           !memcmp(hp(g,e+16+size),src,size)) break;
        e=rd64(g,e);
    }
    if(!e){
        e=ga_alloc(16+2*size,16);
        if(!e) kh_fatal(g,"look-name-allocation");
        wr64(g,e,name_overlays); wr32(g,e+8,size); wr16(g,e+12,id); wr8(g,e+14,menus);
        memcpy(hp(g,e+16+size),src,size);
        update_name(g,e); name_overlays=e;
    }
    pthread_mutex_unlock(&names_lock);
    return e+16;
}
/* Route readers reverse a displayed pointer to its current message table. */
int kh_look_message_id(KCtx *g,u64 text){
    pthread_mutex_lock(&names_lock);
    int id=-1;
    for(u64 e=name_overlays;e;e=rd64(g,e)){
        if(text>=e+16 && text<e+16+rd32(g,e+8)){id=rd16(g,e+12); break;}
    }
    pthread_mutex_unlock(&names_lock);
    return id;
}
int kh_look_asset(int look,const char *rel,char *host,size_t cap){
    const char *root=look_root(look);
    struct stat st;
    return *root && strlen(root)+strlen(rel)+2<=cap && kh_resolve_ci(root,rel,host,cap) &&
           !stat(host,&st) && S_ISREG(st.st_mode) && st.st_size>0 && st.st_size<=INT_MAX && !access(host,R_OK);
}
int kh_look_available(const char *rel,char *host,size_t cap){return kh_look_asset(kh_look_enabled(),rel,host,cap);}
void kh_look_path(KCtx *g,const char *rel,char *host,size_t cap){
    if(!kh_look_available(rel,host,cap)) kh_fatal(g,"player-look-asset: missing or invalid %s",rel);
}

void kh_xkb_set_mode(KCtx *g,int enabled){
    kh_settings_reset_look();
    int previous=kh_look_enabled();
    kh_xion_enabled=enabled;
    kh_look_set(g,enabled);
    kh_warn("player appearance: mode default %s",enabled?"Xion":"Roxas");
    if((previous!=0)!=(kh_look_enabled()!=0)){ KCtx ctx=*g; kh_look_voice_bind(&ctx); }
}

int kh_look_enabled(void){
    if(kh_loading_look>=0) return kh_loading_look;
    int selected=player_look;
    return selected<0?!!kh_xion_enabled:selected; /* older rewind snapshots used -1 */
}

static const char *const banks[]={
#include "look_voice.inc"
};
int kh_look_switch_ready(int target){
    char host[4096];
    if(!kh_look_pack_ready(target) || !kh_look_asset(target,KH_SCENE_MDLX,host,sizeof host)) return 0;
    for(size_t i=0;i<sizeof banks/sizeof *banks;i++)
        if(!kh_look_asset(target,banks[i],host,sizeof host)) return 0;
    return 1;
}
int kh_player_voice(const char *path){
    if(strncasecmp(path,"voice/",6) && strncasecmp(path,"remastered/obj/P_EX1",20)) return 0;
    for(size_t i=0;i<sizeof banks/sizeof *banks;i++) if(!strcasecmp(path,banks[i])) return (int)i+1;
    return 0;
}

/* f_3cde50 keys these slots by character and costume, even across worlds. */
static int voice_slot[4];
static unsigned voice_pending, voice_retired, voice_wait_reported;
static struct { u64 bytes; int size; } voice_data[2][sizeof banks/sizeof *banks];
void kh_look_voice_request(KCtx *g){
    if(A2(g)!=GS_BASE+0x3cddf0) return;
    unsigned slot=(unsigned)A3(g);
    if(slot>=4) kh_fatal(g,"look-voice-slot: %u",slot);
    voice_pending &= ~(1u<<slot); /* the native request owns this slot again */
    voice_slot[slot]=kh_player_voice(gstr(g,A0(g)));
}
int kh_look_voice_retry(KCtx *g){
    if(!g || !voice_pending) return 0;
    KCtx ctx=*g; g=&ctx;
    for(unsigned slot=0;slot<4;slot++){
        int id=voice_slot[slot];
        unsigned bit=1u<<slot;
        if(!(voice_pending & bit)) continue;
        if(!id || !(rd32(g,GS_BASE+0x2a244a8+12*slot)&1)){voice_pending &= ~bit;continue;}
        const char *key=banks[id-1];
        int selected=!!kh_look_enabled();
        u64 bytes=voice_data[selected][id-1].bytes;
        int size=voice_data[selected][id-1].size;
        if(!bytes){
            u64 path=ga_strdup(key);
            char host[4096];
            if(selected && !kh_look_available(key,host,sizeof host)){ga_free(path);continue;}
            size=(int)kh_call(g,GS_BASE+0x3a09b0,path,0,0,0);
            if(size<80 || !(bytes=ga_alloc(size,16)) ||
               (int)kh_call(g,GS_BASE+0x3f9850,path,bytes,0,0)!=size){
                if(bytes) ga_free(bytes);
                ga_free(path);continue;
            }
            if(memcmp(hp(g,bytes),"SEDBSSCF",8) || rd32(g,bytes+16)!=(u32)size)
                kh_fatal(g,"look-voice-load: %s",key);
            ga_free(path);
            voice_data[selected][id-1].bytes=bytes;
            voice_data[selected][id-1].size=size;
        }
        /* f_1dcae0 stops slot voices, then f_1df560 retires the bank.
         * f_136060 frees mode 1 buffers at +0x58. Give each registration
         * its own copy so a retiring voice can never free the cached SCD. */
        if(!(voice_retired & bit)){
            if(getenv("KHNMC_TEST_LOOK_DIGEST")){
                /* Match the live playback records f_1de4a0 stops for this slot. */
                for(u64 v=rd64(g,GS_BASE+0xad93b0);v;v=kh_call(g,GS_BASE+0x4ad270,rd32(g,v+0x20),0,0,0)){
                    if(rd64(g,v+0x18)==slot && rd8(g,v+0x35)==5){
                        kh_warn("look-voice: retiring playing slot %u %s",slot,key);
                        break;
                    }
                }
            }
            kh_call(g,GS_BASE+0x1de4a0,slot,0,0,0);
            kh_call(g,GS_BASE+0x1363b0,slot,0xffffffffu,0,0);
            voice_retired |= bit;
        }
        int handle=0;
        u64 copy=ga_alloc(size,16);
        if(copy){
            memcpy(hp(g,copy),hp(g,bytes),size);
            handle=(int)kh_call5(g,GS_BASE+0x13b2e0,slot,copy,size,0xffffffffu,1);
            if(handle<=0){
                u64 head=rd64(g,GS_BASE+0x713450);
                if(head && rd64(g,head+0x58)==copy)
                    kh_call(g,GS_BASE+0x1363b0,slot,0xffffffffu,0,0);
                else ga_free(copy);
            }
        }
        if(handle<=0){
            if(!(voice_wait_reported & bit)) kh_warn("look-voice: slot %u %s waiting for registration",slot,key);
            voice_wait_reported |= bit;
            continue;
        }
        if(getenv("KHNMC_TEST_LOOK_DIGEST")) fprintf(stderr,"kh: look-bank mode=%d slot=%u key=%s crc=%08lx\n",
                kh_look_enabled(),slot,key,(unsigned long)crc32(0,hp(g,bytes),size));
        voice_pending &= ~bit;
        kh_warn("look-voice: slot %u %s size %d handle %d",slot,key,size,handle);
    }
    return voice_pending!=0;
}
void kh_look_voice_bind(KCtx *g){
    voice_pending=15;
    voice_retired=voice_wait_reported=0;
    kh_look_voice_retry(g);
}

/* Restaged PC fights have their own ARD and mission but omit the arena files. */
static const char *arena_fallback(const char *rel){
    static const char *const arenas[][2]={
        {"map/mu13.map","map/mu09.map"}, {"map/us/mu13.bar","map/us/mu09.bar"},
        {"map/ca26.map","map/hb38.map"}, {"map/us/ca26.bar","map/us/hb38.bar"},
        {"map/nm11.map","map/nm07.map"}, {"map/us/nm11.bar","map/us/nm07.bar"}
    };
    for(size_t i=0;i<sizeof arenas/sizeof arenas[0];i++)
        if(!strcasecmp(rel,arenas[i][0])) return arenas[i][1];
    return NULL;
}
static const char *const logo_names[]={"mod","roxas","xion","xkb","styles","painting","prompt-LB","prompt-L1","prompt-L"};
void kh_title_logo_path(int id,const char *suffix,char *host,size_t cap){
    const char *root=getenv("KHNMC_TITLE_LOGO_DIR");
    const char *data=getenv("KHNMC_DATA");
    const char *slash=(!root && data && access("private/logos",F_OK))?strrchr(data,'/'):NULL;
    int prefix=slash?(int)(slash-data+1):0;
    if(snprintf(host,cap,"%.*s%s/%s.%s",prefix,data?data:"",root?root:"private/logos",logo_names[id],suffix)>=(int)cap)
        kh_fatal(NULL,"title-logo-path: path too long");
}

static int next_logo(const char *docs,const char *mode,int count){
    char path[4096];
    if(snprintf(path,sizeof path,"%s/title-logo-%s",docs,mode)>=(int)sizeof path ||
       (mkdir(docs,0700) && errno!=EEXIST)) kh_fatal(NULL,"title-logo-documents: %s",docs);
    int fd=open(path,O_RDWR|O_CREAT,0600);
    if(fd<0 || flock(fd,LOCK_EX)) kh_fatal(NULL,"title-logo-state-open: %s",path);
    char c='0';
    ssize_t n=pread(fd,&c,1,0);
    if(n<0 || c<'0' || c>='0'+count) kh_fatal(NULL,"title-logo-state-read: %s",path);
    int current=c-'0';
    c='0'+(current+1)%count;
    if(pwrite(fd,&c,1,0)!=1 || fsync(fd) || close(fd)) kh_fatal(NULL,"title-logo-state-write: %s",path);
    return current;
}

static int choose_title_logo(const char *mode,int look,const char *docs,int selected[2]){
    for(int i=0;i<4;i++) if(mode && !strcmp(mode,logo_names[i])) return i;
    int cycle=mode && !strcmp(mode,"cycle");
    if(!cycle && mode && *mode && strcmp(mode,"auto")) kh_fatal(NULL,"title-logo-mode: %s",mode);
    if(!cycle && !look) return 1;
    if(!selected[cycle]) selected[cycle]=(cycle?1:2)+next_logo(docs,cycle?"cycle":"xion",cycle?3:2);
    return selected[cycle];
}

static _Atomic(const char *) loaded_logo_mode;

int kh_title_variant(int *picture){
    static int selected[2];
    const char *style=kh_menu_choice("KHNMC_TITLE_STYLE"),*mode=atomic_load(&loaded_logo_mode);
    *picture=kh_look_enabled()!=0;
    if(style && !strcmp(style,"roxas")){*picture=0;return 1;}
    if(style && !strcmp(style,"xion")){
        *picture=1;
        if(mode && !strcmp(mode,"xkb")) return 3;
        if(mode && strcmp(mode,"cycle") && strcmp(mode,"auto")) return 2;
        mode="auto";
    }
    return choose_title_logo(mode,*picture,kh_autosave_documents(),selected);
}

static int title_logo(void){
    static int selected[2];
    static pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER;
    pthread_mutex_lock(&lock);
    int id=choose_title_logo(kh_menu_choice("KHNMC_TITLE_LOGO"),kh_look_enabled(),kh_autosave_documents(),selected);
    pthread_mutex_unlock(&lock);
    if(id){   /* the logo pack is a local, optional add-on: without its files the title keeps the mod's own logo (never a stop) */
        static _Atomic int warned;
        char a[4096],b[4096]; struct stat st;
        kh_title_logo_path(id,"2ld",a,sizeof a); kh_title_logo_path(id,"png",b,sizeof b);
        if(stat(a,&st) || !S_ISREG(st.st_mode) || stat(b,&st) || !S_ISREG(st.st_mode)){
            if(!warned++) fprintf(stderr,"kh: title logo: %s / %s not present: the mod's own logo is shown\n",a,b);
            return 0;
        }
    }
    return id;
}

static int loose_path(KCtx *g,const char *path,const char *what,char *host,size_t cap,const char **fallback){
    char rel[2048];
    if(!relative(g,path,rel,sizeof rel)||kh_data_denied(g,rel,what)) return 0;
    if(!strcasecmp(rel,KH_TITLE_LAYOUT)){
        kh_title_logo_path(4,"2ld",host,cap);
        if(!access(host,R_OK)){
            loaded_logo_mode=kh_menu_choice("KHNMC_TITLE_LOGO");
            return KH_FILE_LOOK;
        }
        const char *style=kh_menu_choice("KHNMC_TITLE_STYLE");
        if(style && strcmp(style,"auto")) kh_fatal(g,"title-style-pack-missing: %s",host);
        int logo=title_logo();
        if(logo){ kh_title_logo_path(logo,"2ld",host,cap); return KH_FILE_LOOK; }
    }
    int profile=kh_look_key(rel);
    if(profile==KH_SCENE_MODEL){
        if(!kh_scene_path(rel,host,cap)) kh_fatal(g,"scene-roxas-asset: overlay disappeared: %s",rel);
        fprintf(stderr,"kh: scene Roxas: event overlay %s %s\n",what,rel);
        return KH_FILE_LOOK;
    }
    if(profile){ kh_look_path(g,rel,host,cap); return KH_FILE_LOOK; }
    const char *root=getenv("KHNMC_DATA"); if(!root) root="data";
    if(kh_rmc_path(rel,host,cap)) return KH_FILE_RMC;
    if(strlen(root)+strlen(rel)+2>=cap) return 0;
    if(kh_resolve_ci(root,rel,host,cap)) return 1;
    const char *arena=arena_fallback(rel);
    if(!arena || kh_data_denied(g,arena,what)) return 0;
    int source=kh_rmc_path(arena,host,cap);
    if(!source && !kh_resolve_ci(root,arena,host,cap)) return 0;
    if(fallback) *fallback=arena;
    fprintf(stderr,"kh: arena-map-fallback: %s uses %s\n",rel,arena);
    return source?source:1;
}
/* `what` names the kind of request for the deny list: a listed file is answered exactly as an absent one (data_deny.c) */
static FILE *open_loose(KCtx *g,const char *path,int *size,const char *what,const char **fallback){
    char host[4096]; FILE *f=NULL; struct stat st;
    int source=loose_path(g,path,what,host,sizeof host,fallback);
    if(source){
        f=fopen(host,"rb");
        if(f&&(fstat(fileno(f),&st)||!S_ISREG(st.st_mode)||st.st_size>INT_MAX)){ fclose(f); f=NULL; }
        if(!f && source==KH_FILE_RMC) kh_fatal(g,"rmc-open: %s",host);
        if(!f && source==KH_FILE_LOOK) kh_fatal(g,"player-look-open: %s",host);
        if(f) *size=(int)st.st_size;
    }
    return f;
}
/* Preflight uses the same readable, case-insensitive NMC data tree as the loader. */
int kh_cutscene_asset_exists(KCtx *g,const char *path){
    int size=0; FILE *f=open_loose(g,path,&size,"size",NULL);
    if(!f) return 0;
    fclose(f); return size>0;
}
/* For the stream-fd layer (stream_layer.c): the same tree-relative mapping and the same file log as the loaders. */
int kh_file_loose_path(KCtx *g,const char *path,char *host,size_t cap){
    return loose_path(g,path,"stream",host,cap,NULL);
}
void kh_file_log_entry(KCtx *g,const char *path,const char *source,long long size){ if(kh_frame_work && source) kh_file_reads++; file_log(g,path,source,size>INT_MAX?INT_MAX:(int)size); }
int kh_file_package_fallback(const char *path){ return package_fallback(path); }
static int register_resource(KCtx *g,u64 path,int n,u64 dst,const char *fallback){
    /* HD sidecars: the lifted ResourceEntry constructor runs inside SetResourceItem on this thread and pulls GetRemasteredCount/Entry/Asset (hd_assets.c). */
    char rel[2048]; const char *root=getenv("KHNMC_DATA"); if(!root) root="data";
    if(!relative(g,gstr(g,path),rel,sizeof rel)) kh_fatal(g,"hd assets: cannot derive a tree-relative path from %s",gstr(g,path));
    if(fallback) kh_data_deny_remastered(g,fallback);
    kh_data_deny_remastered(g,rel);                    /* a deny list that names textures of this file but not the file: named fatal */
    wr32(g,GS_BASE+0x79cfd4,0);
    HdTable *prev=kh_hd_begin(g,root,fallback?fallback:rel,(const unsigned char*)hp(g,dst),n);
    int ok=(s32)kh_call(g,GS_BASE+0x12f070,path,n,dst,0)!=-1;
    kh_hd_end(prev);
    return ok;
}
void f_1063d0(KCtx *g){
    pthread_mutex_lock(&files_lock);
    int n=0; FILE *f=open_loose(g,gstr(g,A1(g)),&n,"size",NULL);
    if(f){ fclose(f); file_log(g,gstr(g,A1(g)),"LOOSE",n); }
    else if(package_fallback(gstr(g,A1(g)))){
        const char *path=gstr(g,A1(g)); orig_f_1063d0(g);
        n=(s32)KH_RAX(g); file_log(g,path,n>0?"PACKAGE":NULL,n);
        pthread_mutex_unlock(&files_lock); return;
    } else { char host[2048]; struct stat st; kh_winpath(gstr(g,A1(g)),host,sizeof host);
        if(!stat(host,&st)&&S_ISREG(st.st_mode)&&st.st_size<=INT_MAX) n=st.st_size;
        file_log(g,gstr(g,A1(g)),n>0?"LOOSE":NULL,n); }
    pthread_mutex_unlock(&files_lock); SET_RAX(g,n); KH_RET(g);
}
/* Task 31: which loaded files the game still holds.  Every file read with allocation (0x106870: the buffer is the game's to free)
 * and every HD asset handed out by GetRemasteredAsset (0x106460, hd_assets.c: the `file` source of the arena is these two) is noted
 * (buffer, size, path, game frame); the report asks the arena whether that buffer is still the live `file` block of that
 * size (ga_describe) and forgets the notes of buffers that are gone.  Read-only for the game; `kh: file buffers` lines at every
 * map report and at exit (the largest ones by name).  What the id zone's growth through Twilight Town is made of. */
typedef struct { u64 dst, frame; int n; char path[100]; } LiveFile;
static LiveFile *livef; static size_t nlivef, caplivef; static u64 livef_loads, livef_bytes;
/* its own lock, taken last: GetRemasteredAsset runs inside a load that already holds files_lock on the same thread (the first
 * version took files_lock here and both final route runs hung at boot, run-Q31/final-camp-d3: 0 presents, ended by the watchdog) */
static pthread_mutex_t live_lock=PTHREAD_MUTEX_INITIALIZER;
u64 kh_game_frames(void); int ga_describe(u64 a,char *out,size_t cap);
static void live_note(u64 dst,int n,const char *path){
    pthread_mutex_lock(&live_lock);
    size_t i=0; for(;i<nlivef;i++) if(livef[i].dst==dst) break;    /* a buffer handed out again replaces its old note */
    if(i==nlivef){ if(nlivef==caplivef){ size_t nc=caplivef?caplivef*2:256; LiveFile *nl=realloc(livef,nc*sizeof *nl); if(!nl){ pthread_mutex_unlock(&live_lock); return; } livef=nl; caplivef=nc; } nlivef++; }
    size_t l=strlen(path); livef[i].dst=dst; livef[i].n=n; livef[i].frame=kh_game_frames(); snprintf(livef[i].path,sizeof livef[i].path,"%s",l>=sizeof livef[i].path?path+l-(sizeof livef[i].path-1):path);
    livef_loads++; livef_bytes+=(u64)n;
    pthread_mutex_unlock(&live_lock);
}
void kh_file_live_note(u64 dst,u64 n,const char *what){ if(kh_frame_work) kh_file_reads++; live_note(dst,n>INT_MAX?INT_MAX:(int)n,what); }   /* hd_assets.c: the HD asset buffers */
static int live_cmp(const void *a,const void *b){ const LiveFile *x=a,*y=b; return x->n<y->n?1:x->n>y->n?-1:0; }
/* the kind of a held buffer, for the totals: its directory (obj, map, menu, event, effect, ...) and whether it is an HD asset (an HD
 * asset's note is `<archive>#<index>:<name>`, a plain file's note its path) */
static void live_kind(const char *path,char *out,size_t cap){
    const char *s=strchr(path,'/'); size_t l=s?(size_t)(s-path):0; if(l==0||l>12){ snprintf(out,cap,"other"); }
    else snprintf(out,cap,"%.*s",(int)l,path);
    if(cap>8 && strlen(out)+3<cap) strcat(out,strchr(path,'#')?"/hd":"/sd");
}
/* top > 0: the `top` largest buffers by name; top < 0: every held buffer (KHNMC_IDTABLE_REPORT at exit) */
void kh_file_live_report(FILE *f,int top){
    pthread_mutex_lock(&live_lock);
    size_t k=0; u64 bytes=0;
    for(size_t i=0;i<nlivef;i++){ char d[240], want[80]; ga_describe(livef[i].dst,d,sizeof d);
        snprintf(want,sizeof want,"file block 0x%llx (%llu bytes) +0x0",(unsigned long long)livef[i].dst,(unsigned long long)(u64)livef[i].n);
        if(strstr(d,want) && !strstr(d,"FREED")){ bytes+=(u64)livef[i].n; livef[k++]=livef[i]; } }
    nlivef=k;
    /* task 31: the held bytes by kind (at most 16 kinds; more go to "other/*") */
    char kinds[16][24]; u64 kb[16]={0}; int kn=0, nk=0;
    for(size_t i=0;i<k;i++){ char kd[24]; live_kind(livef[i].path,kd,sizeof kd); int j=0; for(;j<nk;j++) if(!strcmp(kinds[j],kd)) break;
        if(j==nk){ if(nk<16){ snprintf(kinds[nk],sizeof kinds[nk],"%s",kd); nk++; } else { j=15; snprintf(kinds[15],sizeof kinds[15],"other/*"); } }
        kb[j]+=(u64)livef[i].n; }
    char by[600]; size_t bo=0; by[0]=0;
    for(int j=0;j<nk && bo<sizeof by;j++){ bo+=(size_t)snprintf(by+bo,sizeof by-bo,"%s%s %.1f",kn++?", ":"",kinds[j],(double)kb[j]/1048576.0); }
    fprintf(f,"kh: file buffers: %zu of the %llu file and HD-asset buffers handed to the game are still held by it: %llu MiB of %llu MiB handed out (MiB by kind: %s)\n",
            k,(unsigned long long)livef_loads,(unsigned long long)(bytes>>20),(unsigned long long)(livef_bytes>>20),nk?by:"none");
    if(top!=0 && k){ LiveFile *c=malloc(k*sizeof *c); if(c){ memcpy(c,livef,k*sizeof *c); qsort(c,k,sizeof *c,live_cmp);
        for(size_t i=0;i<k && (top<0 || (int)i<top);i++) fprintf(f,"kh: file buffers:   %8.1f MiB held since game frame %llu  %s\n",(double)c[i].n/1048576.0,(unsigned long long)c[i].frame,c[i].path);
        free(c); } }
    pthread_mutex_unlock(&live_lock);
}
static void load(KCtx *g,int bounded,int allocate){
    u64 path=A1(g),dst=A2(g),sizeptr=A2(g); int hd=bounded?A4(g):A3(g);
    s32 oldsize=allocate?(s32)rd32(g,sizeptr):0;
    pthread_mutex_lock(&files_lock);
    const char *fallback=NULL;
    int n=0; FILE *f=open_loose(g,gstr(g,path),&n,"load",&fallback); s64 result=allocate||bounded?0:-1;
    if(!f){
        if(package_fallback(gstr(g,path))){
            if(allocate) orig_f_106870(g); else if(bounded) orig_f_106790(g); else orig_f_106700(g);
            int size=allocate?(s32)rd32(g,sizeptr):(s32)KH_RAX(g);
            int hit=allocate?(KH_RAX(g)!=0||(oldsize==-1&&size>=0)):(size>0);
            u64 data=allocate?KH_RAX(g):dst;
            if(kh_frame_work && hit && data && size>0) kh_file_reads++;
            if(hit && data && size>0) kh_look_font_loaded(gstr(g,path),hp(g,data),size);
            file_log(g,gstr(g,path),hit?"PACKAGE":NULL,size);
            pthread_mutex_unlock(&files_lock); return;
        }
        file_log(g,gstr(g,path),NULL,0); goto done;
    }
    if(bounded&&(s32)A3(g)<n){ result=-6; goto close; }
    if(allocate){ s32 old=rd32(g,sizeptr); wr32(g,sizeptr,n); if(old==-1) goto close;
        dst=ga_alloc_src(n,16,GA_SRC_FILE); if(!dst){ wr32(g,sizeptr,-2); goto close; } }
    if(fread(hp(g,dst),1,n,f)!=(size_t)n){
        if(allocate){ ga_free(dst); wr32(g,sizeptr,-2); } else result=-2;
        goto close;
    }
    if(kh_frame_work) kh_file_reads++;
    kh_look_font_loaded(gstr(g,path),hp(g,dst),n);
    result=allocate?dst:n;
    if(allocate) live_note(dst,n,gstr(g,path));
    if(hd&&n&&!register_resource(g,path,n,dst,fallback)){ if(allocate) ga_free(dst); result=0; }
close:
    fclose(f);
    file_log(g,gstr(g,path),"LOOSE",n);
done:
    pthread_mutex_unlock(&files_lock); SET_RAX(g,allocate?result:(u32)result); KH_RET(g);
}
void f_106700(KCtx *g){ load(g,0,0); }
void f_106790(KCtx *g){ load(g,1,0); }
void f_106870(KCtx *g){ load(g,0,1); }

/* Fixtures are synthetic and local; this also exercises hooks through the dispatch table. */
int kh_file_selftest(KCtx *g){
    char dir[KH_TMP_MAX],path[KH_TMP_MAX+256]; int bad=0,checks=0; kh_tmp_path(dir,sizeof dir,"khnmc-files-XXXXXX");   /* host_env.c: /tmp, or the app container on iOS */
    const char *oldroot=getenv("KHNMC_DATA"),*oldlog=getenv("KHNMC_FILELOG");
    char *root=oldroot?strdup(oldroot):NULL,*log=oldlog?strdup(oldlog):NULL;
    if(!mkdtemp(dir)) return 1;
    snprintf(path,sizeof path,"%s/MiXeD.bin",dir); FILE *f=fopen(path,"wb");
    if(!f) return 1; fwrite("test",1,4,f); fclose(f);
    setenv("KHNMC_DATA",dir,1); char lp[KH_TMP_MAX+256]; snprintf(lp,sizeof lp,"%s/log",dir); setenv("KHNMC_FILELOG",lp,1);
    u64 name=ga_strdup("mixed.bin"),missing=ga_strdup("missing"),dst=ga_alloc(16,16),sz=ga_alloc(16,16);
#define TEST(c) do { checks++; if(!(c)){ fprintf(stderr,"file selftest FAIL: %s\n",#c); bad++; } } while(0)
    const char *policy=getenv("KHNMC_LOOK_NAMES");
    char *saved_policy=policy?strdup(policy):NULL;
    setenv("KHNMC_LOOK_NAMES","all",1);
    int initial_look=player_look;
    kh_look_set(g,1);
    /* Exercise the native handle-zero branch past the old 600-frame cutoff. */
    u64 service=GS_BASE+0x8bbd08,active=GS_BASE+0x2a244a8;
    u64 saved_service=rd64(g,service);
    u32 saved_active=rd32(g,active);
    u64 scd=ga_calloc(1,80);
    memcpy(hp(g,scd),"SEDBSSCF",8); wr32(g,scd+16,80);
    wr64(g,service,0); wr32(g,active,1);
    voice_slot[0]=1;
    voice_data[1][0].bytes=scd; voice_data[1][0].size=80;
    kh_look_voice_bind(g);
    for(int i=0;i<650;i++) kh_look_voice_retry(g);
    TEST(voice_pending==1 && voice_retired==1);
    wr32(g,active,0);
    TEST(!kh_look_voice_retry(g));
    wr32(g,active,saved_active); wr64(g,service,saved_service);
    voice_slot[0]=0; voice_data[1][0].bytes=0; voice_data[1][0].size=0;
    voice_retired=voice_wait_reported=0;
    ga_free(scd);
    TEST(kh_look_key("./OBJ//p_ex100.MDLX")==-1 && kh_look_key("obj/P_EX100_WI_KH1F.a.us")==40);
    TEST(kh_look_key("remastered/obj/P_EX100.a.us/-36.dds")==37 && !kh_look_key("remastered/obj/P_EX100.a.us/-37.dds"));
    TEST(kh_look_key("voice/us/battle/TT0_ROXAS.win32.scd")==-1);
    TEST(kh_look_key("remastered/obj/P_EX100_ULTF.a.us/voice/battle/us/awakened")==-1);
    TEST(!kh_look_key("remastered/obj/P_EX220.a.us/voice/battle/us/xion"));
    TEST(!kh_look_key("obj/P_EX100.mset") && !kh_look_key("obj/P_EX1000.mdlx"));
    u64 label=ga_strdup("@KHINPUT(slash,data/msg/us/he.bar,15561,5,6371a57675507ca2b56b55306572693e0b838cda8d98eeecb9ec54a9dd62947b)@");
    TEST(label && !memcmp(hp(g,kh_look_name(g,0x851f,label)),"@KHINPUT(slash,data/msg/us/po.bar,13217,4,3841ba554755fe34fbbe96d4378902dcb824fa5bb69ca360c5ceb31d86e155f6)@",5));
    TEST(!memcmp(hp(g,kh_look_name(g,0x4023,label)),xion,5));
    TEST(kh_look_name(g,0xc91a,label)==label && kh_look_name(g,0x4f43,label)==label);
    u64 speaker=ga_alloc(16,16);
    memcpy(hp(g,speaker),"@KHINPUT(slash,data/msg/us/he.bar,15561,5,6371a57675507ca2b56b55306572693e0b838cda8d98eeecb9ec54a9dd62947b)@\x52\x01\x07\x00\x44\x00\x00\x48",14);
    u64 line=kh_look_name(g,0x27a,speaker);
    TEST(line!=speaker && !memcmp(hp(g,line+4),hp(g,speaker+5),9));
    TEST(kh_look_name(g,0x27a,speaker)==line); ga_free(speaker);
    u64 journal=ga_strdup("@KHINPUT(slash,data/msg/us/sys.bar,96456,12,d13da141f68b0178c5342434dea058ee95c59dfae40d8768ba1ab211596486ac)@");
    u64 heading=kh_look_name(g,0x453a,journal);
    TEST(heading!=journal && !memcmp(hp(g,heading+5),xion,4) && rd8(g,heading+9)==0xec);
    u64 cached=kh_look_name(g,0x51f,label);
    for(int i=0;i<8;i++){
        kh_look_set(g,i&1);
        TEST(!strcmp(gstr(g,cached),(i&1)?xion:roxas));
        TEST(kh_look_name(g,0x51f,label)==cached);
    }
    setenv("KHNMC_LOOK_NAMES","menus",1);
    TEST(kh_look_name(g,0x4023,label)==label);
    setenv("KHNMC_LOOK_NAMES","all",1);
    u64 repeated=ga_alloc(32,16);
    u8 *r=hp(g,repeated);
    memcpy(r,roxas,5); r[5]=7; memcpy(r+6,roxas,5);
    memcpy(r+11,roxas,5); r[16]=0xec; r[17]=0xac; r[18]=0x4f; r[19]=0;
    u64 display=kh_look_name(g,104,repeated);
    TEST(!memcmp(hp(g,display),xion,4) && !memcmp(hp(g,display+4),r+5,6) &&
         !memcmp(hp(g,display+10),xion,4) && !memcmp(hp(g,display+14),r+16,4));
    kh_look_set(g,0);
    TEST(!memcmp(hp(g,display),r,20));
    ga_free(repeated);
    if(saved_policy){setenv("KHNMC_LOOK_NAMES",saved_policy,1); free(saved_policy);}
    else unsetenv("KHNMC_LOOK_NAMES");
    kh_xkb_set_mode(g,1);
    TEST(!strcmp(gstr(g,cached),xion) && kh_look_key("obj/H_EX510_PAJAMAS.mdlx")==-1);
    kh_look_set(g,0);
    TEST(kh_xion_enabled && !kh_look_enabled() && !strcmp(gstr(g,cached),roxas));
    kh_xkb_set_mode(g,1); /* a second load of the same mode also resets its appearance */
    TEST(kh_xion_enabled && kh_look_enabled()==1);
    kh_xkb_set_mode(g,0);
    kh_look_set(g,2);
    kh_xkb_set_mode(g,0);
    TEST(!kh_xion_enabled && !kh_look_enabled());
    TEST(!strcmp(gstr(g,cached),roxas) && !kh_look_key("obj/H_EX510_PAJAMAS.mdlx"));
    ga_free(label); ga_free(journal);
    for(int count=2;count<=3;count++)
        for(int j=0;j<count*2;j++) TEST(next_logo(dir,count==2?"xion":"cycle",count)==j%count);
    for(int launch=0;launch<6;launch++){
        int picks[2]={0};
        TEST(choose_title_logo(NULL,0,dir,picks)==1);
        TEST(choose_title_logo("auto",1,dir,picks)==2+launch%2);
        TEST(choose_title_logo("",2,dir,picks)==2+launch%2);
        TEST(choose_title_logo("cycle",0,dir,picks)==1+launch%3);
        TEST(choose_title_logo("cycle",2,dir,picks)==1+launch%3);
        for(int i=0;i<4;i++) TEST(choose_title_logo(logo_names[i],2,dir,picks)==i);
    }
    {   /* the logo counters live in the test directory: remove them so the directory can be removed (app-way scratch check) */
        char counter[KH_TMP_MAX+64];
        snprintf(counter,sizeof counter,"%s/title-logo-xion",dir); TEST(unlink(counter)==0);
        snprintf(counter,sizeof counter,"%s/title-logo-cycle",dir); TEST(unlink(counter)==0);
    }
    TEST(!kh_look_key("obj/P_EX100.mdlx"));
    const char *pack_env=getenv("KHNMC_SCENE_ROXAS_DIR");
    char *initial_pack=pack_env?strdup(pack_env):NULL;
    char pack[KH_TMP_MAX+256],member[KH_TMP_MAX+512],resolved[4096];
    snprintf(pack,sizeof pack,"%s/scene",dir);
    setenv("KHNMC_SCENE_ROXAS_DIR",pack,1);
    const char *dirs[]={"","/obj","/remastered","/remastered/obj","/remastered/" KH_SCENE_MDLX};
    for(size_t i=0;i<sizeof dirs/sizeof *dirs;i++){
        snprintf(member,sizeof member,"%s%s",pack,dirs[i]); TEST(mkdir(member,0700)==0);
    }
    for(size_t i=0;i<sizeof scene_files/sizeof *scene_files;i++){
        snprintf(member,sizeof member,"%s/%s",pack,scene_files[i]);
        if(i==KH_SCENE_TEXTURES){  /* model and first two textures already present */
            kh_scene_pack_begin(); TEST(!kh_look_key(KH_SCENE_MDLX));
        }
        FILE *part=fopen(member,"wb"); TEST(part!=NULL);
        if(part){ fputc('x',part); fclose(part); }
    }
    kh_rmc_init(pack);
    TEST(kh_file_loose_path(g,KH_SCENE_MDLX,resolved,sizeof resolved)==KH_FILE_RMC);
    TEST(!kh_look_key(KH_SCENE_MDLX)); /* keep the decision for the whole event */
    kh_scene_pack_end(); kh_scene_pack_begin();
    TEST(kh_file_loose_path(g,KH_SCENE_MDLX,resolved,sizeof resolved)==KH_FILE_LOOK);
    TEST(kh_file_loose_path(g,scene_files[3],resolved,sizeof resolved)==KH_FILE_LOOK && !strcmp(resolved,member));
    TEST(kh_look_key("./OBJ//h_ex500.MDLX")==KH_SCENE_MODEL);
    TEST(kh_look_key("remastered/obj/H_EX500.mdlx/-2.dds")==KH_SCENE_MODEL);
    TEST(!kh_look_key("remastered/obj/H_EX500.mdlx/-3.dds") && !kh_look_key("obj/H_EX500.mset"));
    kh_rmc_init(NULL);
    u32 event_state=rd32(g,GS_BASE+0xb65210);
    wr32(g,GS_BASE+0xb65210,4); /* the guest's already-ended case has no other side effects */
    kh_call(g,GS_BASE+0x2cbd80,0,0,0,0);
    wr32(g,GS_BASE+0xb65210,event_state);
    TEST(!kh_look_key(KH_SCENE_MDLX) && !kh_file_loose_path(g,KH_SCENE_MDLX,resolved,sizeof resolved));
    const char *look_env=getenv("KHNMC_LOOK_DIR");

static pthread_mutex_t files_lock=PTHREAD_MUTEX_INITIALIZER;
/* Per-frame readers must not walk packs (review round 9, item 10: the title draw and the Character page asked the file layer for
 * the same answer every frame, and on iOS every lookup walks directories case-insensitively).  These two answers are cached and
 * dropped by kh_look_set, which every look / pack change runs through. */
static _Atomic int title_available_cache[KH_TITLE_SCREENS]={-1,-1,-1};
static _Atomic int axel_weapon_ready_cache=-1;
static void look_cache_clear(void){
    for(int i=0;i<KH_TITLE_SCREENS;i++) atomic_store(&title_available_cache[i],-1);
    atomic_store(&axel_weapon_ready_cache,-1);
}
static unsigned real_packages;
void orig_f_106000(KCtx *g);
void orig_f_1063d0(KCtx *g);
void orig_f_106700(KCtx *g);
void orig_f_106790(KCtx *g);
void orig_f_106870(KCtx *g);
int kh_data_denied(KCtx *g,const char *rel,const char *what);        /* data_deny.c (task 32): KHNMC_DATA_DENY */
void kh_data_deny_remastered(KCtx *g,const char *rel);
void kh_music_note_file(KCtx *g,const char *path,int hit,long long size);   /* music_log.c (task 32): bgm/ and vagstream/ requests */

static int real_package(const char *name){
    if(!getenv("KHNMC_PKGDIR")) return 0;
    char win[2048],host[2048]; struct stat st;
    const char *exts[]={"hed","pkg"};
    for(int i=0;i<2;i++){
        if(snprintf(win,sizeof win,"%s.%s",name,exts[i])>=(int)sizeof win ||
           !kh_winpath(win,host,sizeof host)||stat(host,&st)||!S_ISREG(st.st_mode)) return 0;
    }
    return 1;
}
static int package_fallback(const char *path){
    char normalized[2048]; size_t n=strlen(path);
    if(!real_packages||n>=sizeof normalized) return 0;
    for(size_t i=0;i<=n;i++) normalized[i]=path[i]=='\\'?'/':path[i];
    for(char *p=normalized;*p;){ size_t len=strcspn(p,"/");
        if(len==2&&!strncmp(p,"..",2)) return 0; p+=len; if(*p) p++; }
    return 1;
}
static void file_log(KCtx *g,const char *path,const char *source,int size){
    kh_phase_file(g,path); kh_music_note_file(g,path,source!=NULL,size);
    { extern void kh_warp_file_event(KCtx *,const char *,const char *); kh_warp_file_event(g,path,source); }   /* task 33: attributed to a debug warp while one is watched */
    const char *log=getenv("KHNMC_FILELOG"); FILE *lf=fopen(log?log:"filelog.txt","a");
    if(!lf) kh_fatal(g,"cannot append file log %s",log?log:"filelog.txt");
    int failed=fprintf(lf,"%s %s %d %s\n",source?"HIT":"MISS",source?source:"NONE",size,path)<0;
    if(fclose(lf)||failed) kh_fatal(g,"cannot write file log");
}

void f_106000(KCtx *g){
    u64 obj=A0(g); const char *name=gstr(g,A1(g));
    if(real_package(name)){
        orig_f_106000(g);
        if(!rd64(g,obj+8)||(s32)rd32(g,obj+0x10)<0)
            kh_fatal(g,"real package constructor failed: %s",name);
        real_packages++;
        fprintf(stderr,"kh: real package registered: %s (%u entries)\n",name,rd32(g,obj+0x14));
        return;
    }
    fprintf(stderr,"kh: empty package registered: %s\n",name);
    memset(hp(g,obj),0,0x260);
    wr64(g,obj,GS_BASE+0x585fb0);
    wr64(g,obj+8,ga_calloc(1,32)); /* non-NULL is the package-ready flag; count stays zero */
    if(!rd64(g,obj+8)) kh_fatal(g,"empty package table allocation failed");
    wr32(g,obj+0x10,-1);
    snprintf(hp(g,obj+0x20),260,"%s.pkg",name);
    SET_RAX(g,obj); KH_RET(g);
}

static int normalize(const char *s,char *out,size_t cap){
    size_t n=strlen(s); if(n>=cap) return 0;
    for(size_t i=0;i<=n;i++) out[i]=s[i]=='\\'?'/':s[i];
    return 1;
}
static int relative(KCtx *g,const char *path,char *rel,size_t cap){
    char base[2048];
    if(!normalize(path,rel,cap)||!normalize(gstr(g,GS_BASE+0x2bd4340),base,sizeof base)) return 0;
    size_t n=strlen(base);
    if(n&&!strncasecmp(rel,base,n)&&rel[n]=='/') memmove(rel,rel+n+1,strlen(rel+n+1)+1);
    /* Reject absolute and parent paths before using the shared Windows resolver. */
    if(rel[0]=='/'||strchr(rel,':')) return 0;
    for(char *p=rel;*p;){ size_t n=strcspn(p,"/"); if(n>=512||(n==2&&!strncmp(p,"..",2))) return 0; p+=n; if(*p) p++; }
    return 1;
}
static _Atomic int player_look;
_Thread_local int kh_loading_look=-1;

/* Preload can enqueue a read on another thread. Keep the decision until the
 * game's event teardown, and serialize changes with read + HD registration. */
static _Atomic int scene_pack; /* 0 outside, -1 missing for this event, 1 available */
static const char *const scene_files[]={
    KH_SCENE_MDLX, "remastered/" KH_SCENE_MDLX "/-0.dds",
    "remastered/" KH_SCENE_MDLX "/-1.dds", "remastered/" KH_SCENE_MDLX "/-2.dds"
};

const char *kh_scene_root(void){
    const char *root=getenv("KHNMC_SCENE_ROXAS_DIR");
    return root?root:"private/scene-roxas";
}
/* lane scene-off (KHNMC_SCENE_LOOK, default 0): 1 when the look may follow into the story scenes.
 * Round 9 item 0: this is the ONLY gate, in every campaign mode -- ordinary, Xion Always Cries / Xion Knows Best, Axel Won't Cry
 * (before: the Xion / Axel modes followed without it).  The scene-roxas overlay (Roxas in Sora's close-ups) is not a look and
 * keeps its own gate (events_stub.c scene_roxas: the modes or KHNMC_SCENE_ROXAS=1). */
int kh_scene_look(void){
    const char *v=getenv("KHNMC_SCENE_LOOK");
    if(!v || !*v || !strcmp(v,"0")) return 0;
    if(!strcmp(v,"1")) return 1;
    kh_fatal(NULL,"scene-look-mode: KHNMC_SCENE_LOOK=%s (expected 0 or 1)",v);
}
/* Round 9 item 0: the look the story scenes wear: the field look with KHNMC_SCENE_LOOK=1, else 0 (Roxas, as with look 0). */
int kh_scene_wear(void){ return kh_scene_look()?kh_look_enabled():0; }
static const char *look_root(int look){
    if(look==KH_LOOK_ROXAS_HD){
        const char *root=getenv("KHNMC_LOOK_ROXAS_HD_DIR");
        return root?root:"private/looks/roxas-hd";
    }
    if(look==KH_LOOK_AXEL){
        const char *root=getenv("KHNMC_LOOK_AXEL_DIR");
        return root?root:"private/looks/axel";
    }
    if(look==2){
        const char *root=getenv("KHNMC_LOOK_HOODED_DIR");
        return root?root:"private/looks/xion-hooded";
    }
    const char *root=getenv("KHNMC_LOOK_DIR");
    return root?root:"private/looks/xion";
}
const char *kh_look_root(void){return look_root(kh_look_enabled());}
/* The root of any look's pack (the savestate identity hashes the packs that serve files under every look: the N_PO010 companion
 * from the Xion pack, the title pictures and sketches from the Xion / hooded / Axel packs). */
const char *kh_look_root_for(int look){return look_root(look);}
int kh_scene_path(const char *rel,char *host,size_t cap){
    const char *root=kh_scene_root();
    struct stat st;
    return *root && strlen(root)+strlen(rel)+2<=cap && kh_resolve_ci(root,rel,host,cap) &&
           !stat(host,&st) && S_ISREG(st.st_mode) && st.st_size>0 && st.st_size<=INT_MAX && !access(host,R_OK);
}

int kh_scene_pack_ready(void){
    char host[4096];
    for(size_t i=0;i<sizeof scene_files/sizeof *scene_files;i++)
        if(!kh_scene_path(scene_files[i],host,sizeof host)) return 0;
    return 1;
}

void kh_scene_pack_begin(void){
    if(scene_pack) return;
    pthread_mutex_lock(&files_lock);
    if(!scene_pack){
        char host[4096];
        int ok=1;
        if(kh_scene_wear()){   /* round 9 item 0: the look's H_EX500 only when the scenes wear the look, else the overlay */
            if(!kh_look_available(KH_SCENE_MDLX,host,sizeof host)){
                kh_warn("scene-xion-asset: %s unavailable for this event",KH_SCENE_MDLX);
                ok=0;
            }
        }else for(size_t i=0;i<sizeof scene_files/sizeof *scene_files;i++){
            if(kh_scene_path(scene_files[i],host,sizeof host)) continue;
            fprintf(stderr,"kh: scene Roxas: missing overlay %s; keeping Sora for this event\n",scene_files[i]);
            ok=0; break;
        }
        scene_pack=ok?1:-1;
    }
    pthread_mutex_unlock(&files_lock);
}

void kh_scene_pack_end(void){
    if(!scene_pack) return;
    pthread_mutex_lock(&files_lock);
    scene_pack=0;
    pthread_mutex_unlock(&files_lock);
}

int kh_scene_pack_active(void){ return scene_pack==1; }

int kh_scene_key(const char *rel){
    for(size_t i=0;i<sizeof scene_files/sizeof *scene_files;i++)
        if(!strcasecmp(rel,scene_files[i])) return KH_SCENE_MODEL;
    return 0;
}

/* Menus may retain the returned guest address for the lifetime of a page. */
static u64 name_overlays;
static const char roxas[]="@KHINPUT(slash,data/msg/us/he.bar,15561,5,6371a57675507ca2b56b55306572693e0b838cda8d98eeecb9ec54a9dd62947b)@",xion[]="@KHINPUT(slash,data/msg/us/po.bar,13217,4,3841ba554755fe34fbbe96d4378902dcb824fa5bb69ca360c5ceb31d86e155f6)@",axel[]="\x2e\xb1\x9e\xa5";
static const char *look_name(int look){ return look==KH_LOOK_AXEL?axel:kh_look_is_xion(look)?xion:roxas; }
static pthread_mutex_t names_lock=PTHREAD_MUTEX_INITIALIZER;
/* Each overlay keeps both the source bytes and a stable display buffer. */
static int menu_name(int id,const u8 *src,size_t at){
    id&=0x7fff;
    switch(id){
    case 0x51f: case 0x52d: case 0x534a: case 0x2ce8: case 0x2d0c: case 0x2e9a:
        return !at && !src[5];
    case 0x453a: case 0x50e5: case 0x511d: case 0x533f:
        return at==(id==0x453a?5:0) && (src[at+5]==0xec || src[at+5]==0xee);
    default: return 0;
    }
}
static size_t render_name(KCtx *g,int id,const u8 *src,u8 *dst,int menus,int selected,int *matched){
    size_t i=0,n=0;
    while(src[i]){
        if(i>=65536) kh_fatal(g,"look-name-message-length: %#x",id);
        size_t step=1+(src[i]<32?kh_route_message_ctl_args(src[i]):0);
        if(!strncmp((const char *)src+i,roxas,5) && (!menus || menu_name(id,src,i))){
            *matched=1;
            const char *name=look_name(selected);   /* never longer than the five bytes it replaces */
            size_t len=strlen(name);
            if(dst) memcpy(dst+n,name,len);
            i+=5; n+=len;
        }else{
            if(dst) memcpy(dst+n,src+i,step);
            i+=step; n+=step;
        }
    }
    if(dst) dst[n]=0;
    return i+1;
}
static void update_name(KCtx *g,u64 e){
    unsigned size=rd32(g,e+8); int matched=0;
    render_name(g,rd16(g,e+12),hp(g,e+16+size),hp(g,e+16),rd8(g,e+14),kh_look_enabled(),&matched);
}
void kh_look_set(KCtx *g,int selected){
    pthread_mutex_lock(&files_lock);
    pthread_mutex_lock(&names_lock);
    player_look=selected;
    look_cache_clear();
    for(u64 e=name_overlays;e;e=rd64(g,e)) update_name(g,e);
    pthread_mutex_unlock(&names_lock);
    pthread_mutex_unlock(&files_lock);
}
u64 kh_look_name(KCtx *g,int id,u64 original){
    if(!original) return 0;
    /* These native mission and rematch messages name the opposing Roxas. */
    switch(id&0x7fff){
    case 0x377a: case 0x48bc: case 0x491a: case 0x4ed9: case 0x4f43: return original;
    }
    const char *policy=kh_menu_choice("KHNMC_LOOK_NAMES");
    int menus=policy && !strcmp(policy,"menus"),matched=0;
    if(policy && *policy && !menus && strcmp(policy,"all")) kh_fatal(g,"look-name-policy: expected all or menus");
    const u8 *src=hp(g,original);
    size_t size=render_name(g,id,src,NULL,menus,0,&matched);
    if(!matched) return original;
    id&=0x7fff;
    pthread_mutex_lock(&names_lock);
    u64 e=name_overlays;
    while(e){
        if(rd32(g,e+8)==size && rd16(g,e+12)==id && rd8(g,e+14)==menus &&
           !memcmp(hp(g,e+16+size),src,size)) break;
        e=rd64(g,e);
    }
    if(!e){
        e=ga_alloc(16+2*size,16);
        if(!e) kh_fatal(g,"look-name-allocation");
        wr64(g,e,name_overlays); wr32(g,e+8,size); wr16(g,e+12,id); wr8(g,e+14,menus);
        memcpy(hp(g,e+16+size),src,size);
        update_name(g,e); name_overlays=e;
    }
    pthread_mutex_unlock(&names_lock);
    return e+16;
}
/* Route readers reverse a displayed pointer to its current message table. */
int kh_look_message_id(KCtx *g,u64 text){
    pthread_mutex_lock(&names_lock);
    int id=-1;
    for(u64 e=name_overlays;e;e=rd64(g,e)){
        if(text>=e+16 && text<e+16+rd32(g,e+8)){id=rd16(g,e+12); break;}
    }
    pthread_mutex_unlock(&names_lock);
    return id;
}
static int look_file(int look,const char *rel,char *host,size_t cap){
    const char *root=look_root(look);
    struct stat st;
    return *root && strlen(root)+strlen(rel)+2<=cap && kh_resolve_ci(root,rel,host,cap) &&
           !stat(host,&st) && S_ISREG(st.st_mode) && st.st_size>0 && st.st_size<=INT_MAX && !access(host,R_OK);
}
int kh_scene_form_alias(const char *rel,char *out,size_t cap){
    static const char *const forms[]={"_BTLF","_MAGF","_KH1F","_TRIF","_ULTF"};
    size_t pre=!strncasecmp(rel,"remastered/",11)?11:0;
    if(strncasecmp(rel+pre,"obj/H_EX500_",12)) return 0;
    const char *f=rel+pre+11;
    for(size_t i=0;i<sizeof forms/sizeof *forms;i++){
        if(strncasecmp(f,forms[i],5) || strncasecmp(f+5,".mdlx",5)) continue;
        const char *tail=f+10;
        if(pre ? tail[0]!='/' || !tail[1] || strchr(tail+1,'/') : tail[0]!=0) return 0;
        if(out && snprintf(out,cap,"%sobj/H_EX500.mdlx%s",pre?"remastered/":"",tail)>=(int)cap) return 0;
        return 1;
    }
    return 0;
}
/* A file the pack does not hold under a Drive form's high-Sora name is its H_EX500 (kh_scene_form_alias). */
int kh_look_asset(int look,const char *rel,char *host,size_t cap){
    if(look_file(look,rel,host,cap)) return 1;
    char alias[2300];
    return kh_scene_form_alias(rel,alias,sizeof alias) && look_file(look,alias,host,cap);
}
int kh_look_available(const char *rel,char *host,size_t cap){return kh_look_asset(kh_look_enabled(),rel,host,cap);}
/* lane HM (kh_look.h): the companion's model and its HD sheets come from the Xion pack; the model only together with sheet -0. */
int kh_companion_asset(const char *rel,char *host,size_t cap){
    static const char *const names[]={"obj/N_PO010_BTL.mdlx","obj/N_PO010_RTN.mdlx"};
    size_t pre=!strncasecmp(rel,"remastered/",11)?11:0;
    for(size_t i=0;i<sizeof names/sizeof *names;i++){
        size_t n=strlen(names[i]);
        if(strncasecmp(rel+pre,names[i],n)) continue;
        const char *tail=rel+pre+n;
        if(pre ? tail[0]!='/' || !tail[1] || strchr(tail+1,'/') : tail[0]!=0) return 0;
        char leaf[64];
        snprintf(leaf,sizeof leaf,"remastered/%s/-0.dds",names[i]);
        return look_file(KH_LOOK_XION,leaf,host,cap) && look_file(KH_LOOK_XION,rel,host,cap);
    }
    return 0;
}
/* The Axel look's optional chakram set (lane WEAPON: 101 drop-in keyblade files cut from KH2's B_EX110): <axel pack>/weapons/
 * chakram/obj/<name>.mdlx stands for the game's obj/<name>.mdlx of the same name (only W_EX010*.mdlx; the .a.us effects and the
 * W_EX010*.mset motions stay the game's), weapons/chakram/hd/-<i>.dds is HD texture i of every one of them.  Offered when the
 * Axel pack is complete and the set's base file and first HD texture are there; a missing variant keeps its keyblade. */
_Thread_local int kh_loading_weapon;
int kh_axel_weapon_asset(const char *rel,char *host,size_t cap){
    char sub[2300];
    if(strncasecmp(rel,"obj/W_EX010",11) || strlen(rel)<16 || strcasecmp(rel+strlen(rel)-5,".mdlx") ||
       snprintf(sub,sizeof sub,"weapons/chakram/%s",rel)>=(int)sizeof sub) return 0;
    return kh_look_asset(KH_LOOK_AXEL,sub,host,cap);
}
int kh_axel_weapon_ready(void){
    int cached=atomic_load(&axel_weapon_ready_cache);
    if(cached>=0) return cached;
    char host[4096];
    int ready=kh_look_pack_ready(KH_LOOK_AXEL) && kh_axel_weapon_asset("obj/W_EX010.mdlx",host,sizeof host) &&
              kh_look_asset(KH_LOOK_AXEL,"weapons/chakram/hd/-0.dds",host,sizeof host);
    atomic_store(&axel_weapon_ready_cache,ready?1:0);
    return ready;
}
void kh_look_path(KCtx *g,const char *rel,char *host,size_t cap){
    if(!kh_look_available(rel,host,cap)) kh_fatal(g,"player-look-asset: missing or invalid %s",rel);
}

/* mode: KH_MODE_NONE, KH_MODE_XION (any nonzero value older callers pass for "a Xion mode") or KH_MODE_AXEL.
 * Each mode resets the appearance to its default, on every new game and load. */
void kh_xkb_set_mode(KCtx *g,int mode){
    kh_settings_reset_look();
    int previous=kh_look_enabled();
    int axel=mode==KH_MODE_AXEL,look=axel?KH_LOOK_AXEL:mode?KH_LOOK_XION:KH_LOOK_ROXAS;
    kh_xion_enabled=mode && !axel;
    kh_axel_enabled=axel;
    if(axel && !kh_look_switch_ready(KH_LOOK_AXEL)){
        /* A save of this mode loaded without its pack: the campaign and its tag stay, the appearance is Roxas. */
        kh_warn("axel-mode-pack-missing: %s is absent or incomplete, keeping Roxas",look_root(KH_LOOK_AXEL));
        look=KH_LOOK_ROXAS;
    }
    kh_look_set(g,look);
    kh_warn("player appearance: mode default %s",look==KH_LOOK_AXEL?"Axel":look?"Xion":"Roxas");
    if(kh_look_voice_set(previous)!=kh_look_voice_set(kh_look_enabled())){ KCtx ctx=*g; kh_look_voice_bind(&ctx); }
}

/* The native serializer preserves the twenty-three bits above its portrait and world flag.
 * Save the look independently of the legacy campaign tag (khXb). */
void kh_select_saved_look(KCtx *g,int look){
    u64 word=GS_BASE+0x9a98b0+0x419c;
    u32 marker=0x4c4b0000u | (u32)look<<9;
    wr32(g,word,(rd32(g,word)&511u)|marker);
    int previous=kh_look_enabled();
    kh_look_set(g,look);
    if(kh_look_voice_set(previous)!=kh_look_voice_set(look)){ KCtx ctx=*g; kh_look_voice_bind(&ctx); }
}
void kh_restore_saved_look(KCtx *g){
    u32 word=rd32(g,GS_BASE+0x9a98b0+0x419c);
    if((word&0xfffff000u)!=0x4c4b0000u) return;
    int look=(word>>9)&7;
    if(look>=KH_LOOKS) return;
    if(look && !kh_look_switch_ready(look)){
        kh_warn("save-look: missing pack for %d, showing Roxas",look);
        int previous=kh_look_enabled();
        kh_look_set(g,KH_LOOK_ROXAS);
        if(kh_look_voice_set(previous)){ KCtx ctx=*g; kh_look_voice_bind(&ctx); }
        return;
    }
    kh_select_saved_look(g,look);
    kh_warn("save-look: restored look %d",look);
}

int kh_look_enabled(void){
    if(kh_loading_look>=0) return kh_loading_look;
    int selected=player_look;
    return selected<0?(kh_axel_enabled?KH_LOOK_AXEL:!!kh_xion_enabled):selected; /* older rewind snapshots used -1 */
}
int kh_look_count(void){ return 3+!!kh_look_pack_ready(KH_LOOK_AXEL)+!!kh_look_switch_ready(KH_LOOK_ROXAS_HD); }

static const char *const banks[]={
#include "look_voice.inc"
};
int kh_look_switch_ready(int target){
    char host[4096];
    if(!kh_look_pack_ready(target) || !kh_look_asset(target,KH_SCENE_MDLX,host,sizeof host)) return 0;
    if(target==KH_LOOK_ROXAS_HD){
        static const char *const story[]={"P_EX110","P_EX110_NPC_PAJAMAS","H_EX510","H_EX510_PAJAMAS"};
        for(size_t i=0;i<sizeof story/sizeof *story;i++){
            char path[96]; snprintf(path,sizeof path,"obj/%s.mdlx",story[i]);
            if(!kh_look_asset(target,path,host,sizeof host)) return 0;
        }
        return 1; /* native Roxas voice and shop portraits */
    }
    for(size_t i=0;i<sizeof banks/sizeof *banks;i++)
        if(!kh_look_asset(target,banks[i],host,sizeof host)) return 0;
    return 1;
}
int kh_player_voice(const char *path){
    if(strncasecmp(path,"voice/",6) && strncasecmp(path,"remastered/obj/P_EX1",20)) return 0;
    for(size_t i=0;i<sizeof banks/sizeof *banks;i++) if(!strcasecmp(path,banks[i])) return (int)i+1;
    return 0;
}

/* f_3cde50 keys these slots by character and costume, even across worlds. */
static int voice_slot[4];
static unsigned voice_pending, voice_retired, voice_wait_reported;
static struct { u64 bytes; int size; } voice_data[2][sizeof banks/sizeof *banks];
/* Axel's banks. Kept out of voice_data: that array is a savestate record of a fixed size. */
static struct { u64 bytes; int size; } voice_axel[sizeof banks/sizeof *banks];
void kh_look_voice_request(KCtx *g){
    if(A2(g)!=GS_BASE+0x3cddf0) return;
    unsigned slot=(unsigned)A3(g);
    if(slot>=4) kh_fatal(g,"look-voice-slot: %u",slot);
    voice_pending &= ~(1u<<slot); /* the native request owns this slot again */
    voice_slot[slot]=kh_player_voice(gstr(g,A0(g)));
}
int kh_look_voice_retry(KCtx *g){
    if(!g || !voice_pending) return 0;
    KCtx ctx=*g; g=&ctx;
    for(unsigned slot=0;slot<4;slot++){
        int id=voice_slot[slot];
        unsigned bit=1u<<slot;
        if(!(voice_pending & bit)) continue;
        if(!id || !(rd32(g,GS_BASE+0x2a244a8+12*slot)&1)){voice_pending &= ~bit;continue;}
        const char *key=banks[id-1];
        int selected=kh_look_voice_set(kh_look_enabled());
        u64 *cached_bytes=selected==2?&voice_axel[id-1].bytes:&voice_data[selected][id-1].bytes;
        int *cached_size=selected==2?&voice_axel[id-1].size:&voice_data[selected][id-1].size;
        u64 bytes=*cached_bytes;
        int size=*cached_size;
        if(!bytes){
            u64 path=ga_strdup(key);
            char host[4096];
            if(selected && !kh_look_available(key,host,sizeof host)){ga_free(path);continue;}
            size=(int)kh_call(g,GS_BASE+0x3a09b0,path,0,0,0);
            if(size<80 || !(bytes=ga_alloc(size,16)) ||
               (int)kh_call(g,GS_BASE+0x3f9850,path,bytes,0,0)!=size){
                if(bytes) ga_free(bytes);
                ga_free(path);continue;
            }
            if(memcmp(hp(g,bytes),"SEDBSSCF",8) || rd32(g,bytes+16)!=(u32)size)
                kh_fatal(g,"look-voice-load: %s",key);
            ga_free(path);
            *cached_bytes=bytes;
            *cached_size=size;
        }
        /* f_1dcae0 stops slot voices, then f_1df560 retires the bank.
         * f_136060 frees mode 1 buffers at +0x58. Give each registration
         * its own copy so a retiring voice can never free the cached SCD. */
        if(!(voice_retired & bit)){
            if(getenv("KHNMC_TEST_LOOK_DIGEST")){
                /* Match the live playback records f_1de4a0 stops for this slot. */
                for(u64 v=rd64(g,GS_BASE+0xad93b0);v;v=kh_call(g,GS_BASE+0x4ad270,rd32(g,v+0x20),0,0,0)){
                    if(rd64(g,v+0x18)==slot && rd8(g,v+0x35)==5){
                        kh_warn("look-voice: retiring playing slot %u %s",slot,key);
                        break;
                    }
                }
            }
            kh_call(g,GS_BASE+0x1de4a0,slot,0,0,0);
            kh_call(g,GS_BASE+0x1363b0,slot,0xffffffffu,0,0);
            voice_retired |= bit;
        }
        int handle=0;
        u64 copy=ga_alloc(size,16);
        if(copy){
            memcpy(hp(g,copy),hp(g,bytes),size);
            handle=(int)kh_call5(g,GS_BASE+0x13b2e0,slot,copy,size,0xffffffffu,1);
            if(handle<=0){
                u64 head=rd64(g,GS_BASE+0x713450);
                if(head && rd64(g,head+0x58)==copy)
                    kh_call(g,GS_BASE+0x1363b0,slot,0xffffffffu,0,0);
                else ga_free(copy);
            }
        }
        if(handle<=0){
            if(!(voice_wait_reported & bit)) kh_warn("look-voice: slot %u %s waiting for registration",slot,key);
            voice_wait_reported |= bit;
            continue;
        }
        if(getenv("KHNMC_TEST_LOOK_DIGEST")) fprintf(stderr,"kh: look-bank mode=%d slot=%u key=%s crc=%08lx\n",
                kh_look_enabled(),slot,key,(unsigned long)crc32(0,hp(g,bytes),size));
        voice_pending &= ~bit;
        kh_warn("look-voice: slot %u %s size %d handle %d",slot,key,size,handle);
    }
    return voice_pending!=0;
}
void kh_look_voice_bind(KCtx *g){
    voice_pending=15;
    voice_retired=voice_wait_reported=0;
    kh_look_voice_retry(g);
}

/* Restaged PC fights have their own ARD and mission but omit the arena files. */
static const char *arena_fallback(const char *rel){
    static const char *const arenas[][2]={
        {"map/mu13.map","map/mu09.map"}, {"map/us/mu13.bar","map/us/mu09.bar"},
        {"map/ca26.map","map/hb38.map"}, {"map/us/ca26.bar","map/us/hb38.bar"},
        {"map/nm11.map","map/nm07.map"}, {"map/us/nm11.bar","map/us/nm07.bar"}
    };
    for(size_t i=0;i<sizeof arenas/sizeof arenas[0];i++)
        if(!strcasecmp(rel,arenas[i][0])) return arenas[i][1];
    return NULL;
}
/* Title logos and screens (lane TI).  ids: 1 roxas, 2 xion, 3 xkb, 4 axel (the T80L byte of pack_title_logo.py), 5 the screens
 * layout (pack_title_screens.py). */
static const char *const logo_names[]={"mod","roxas","xion","xkb","axel","screens"};
void kh_title_logo_path(int id,const char *suffix,char *host,size_t cap){
    const char *root=getenv("KHNMC_TITLE_LOGO_DIR");
    const char *data=getenv("KHNMC_DATA");
    const char *slash=(!root && data && access("private/logos",F_OK))?strrchr(data,'/'):NULL;
    int prefix=slash?(int)(slash-data+1):0;
    if(id<0 || id>=(int)(sizeof logo_names/sizeof *logo_names)) kh_fatal(NULL,"title-logo-id: %d",id);
    if(snprintf(host,cap,"%.*s%s/%s.%s",prefix,data?data:"",root?root:"private/logos",logo_names[id],suffix)>=(int)cap)
        kh_fatal(NULL,"title-logo-path: path too long");
}

static const char *const screen_names[KH_TITLE_SCREENS]={"roxas","xion","axel"};
static const int screen_logo[KH_TITLE_SCREENS]={1,2,4};
const char *kh_title_screen_name(int screen){ return screen>=0 && screen<KH_TITLE_SCREENS?screen_names[screen]:"?"; }
/* the picture slot of a screen: Roxas = the tree's own remastered/menu/us/title.2ld/-4.png (the rmc pack's when installed; 0 here),
 * Xion = the Xion pack's (the hooded pack's when only that one is there), Axel = the Axel pack's, same path */
int kh_title_screen_picture(int screen,char *host,size_t cap){
    static const char image[]="remastered/" KH_TITLE_LAYOUT "/-4.png";
    if(screen==KH_TITLE_XION) return kh_look_asset(KH_LOOK_XION,image,host,cap) || kh_look_asset(KH_LOOK_HOODED,image,host,cap);
    if(screen==KH_TITLE_AXEL) return kh_look_asset(KH_LOOK_AXEL,image,host,cap);
    return 0;
}
/* a boot-intro sketch slot (3, 5 or 6) of a screen: like the picture, the same path -N.png in the screen's pack; Roxas = the
 * tree's own (the rmc overlay's when installed; 0 here, and the caller falls back to the tree scan's slot) */
int kh_title_screen_sketch(int screen,int slot,char *host,size_t cap){
    char image[48];
    snprintf(image,sizeof image,"remastered/" KH_TITLE_LAYOUT "/-%d.png",slot);
    if(screen==KH_TITLE_XION) return kh_look_asset(KH_LOOK_XION,image,host,cap) || kh_look_asset(KH_LOOK_HOODED,image,host,cap);
    if(screen==KH_TITLE_AXEL) return kh_look_asset(KH_LOOK_AXEL,image,host,cap);
    return 0;
}
int kh_title_screen_available(int screen){
    if(screen==KH_TITLE_ROXAS) return 1;
    if(screen<0 || screen>=KH_TITLE_SCREENS) return 0;
    int cached=atomic_load(&title_available_cache[screen]);
    if(cached<0){
        char host[4096];
        cached=kh_title_screen_picture(screen,host,sizeof host)?1:0;
        atomic_store(&title_available_cache[screen],cached);
    }
    return cached;
}
int kh_title_screen_step(int screen,int forward){
    if(screen<0 || screen>=KH_TITLE_SCREENS) screen=KH_TITLE_ROXAS;
    for(int i=1;i<=KH_TITLE_SCREENS;i++){
        int s=forward?(screen+i)%KH_TITLE_SCREENS:(screen-i+2*KH_TITLE_SCREENS)%KH_TITLE_SCREENS;
        if(kh_title_screen_available(s)) return s;
    }
    return KH_TITLE_ROXAS;
}
int kh_title_screen_next(int screen){ return kh_title_screen_step(screen,1); }
/* The setting as stored, without the "whose picture is missing" fallback: the settings row moves from this value through the
 * available screens, so a screen whose pack is missing does not pin the cycle to Roxas (review round 9, item 7). */
int kh_title_screen_stored(void){
    const char *v=kh_menu_choice("KHNMC_TITLE_SCREEN");
    int s=KH_TITLE_ROXAS;
    if(v && *v){
        while(s<KH_TITLE_SCREENS && strcmp(v,screen_names[s])) s++;
        if(s==KH_TITLE_SCREENS) s=KH_TITLE_ROXAS;   /* a bad value reads as Roxas, never a fatal (review round 9, item 2) */
    }
    return s;
}
int kh_title_screen(void){
    int s=kh_title_screen_stored();
    if(!kh_title_screen_available(s)){
        static _Atomic int warned;
        if(!warned++) kh_warn("title-screen-pack-missing: KHNMC_TITLE_SCREEN=%s but its picture remastered/%s/-4.png is not in the %s pack: showing ROXAS MAY CRY",
                              screen_names[s],KH_TITLE_LAYOUT,s==KH_TITLE_XION?"Xion":"Axel");
        s=KH_TITLE_ROXAS;
    }
    return s;
}
/* aspect.c f_1948c0 (the screens layout): picture and logo of the screen shown now; 1 roxas, 2 xion, 3 axel logo */
int kh_title_variant(int *picture){
    int s=kh_title_screen();
    *picture=s;
    return 1+s;
}

/* Round 5 (owner 2026-11-22, phone: Load after R3 "starts glitching trying to load the same data"): f_1948c0 above rebinds the drawn
 * picture (slot 4) to slot 12 / 13 and the logo (slot 7) to 14..16.  The native title code needs those textures in the allocation of
 * the slot they stand in for: with a 512x512 32-bit picture (1,048,640 bytes) on screen instead of the native 512x512 8-bit indexed
 * one (263,232 bytes), the next save check of the Load menu reports "No system storage found" and never lists the card (null port,
 * run-R5/p0: raw slot 12 fails on the Xion screen and passes on the Axel screen, raw slot 13 the other way round, the same file
 * padded to 5.4 MB passes).  The 5,415,092-byte screens.2ld of 2026-11-22 00:49 carries such pictures in 12 and 13, so Load failed
 * whenever R3 had left XION or AXEL on screen.  A layout whose slots 12..16 do not match their native slot (byte count and IMGD
 * header) is therefore not used: a named warning, and the per-screen logo layouts below take over (R3 applies at the next load). */
static int screens_entry(int fd,u32 imgz,int slot,u32 *off,u32 *len){
    u8 e[8]; if(pread(fd,e,8,(off_t)imgz+16+8*slot)!=8) return 0;
    memcpy(off,e,4); memcpy(len,e+4,4); return *len>=64;
}
int kh_title_screens_check(const char *host,char *why,size_t cap){
    int fd=open(host,O_RDONLY); if(fd<0){ snprintf(why,cap,"cannot open it (%s)",strerror(errno)); return 0; }
    u8 bar[48],z[16]; int ok=0; u32 imgz=0;
    if(pread(fd,bar,48,0)!=48 || memcmp(bar,"BAR\1",4)) snprintf(why,cap,"not a BAR file");
    else if(memcpy(&imgz,bar+40,4), pread(fd,z,16,imgz)!=16 || memcmp(z,"IMGZ",4)) snprintf(why,cap,"no IMGZ in its second entry");
    else if(z[12]!=KH_TITLE_TEXTURES || z[13]||z[14]||z[15]) snprintf(why,cap,"IMGZ holds %u textures, not %d",(unsigned)z[12]|(unsigned)z[13]<<8,KH_TITLE_TEXTURES);
    else{
        ok=1;
        for(int slot=12;ok && slot<17;slot++){
            int native=slot<14?4:7; u32 so,sl,no,nl; u8 sh[64],nh[64];
            if(!screens_entry(fd,imgz,slot,&so,&sl) || !screens_entry(fd,imgz,native,&no,&nl) ||
               pread(fd,sh,64,(off_t)imgz+so)!=64 || pread(fd,nh,64,(off_t)imgz+no)!=64){ snprintf(why,cap,"texture %d unreadable",slot); ok=0; break; }
            if(sl!=nl || memcmp(sh+8,nh+8,56)){
                u32 spix,npix; memcpy(&spix,sh+12,4); memcpy(&npix,nh+12,4);
                snprintf(why,cap,"slot %d (the %s %s) is %u bytes with %u pixel bytes, its native slot %d is %u bytes with %u",slot,
                         slot<14?"picture of":"logo of",kh_title_screen_name(slot<14?slot-11:slot-14),sl,spix,native,nl,npix);
                ok=0;
            }
        }
    }
    close(fd);
    return ok;
}
static int screens_usable(const char *host){
    static char last[4096]; static struct stat seen; static int verdict;
    struct stat st; if(stat(host,&st)) return 0;
    if(!strcmp(last,host) && st.st_size==seen.st_size && st.st_mtime==seen.st_mtime && st.st_ino==seen.st_ino) return verdict;
    char why[256]; verdict=kh_title_screens_check(host,why,sizeof why);
    if(!verdict) kh_warn("title-screens-layout-unsafe: %s: %s; with that texture on screen the Load menu's save check fails (\"No system storage "
                         "found\"), so this layout is not used: the per-screen logo layouts are (R3 applies at the next title load). Rebuild it with "
                         "tools/pack_title_screens.py (native 8-bit 512x512 pictures)",host,why);
    snprintf(last,sizeof last,"%s",host); seen=st;
    return verdict;
}

/* without the screens layout: the chosen screen's own logo layout, read once per title load */
static int title_logo(int screen){
    int id=screen_logo[screen];
    /* the logo pack is a local, optional add-on: without its files the title keeps the mod's own logo (never a stop) */
    char a[4096],b[4096]; struct stat st;
    kh_title_logo_path(id,"2ld",a,sizeof a); kh_title_logo_path(id,"png",b,sizeof b);
    if(stat(a,&st) || !S_ISREG(st.st_mode) || stat(b,&st) || !S_ISREG(st.st_mode)){
        fprintf(stderr,"kh: title logo: %s / %s not present: the mod's own logo is shown\n",a,b);
        return 0;
    }
    return id;
}

static int loose_path(KCtx *g,const char *path,const char *what,char *host,size_t cap,const char **fallback){
    char rel[2048];
    if(!relative(g,path,rel,sizeof rel)||kh_data_denied(g,rel,what)) return 0;
    if(!strcasecmp(rel,KH_TITLE_LAYOUT)){
        int screen=kh_title_screen();
        char picture[4096];
        if(!kh_title_screen_picture(screen,picture,sizeof picture)) snprintf(picture,sizeof picture,"remastered/%s/-4.png of the tree",KH_TITLE_LAYOUT);
        kh_title_logo_path(5,"2ld",host,cap);
        if(!access(host,R_OK) && screens_usable(host)){
            fprintf(stderr,"kh: title screens: layout %s (all three resident), screen %s, picture %s\n",host,screen_names[screen],picture);
            return KH_FILE_LOOK;
        }
        int logo=title_logo(screen);
        char png[4096]; kh_title_logo_path(logo,"png",png,sizeof png);
        fprintf(stderr,"kh: title screen %s: picture %s, logo %s (next title load after R3)\n",screen_names[screen],picture,logo?png:"the mod's own");
        if(logo){ kh_title_logo_path(logo,"2ld",host,cap); return KH_FILE_LOOK; }
    }
    int profile=kh_look_key(rel);
    if(profile==KH_SCENE_MODEL){
        if(!kh_scene_path(rel,host,cap)) kh_fatal(g,"scene-roxas-asset: overlay disappeared: %s",rel);
        fprintf(stderr,"kh: scene Roxas: event overlay %s %s\n",what,rel);
        return KH_FILE_LOOK;
    }
    if(profile==KH_LOOK_WEAPON){
        if(!kh_axel_weapon_asset(rel,host,cap)) kh_fatal(g,"axel-weapon-asset: missing or invalid weapons/chakram/%s",rel);
        return KH_FILE_LOOK;
    }
    if(profile==KH_LOOK_COMPANION){
        if(!kh_companion_asset(rel,host,cap)) kh_fatal(g,"companion-asset: missing or invalid %s in %s",rel,look_root(KH_LOOK_XION));
        return KH_FILE_LOOK;
    }
    if(profile){ kh_look_path(g,rel,host,cap); return KH_FILE_LOOK; }
    const char *root=getenv("KHNMC_DATA"); if(!root) root="data";
    if(kh_rmc_path(rel,host,cap)) return KH_FILE_RMC;
    if(strlen(root)+strlen(rel)+2>=cap) return 0;
    if(kh_resolve_ci(root,rel,host,cap)) return 1;
    const char *arena=arena_fallback(rel);
    if(!arena || kh_data_denied(g,arena,what)) return 0;
    int source=kh_rmc_path(arena,host,cap);
    if(!source && !kh_resolve_ci(root,arena,host,cap)) return 0;
    if(fallback) *fallback=arena;
    fprintf(stderr,"kh: arena-map-fallback: %s uses %s\n",rel,arena);
    return source?source:1;
}
/* `what` names the kind of request for the deny list: a listed file is answered exactly as an absent one (data_deny.c) */
static FILE *open_loose(KCtx *g,const char *path,int *size,const char *what,const char **fallback){
    char host[4096]; FILE *f=NULL; struct stat st;
    int source=loose_path(g,path,what,host,sizeof host,fallback);
    if(source){
        f=fopen(host,"rb");
        if(f&&(fstat(fileno(f),&st)||!S_ISREG(st.st_mode)||st.st_size>INT_MAX)){ fclose(f); f=NULL; }
        if(!f && source==KH_FILE_RMC) kh_fatal(g,"rmc-open: %s",host);
        if(!f && source==KH_FILE_LOOK) kh_fatal(g,"player-look-open: %s",host);
        if(f) *size=(int)st.st_size;
    }
    return f;
}
/* Preflight uses the same readable, case-insensitive NMC data tree as the loader. */
int kh_cutscene_asset_exists(KCtx *g,const char *path){
    int size=0; FILE *f=open_loose(g,path,&size,"size",NULL);
    if(!f) return 0;
    fclose(f); return size>0;
}
/* For the stream-fd layer (stream_layer.c): the same tree-relative mapping and the same file log as the loaders. */
int kh_file_loose_path(KCtx *g,const char *path,char *host,size_t cap){
    return loose_path(g,path,"stream",host,cap,NULL);
}
void kh_file_log_entry(KCtx *g,const char *path,const char *source,long long size){ if(kh_frame_work && source) kh_file_reads++; file_log(g,path,source,size>INT_MAX?INT_MAX:(int)size); }
int kh_file_package_fallback(const char *path){ return package_fallback(path); }
static int register_resource(KCtx *g,u64 path,int n,u64 dst,const char *fallback){
    /* HD sidecars: the lifted ResourceEntry constructor runs inside SetResourceItem on this thread and pulls GetRemasteredCount/Entry/Asset (hd_assets.c). */
    char rel[2048]; const char *root=getenv("KHNMC_DATA"); if(!root) root="data";
    if(!relative(g,gstr(g,path),rel,sizeof rel)) kh_fatal(g,"hd assets: cannot derive a tree-relative path from %s",gstr(g,path));
    if(fallback) kh_data_deny_remastered(g,fallback);
    kh_data_deny_remastered(g,rel);                    /* a deny list that names textures of this file but not the file: named fatal */
    wr32(g,GS_BASE+0x79cfd4,0);
    HdTable *prev=kh_hd_begin(g,root,fallback?fallback:rel,(const unsigned char*)hp(g,dst),n);
    int ok=(s32)kh_call(g,GS_BASE+0x12f070,path,n,dst,0)!=-1;
    kh_hd_end(prev);
    return ok;
}
void f_1063d0(KCtx *g){
    pthread_mutex_lock(&files_lock);
    int n=0; FILE *f=open_loose(g,gstr(g,A1(g)),&n,"size",NULL);
    if(f){ fclose(f); file_log(g,gstr(g,A1(g)),"LOOSE",n); }
    else if(package_fallback(gstr(g,A1(g)))){
        const char *path=gstr(g,A1(g)); orig_f_1063d0(g);
        n=(s32)KH_RAX(g); file_log(g,path,n>0?"PACKAGE":NULL,n);
        pthread_mutex_unlock(&files_lock); return;
    } else { char host[2048]; struct stat st; kh_winpath(gstr(g,A1(g)),host,sizeof host);
        if(!stat(host,&st)&&S_ISREG(st.st_mode)&&st.st_size<=INT_MAX) n=st.st_size;
        file_log(g,gstr(g,A1(g)),n>0?"LOOSE":NULL,n); }
    pthread_mutex_unlock(&files_lock); SET_RAX(g,n); KH_RET(g);
}
/* Task 31: which loaded files the game still holds.  Every file read with allocation (0x106870: the buffer is the game's to free)
 * and every HD asset handed out by GetRemasteredAsset (0x106460, hd_assets.c: the `file` source of the arena is these two) is noted
 * (buffer, size, path, game frame); the report asks the arena whether that buffer is still the live `file` block of that
 * size (ga_describe) and forgets the notes of buffers that are gone.  Read-only for the game; `kh: file buffers` lines at every
 * map report and at exit (the largest ones by name).  What the id zone's growth through Twilight Town is made of. */
typedef struct { u64 dst, frame; int n; char path[100]; } LiveFile;
static LiveFile *livef; static size_t nlivef, caplivef; static u64 livef_loads, livef_bytes;
/* its own lock, taken last: GetRemasteredAsset runs inside a load that already holds files_lock on the same thread (the first
 * version took files_lock here and both final route runs hung at boot, run-Q31/final-camp-d3: 0 presents, ended by the watchdog) */
static pthread_mutex_t live_lock=PTHREAD_MUTEX_INITIALIZER;
u64 kh_game_frames(void); int ga_describe(u64 a,char *out,size_t cap);
static void live_note(u64 dst,int n,const char *path){
    pthread_mutex_lock(&live_lock);
    size_t i=0; for(;i<nlivef;i++) if(livef[i].dst==dst) break;    /* a buffer handed out again replaces its old note */
    if(i==nlivef){ if(nlivef==caplivef){ size_t nc=caplivef?caplivef*2:256; LiveFile *nl=realloc(livef,nc*sizeof *nl); if(!nl){ pthread_mutex_unlock(&live_lock); return; } livef=nl; caplivef=nc; } nlivef++; }
    size_t l=strlen(path); livef[i].dst=dst; livef[i].n=n; livef[i].frame=kh_game_frames(); snprintf(livef[i].path,sizeof livef[i].path,"%s",l>=sizeof livef[i].path?path+l-(sizeof livef[i].path-1):path);
    livef_loads++; livef_bytes+=(u64)n;
    pthread_mutex_unlock(&live_lock);
}
void kh_file_live_note(u64 dst,u64 n,const char *what){ if(kh_frame_work) kh_file_reads++; live_note(dst,n>INT_MAX?INT_MAX:(int)n,what); }   /* hd_assets.c: the HD asset buffers */
static int live_cmp(const void *a,const void *b){ const LiveFile *x=a,*y=b; return x->n<y->n?1:x->n>y->n?-1:0; }
/* the kind of a held buffer, for the totals: its directory (obj, map, menu, event, effect, ...) and whether it is an HD asset (an HD
 * asset's note is `<archive>#<index>:<name>`, a plain file's note its path) */
static void live_kind(const char *path,char *out,size_t cap){
    const char *s=strchr(path,'/'); size_t l=s?(size_t)(s-path):0; if(l==0||l>12){ snprintf(out,cap,"other"); }
    else snprintf(out,cap,"%.*s",(int)l,path);
    if(cap>8 && strlen(out)+3<cap) strcat(out,strchr(path,'#')?"/hd":"/sd");
}
/* top > 0: the `top` largest buffers by name; top < 0: every held buffer (KHNMC_IDTABLE_REPORT at exit) */
void kh_file_live_report(FILE *f,int top){
    pthread_mutex_lock(&live_lock);
    size_t k=0; u64 bytes=0;
    for(size_t i=0;i<nlivef;i++){ char d[240], want[80]; ga_describe(livef[i].dst,d,sizeof d);
        snprintf(want,sizeof want,"file block 0x%llx (%llu bytes) +0x0",(unsigned long long)livef[i].dst,(unsigned long long)(u64)livef[i].n);
        if(strstr(d,want) && !strstr(d,"FREED")){ bytes+=(u64)livef[i].n; livef[k++]=livef[i]; } }
    nlivef=k;
    /* task 31: the held bytes by kind (at most 16 kinds; more go to "other/*") */
    char kinds[16][24]; u64 kb[16]={0}; int kn=0, nk=0;
    for(size_t i=0;i<k;i++){ char kd[24]; live_kind(livef[i].path,kd,sizeof kd); int j=0; for(;j<nk;j++) if(!strcmp(kinds[j],kd)) break;
        if(j==nk){ if(nk<16){ snprintf(kinds[nk],sizeof kinds[nk],"%s",kd); nk++; } else { j=15; snprintf(kinds[15],sizeof kinds[15],"other/*"); } }
        kb[j]+=(u64)livef[i].n; }
    char by[600]; size_t bo=0; by[0]=0;
    for(int j=0;j<nk && bo<sizeof by;j++){ bo+=(size_t)snprintf(by+bo,sizeof by-bo,"%s%s %.1f",kn++?", ":"",kinds[j],(double)kb[j]/1048576.0); }
    fprintf(f,"kh: file buffers: %zu of the %llu file and HD-asset buffers handed to the game are still held by it: %llu MiB of %llu MiB handed out (MiB by kind: %s)\n",
            k,(unsigned long long)livef_loads,(unsigned long long)(bytes>>20),(unsigned long long)(livef_bytes>>20),nk?by:"none");
    if(top!=0 && k){ LiveFile *c=malloc(k*sizeof *c); if(c){ memcpy(c,livef,k*sizeof *c); qsort(c,k,sizeof *c,live_cmp);
        for(size_t i=0;i<k && (top<0 || (int)i<top);i++) fprintf(f,"kh: file buffers:   %8.1f MiB held since game frame %llu  %s\n",(double)c[i].n/1048576.0,(unsigned long long)c[i].frame,c[i].path);
        free(c); } }
    pthread_mutex_unlock(&live_lock);
}
static void load(KCtx *g,int bounded,int allocate){
    u64 path=A1(g),dst=A2(g),sizeptr=A2(g); int hd=bounded?A4(g):A3(g);
    s32 oldsize=allocate?(s32)rd32(g,sizeptr):0;
    pthread_mutex_lock(&files_lock);
    const char *fallback=NULL;
    int n=0; FILE *f=open_loose(g,gstr(g,path),&n,"load",&fallback); s64 result=allocate||bounded?0:-1;
    if(!f){
        if(package_fallback(gstr(g,path))){
            if(allocate) orig_f_106870(g); else if(bounded) orig_f_106790(g); else orig_f_106700(g);
            int size=allocate?(s32)rd32(g,sizeptr):(s32)KH_RAX(g);
            int hit=allocate?(KH_RAX(g)!=0||(oldsize==-1&&size>=0)):(size>0);
            u64 data=allocate?KH_RAX(g):dst;
            if(kh_frame_work && hit && data && size>0) kh_file_reads++;
            if(hit && data && size>0) kh_look_font_loaded(gstr(g,path),hp(g,data),size);
            file_log(g,gstr(g,path),hit?"PACKAGE":NULL,size);
            pthread_mutex_unlock(&files_lock); return;
        }
        file_log(g,gstr(g,path),NULL,0); goto done;
    }
    if(bounded&&(s32)A3(g)<n){ result=-6; goto close; }
    if(allocate){ s32 old=rd32(g,sizeptr); wr32(g,sizeptr,n); if(old==-1) goto close;
        dst=ga_alloc_src(n,16,GA_SRC_FILE); if(!dst){ wr32(g,sizeptr,-2); goto close; } }
    if(fread(hp(g,dst),1,n,f)!=(size_t)n){
        if(allocate){ ga_free(dst); wr32(g,sizeptr,-2); } else result=-2;
        goto close;
    }
    if(kh_frame_work) kh_file_reads++;
    kh_look_font_loaded(gstr(g,path),hp(g,dst),n);
    result=allocate?dst:n;
    if(allocate) live_note(dst,n,gstr(g,path));
    if(hd&&n&&!register_resource(g,path,n,dst,fallback)){ if(allocate) ga_free(dst); result=0; }
close:
    fclose(f);
    file_log(g,gstr(g,path),"LOOSE",n);
done:
    pthread_mutex_unlock(&files_lock); SET_RAX(g,allocate?result:(u32)result); KH_RET(g);
}
void f_106700(KCtx *g){ load(g,0,0); }
void f_106790(KCtx *g){ load(g,1,0); }
void f_106870(KCtx *g){ load(g,0,1); }

/* Fixtures are synthetic and local; this also exercises hooks through the dispatch table. */
int kh_file_selftest(KCtx *g){
    char dir[KH_TMP_MAX],path[KH_TMP_MAX+256]; int bad=0,checks=0; kh_tmp_path(dir,sizeof dir,"khnmc-files-XXXXXX");   /* host_env.c: /tmp, or the app container on iOS */
    const char *oldroot=getenv("KHNMC_DATA"),*oldlog=getenv("KHNMC_FILELOG");
    char *root=oldroot?strdup(oldroot):NULL,*log=oldlog?strdup(oldlog):NULL;
    if(!mkdtemp(dir)) return 1;
    snprintf(path,sizeof path,"%s/MiXeD.bin",dir); FILE *f=fopen(path,"wb");
    if(!f) return 1; fwrite("test",1,4,f); fclose(f);
    setenv("KHNMC_DATA",dir,1); char lp[KH_TMP_MAX+256]; snprintf(lp,sizeof lp,"%s/log",dir); setenv("KHNMC_FILELOG",lp,1);
    u64 name=ga_strdup("mixed.bin"),missing=ga_strdup("missing"),dst=ga_alloc(16,16),sz=ga_alloc(16,16);
#define TEST(c) do { checks++; if(!(c)){ fprintf(stderr,"file selftest FAIL: %s\n",#c); bad++; } } while(0)
    const char *policy=getenv("KHNMC_LOOK_NAMES");
    char *saved_policy=policy?strdup(policy):NULL;
    setenv("KHNMC_LOOK_NAMES","all",1);
    int initial_look=player_look;
    kh_look_set(g,1);
    /* Exercise the native handle-zero branch past the old 600-frame cutoff. */
    u64 service=GS_BASE+0x8bbd08,active=GS_BASE+0x2a244a8;
    u64 saved_service=rd64(g,service);
    u32 saved_active=rd32(g,active);
    u64 scd=ga_calloc(1,80);
    memcpy(hp(g,scd),"SEDBSSCF",8); wr32(g,scd+16,80);
    wr64(g,service,0); wr32(g,active,1);
    voice_slot[0]=1;
    voice_data[1][0].bytes=scd; voice_data[1][0].size=80;
    kh_look_voice_bind(g);
    for(int i=0;i<650;i++) kh_look_voice_retry(g);
    TEST(voice_pending==1 && voice_retired==1);
    wr32(g,active,0);
    TEST(!kh_look_voice_retry(g));
    wr32(g,active,saved_active); wr64(g,service,saved_service);
    voice_slot[0]=0; voice_data[1][0].bytes=0; voice_data[1][0].size=0;
    voice_retired=voice_wait_reported=0;
    ga_free(scd);
    /* face slot 45 (round 2; 39 before); a Xion pack of before round 2 with its sheet at -39 only: the stock HD table */
    int wi_kh1f=kh_look_key("obj/P_EX100_WI_KH1F.a.us");
    TEST(kh_look_key("./OBJ//p_ex100.MDLX")==-1 && (wi_kh1f==46 || wi_kh1f==KH_LOOK_STOCK_HD));
    TEST(kh_look_key("remastered/obj/P_EX100.a.us/-36.dds")==37 && !kh_look_key("remastered/obj/P_EX100.a.us/-37.dds"));
    TEST(kh_look_key("voice/us/battle/TT0_ROXAS.win32.scd")==-1);
    TEST(kh_look_key("remastered/obj/P_EX100_ULTF.a.us/voice/battle/us/awakened")==-1);
    TEST(!kh_look_key("remastered/obj/P_EX220.a.us/voice/battle/us/xion"));
    TEST(!kh_look_key("obj/P_EX100.mset") && !kh_look_key("obj/P_EX1000.mdlx"));
    u64 label=ga_strdup("@KHINPUT(slash,data/msg/us/he.bar,15561,5,6371a57675507ca2b56b55306572693e0b838cda8d98eeecb9ec54a9dd62947b)@");
    TEST(label && !memcmp(hp(g,kh_look_name(g,0x851f,label)),"@KHINPUT(slash,data/msg/us/po.bar,13217,4,3841ba554755fe34fbbe96d4378902dcb824fa5bb69ca360c5ceb31d86e155f6)@",5));
    TEST(!memcmp(hp(g,kh_look_name(g,0x4023,label)),xion,5));
    TEST(kh_look_name(g,0xc91a,label)==label && kh_look_name(g,0x4f43,label)==label);
    u64 speaker=ga_alloc(16,16);
    memcpy(hp(g,speaker),"@KHINPUT(slash,data/msg/us/he.bar,15561,5,6371a57675507ca2b56b55306572693e0b838cda8d98eeecb9ec54a9dd62947b)@\x52\x01\x07\x00\x44\x00\x00\x48",14);
    u64 line=kh_look_name(g,0x27a,speaker);
    TEST(line!=speaker && !memcmp(hp(g,line+4),hp(g,speaker+5),9));
    TEST(kh_look_name(g,0x27a,speaker)==line); ga_free(speaker);
    u64 journal=ga_strdup("@KHINPUT(slash,data/msg/us/sys.bar,96456,12,d13da141f68b0178c5342434dea058ee95c59dfae40d8768ba1ab211596486ac)@");
    u64 heading=kh_look_name(g,0x453a,journal);
    TEST(heading!=journal && !memcmp(hp(g,heading+5),xion,4) && rd8(g,heading+9)==0xec);
    u64 cached=kh_look_name(g,0x51f,label);
    for(int i=0;i<8;i++){
        kh_look_set(g,i&1);
        TEST(!strcmp(gstr(g,cached),(i&1)?xion:roxas));
        TEST(kh_look_name(g,0x51f,label)==cached);
    }
    setenv("KHNMC_LOOK_NAMES","menus",1);
    TEST(kh_look_name(g,0x4023,label)==label);
    setenv("KHNMC_LOOK_NAMES","all",1);
    u64 repeated=ga_alloc(32,16);
    u8 *r=hp(g,repeated);
    memcpy(r,roxas,5); r[5]=7; memcpy(r+6,roxas,5);
    memcpy(r+11,roxas,5); r[16]=0xec; r[17]=0xac; r[18]=0x4f; r[19]=0;
    u64 display=kh_look_name(g,104,repeated);
    TEST(!memcmp(hp(g,display),xion,4) && !memcmp(hp(g,display+4),r+5,6) &&
         !memcmp(hp(g,display+10),xion,4) && !memcmp(hp(g,display+14),r+16,4));
    kh_look_set(g,0);
    TEST(!memcmp(hp(g,display),r,20));
    ga_free(repeated);
    if(saved_policy){setenv("KHNMC_LOOK_NAMES",saved_policy,1); free(saved_policy);}
    else unsetenv("KHNMC_LOOK_NAMES");
    kh_xkb_set_mode(g,1);
    /* round 9 item 0: a story rig follows the look in the Xion mode only with KHNMC_SCENE_LOOK=1 (before: always -1 here) */
    TEST(!strcmp(gstr(g,cached),xion) && (kh_look_key("obj/H_EX510_PAJAMAS.mdlx")==-1)==kh_scene_look());
    kh_look_set(g,0);
    TEST(kh_xion_enabled && !kh_look_enabled() && !strcmp(gstr(g,cached),roxas));
    kh_xkb_set_mode(g,1); /* a second load of the same mode also resets its appearance */
    TEST(kh_xion_enabled && kh_look_enabled()==1);
    kh_xkb_set_mode(g,0);
    kh_look_set(g,2);
    kh_xkb_set_mode(g,0);
    TEST(!kh_xion_enabled && !kh_look_enabled());
    TEST(!strcmp(gstr(g,cached),roxas) && !kh_look_key("obj/H_EX510_PAJAMAS.mdlx"));
    ga_free(label); ga_free(journal);
    {   /* lane TI: the title screens' names, logo ids and files (no counters any more: the choice is KHNMC_TITLE_SCREEN) */
        char path[4096];
        kh_title_logo_path(4,"2ld",path,sizeof path); size_t n=strlen(path);
        TEST(n>9 && !strcmp(path+n-9,"/axel.2ld"));
        kh_title_logo_path(5,"2ld",path,sizeof path); n=strlen(path);
        TEST(n>12 && !strcmp(path+n-12,"/screens.2ld"));
        TEST(!strcmp(kh_title_screen_name(0),"roxas") && !strcmp(kh_title_screen_name(1),"xion") && !strcmp(kh_title_screen_name(2),"axel"));
        TEST(screen_logo[KH_TITLE_ROXAS]==1 && screen_logo[KH_TITLE_XION]==2 && screen_logo[KH_TITLE_AXEL]==4 && !strcmp(logo_names[4],"axel"));
        TEST(kh_title_screen_available(KH_TITLE_ROXAS) && !kh_title_screen_available(KH_TITLE_SCREENS) && !kh_title_screen_available(-1));
        /* Round 5: the screens layout check (KH_TITLE_TEXTURES IMGD textures; 12/13 must match slot 4, 14..16 slot 7, by byte count
         * and header).  Round TI: 26 textures now (9 boot-sketch slots follow 17). */
        static u8 sl[16+48+16+8*KH_TITLE_TEXTURES+KH_TITLE_TEXTURES*320+4];
        size_t total=0;
        for(int pass=0;pass<4;pass++){
            memset(sl,0,sizeof sl); memcpy(sl,"BAR\1",4); u32 imgz=64; memcpy(sl+40,&imgz,4);
            u8 *z=sl+imgz; memcpy(z,"IMGZ",4); z[12]=KH_TITLE_TEXTURES;
            u32 at=16+8*KH_TITLE_TEXTURES;
            for(int t=0;t<KH_TITLE_TEXTURES;t++){
                u32 len=256+((t==4||t==12||t==13)?32:0)+((pass==1 && t==12)?64:0);   /* pass 1: a bigger picture in 12 */
                memcpy(z+16+8*t,&at,4); memcpy(z+20+8*t,&len,4);
                memcpy(z+at,"IMGD",4); u32 pix=len-64; memcpy(z+at+12,&pix,4);
                z[at+0x30]=(t==4||t==12||t==13)?5:3;
                if(pass==2 && t==15) z[at+0x30]=4;                                    /* pass 2: a logo of another format */
                at+=len;
            }
            memcpy(z+at,"T90L",4); total=imgz+at+4;
            if(pass==3) z[12]=16;                                                      /* pass 3: 16 textures */
            snprintf(path,sizeof path,"%s/screens.2ld",dir); f=fopen(path,"wb"); TEST(f && fwrite(sl,1,total,f)==total); if(f) fclose(f);
            char why[256]; why[0]=0; int good=kh_title_screens_check(path,why,sizeof why);
            if(pass==0) TEST(good);
            if(pass==1) TEST(!good && strstr(why,"slot 12 (the picture of xion) is 352 bytes") && strstr(why,"native slot 4 is 288 bytes"));
            if(pass==2) TEST(!good && strstr(why,"slot 15 (the logo of xion)"));
            if(pass==3) TEST(!good && strstr(why,"16 textures"));
        }
        char why[256]; snprintf(path,sizeof path,"%s/no-such.2ld",dir); TEST(!kh_title_screens_check(path,why,sizeof why));
    }
    TEST(!kh_look_key("obj/P_EX100.mdlx"));
    const char *pack_env=getenv("KHNMC_SCENE_ROXAS_DIR");
    char *initial_pack=pack_env?strdup(pack_env):NULL;
    char pack[KH_TMP_MAX+256],member[KH_TMP_MAX+512],resolved[4096];
    snprintf(pack,sizeof pack,"%s/scene",dir);
    setenv("KHNMC_SCENE_ROXAS_DIR",pack,1);
    const char *dirs[]={"","/obj","/remastered","/remastered/obj","/remastered/" KH_SCENE_MDLX};
    for(size_t i=0;i<sizeof dirs/sizeof *dirs;i++){
        snprintf(member,sizeof member,"%s%s",pack,dirs[i]); TEST(mkdir(member,0700)==0);
    }
    for(size_t i=0;i<sizeof scene_files/sizeof *scene_files;i++){
        snprintf(member,sizeof member,"%s/%s",pack,scene_files[i]);
        if(i==KH_SCENE_TEXTURES){  /* model and first two textures already present */
            kh_scene_pack_begin(); TEST(!kh_look_key(KH_SCENE_MDLX));
        }
        FILE *part=fopen(member,"wb"); TEST(part!=NULL);
        if(part){ fputc('x',part); fclose(part); }
    }
    kh_rmc_init(pack);
    TEST(kh_file_loose_path(g,KH_SCENE_MDLX,resolved,sizeof resolved)==KH_FILE_RMC);
    TEST(!kh_look_key(KH_SCENE_MDLX)); /* keep the decision for the whole event */
    kh_scene_pack_end(); kh_scene_pack_begin();
    TEST(kh_file_loose_path(g,KH_SCENE_MDLX,resolved,sizeof resolved)==KH_FILE_LOOK);
    TEST(kh_file_loose_path(g,scene_files[3],resolved,sizeof resolved)==KH_FILE_LOOK && !strcmp(resolved,member));
    TEST(kh_look_key("./OBJ//h_ex500.MDLX")==KH_SCENE_MODEL);
    TEST(kh_look_key("remastered/obj/H_EX500.mdlx/-2.dds")==KH_SCENE_MODEL);
    TEST(!kh_look_key("remastered/obj/H_EX500.mdlx/-3.dds") && !kh_look_key("obj/H_EX500.mset"));
    kh_rmc_init(NULL);
    u32 event_state=rd32(g,GS_BASE+0xb65210);
    wr32(g,GS_BASE+0xb65210,4); /* the guest's already-ended case has no other side effects */
    kh_call(g,GS_BASE+0x2cbd80,0,0,0,0);
    wr32(g,GS_BASE+0xb65210,event_state);
    TEST(!kh_look_key(KH_SCENE_MDLX) && !kh_file_loose_path(g,KH_SCENE_MDLX,resolved,sizeof resolved));
    const char *look_env=getenv("KHNMC_LOOK_DIR");
    char *initial_dir=look_env?strdup(look_env):NULL;
    const char *sl_env=getenv("KHNMC_SCENE_LOOK");
    char *initial_sl=sl_env?strdup(sl_env):NULL;
    setenv("KHNMC_LOOK_DIR",pack,1);
    kh_look_set(g,1);
    /* lane scene-off: an ordinary campaign (mode 0) with a look on.  KHNMC_SCENE_LOOK=0 (the default) keeps the story scenes on
     * Roxas; =1 restores the CSI behaviour (the gates follow the look).  The campaign modes: the round-9 block below. */
    for(int scene_look=0;scene_look<=1;scene_look++){
        char sl[2]; snprintf(sl,sizeof sl,"%d",scene_look); setenv("KHNMC_SCENE_LOOK",sl,1);
        TEST(!kh_xion_enabled && !kh_axel_enabled && kh_event_high_scene(g)==scene_look);
        TEST((kh_look_key("obj/H_EX510.mdlx")==-1)==scene_look &&
             (kh_look_key("obj/P_EX110.mdlx")==-1)==scene_look &&
             (kh_look_key("obj/P_EX110_NPC_PAJAMAS.mdlx")==-1)==scene_look);
        TEST(!kh_look_key("obj/H_EX500_BTLF.mdlx"));        /* outside an event a Drive form's high model stays stock */
        kh_scene_pack_begin();
        TEST(kh_look_key(KH_SCENE_MDLX)==(scene_look?-1:KH_SCENE_MODEL));
        TEST(kh_look_key(scene_files[3])==(scene_look?0:KH_SCENE_MODEL));
        TEST(kh_file_loose_path(g,KH_SCENE_MDLX,resolved,sizeof resolved)==KH_FILE_LOOK);
        {   /* lane CSI: Drive forms of high Sora inside the event = the look's H_EX500 (model and HD leaves) with the setting */
            char high[4096],leaf[4096];
            TEST(kh_look_asset(1,KH_SCENE_MDLX,high,sizeof high) && kh_look_asset(1,scene_files[3],leaf,sizeof leaf));
            TEST((kh_look_key("obj/H_EX500_BTLF.mdlx")==-1)==scene_look &&
                 (kh_look_key("obj/H_EX500_MAGF.mdlx")==-1)==scene_look &&
                 (kh_look_key("obj/H_EX500_KH1F.mdlx")==-1)==scene_look &&
                 (kh_look_key("obj/H_EX500_TRIF.mdlx")==-1)==scene_look &&
                 (kh_look_key("obj/H_EX500_ULTF.mdlx")==-1)==scene_look);
            TEST(!kh_look_key("obj/H_EX500_NM.mdlx") && !kh_look_key("obj/H_EX500_NM_BTLF.mdlx") && !kh_look_key("obj/H_EX500_BTLF.mset") &&
                 !kh_look_key("remastered/obj/H_EX500_BTLF.mdlx/-0.dds"));
            if(scene_look) TEST(kh_file_loose_path(g,"obj/H_EX500_ULTF.mdlx",resolved,sizeof resolved)==KH_FILE_LOOK && !strcmp(resolved,high));
            TEST(kh_look_asset(1,"remastered/obj/H_EX500_MAGF.mdlx/-2.dds",resolved,sizeof resolved) && !strcmp(resolved,leaf));
            TEST(!kh_scene_form_alias("obj/H_EX500_BTLF.mdlx.bak",NULL,0) && !kh_scene_form_alias("remastered/obj/H_EX500_BTLF.mdlx/",NULL,0) &&
                 !kh_scene_form_alias("remastered/obj/H_EX500_BTLF.mdlx/a/-0.dds",NULL,0) && !kh_scene_form_alias("obj/H_EX500.mdlx",NULL,0));
        }
        kh_scene_pack_end();
        TEST(!kh_look_key("obj/H_EX500_BTLF.mdlx"));
        kh_look_set(g,0);
        TEST(!kh_look_key("obj/H_EX510.mdlx"));
        if(!getenv("KHNMC_SCENE_ROXAS")) TEST(!kh_event_high_scene(g));
        kh_look_set(g,1);
    }
    {   /* Round 9 item 0: the campaign modes (Xion Always Cries / Xion Knows Best = kh_xion_enabled, Axel Won't Cry = kh_axel_enabled)
         * take the same gate as an ordinary campaign: KHNMC_SCENE_LOOK=0 keeps the story rigs on Roxas and high Sora on the scene-roxas
         * overlay, =1 lets them wear the look (Xion here, and the Axel look for high Sora).  Unchanged: the overlay's own gate (the
         * modes), the field look (P_EX100).  Before round 9 the modes followed with 0 as well: every "==scene_look" story / Drive-form
         * check and the KH_SCENE_MODEL checks failed for 0, and with no overlay installed the event opened on the look's H_EX500 and
         * served the overlay key (kh_file_loose_path: scene-roxas-asset fatal). */
        int prior_xion=kh_xion_enabled,prior_axel=kh_axel_enabled;
        const char *axel_env=getenv("KHNMC_LOOK_AXEL_DIR");
        char *initial_axel=axel_env?strdup(axel_env):NULL;
        static const char *const story[]={"obj/H_EX510.mdlx","obj/H_EX510_PAJAMAS.mdlx","obj/P_EX110.mdlx","obj/P_EX110_NPC_PAJAMAS.mdlx"};
        char nopack[KH_TMP_MAX+64]; snprintf(nopack,sizeof nopack,"%s/no-scene-pack",dir);
        setenv("KHNMC_LOOK_AXEL_DIR",pack,1);
        for(int mode=1;mode<=2;mode++) for(int look=1;look<=KH_LOOK_AXEL;look+=KH_LOOK_AXEL-1){
            kh_xion_enabled=mode==1; kh_axel_enabled=mode==2;
            kh_look_set(g,look);
            for(int scene_look=0;scene_look<=1;scene_look++){
                char sl[2]; snprintf(sl,sizeof sl,"%d",scene_look); setenv("KHNMC_SCENE_LOOK",sl,1);
                TEST(kh_scene_wear()==(scene_look?look:0));
                TEST(kh_event_high_scene(g)==1);                                  /* the overlay's gate: the modes, unchanged */
                TEST(kh_look_key("obj/P_EX100.mdlx")==-1);                        /* the field look, unchanged */
                if(look==1) for(size_t i=0;i<sizeof story/sizeof *story;i++) TEST((kh_look_key(story[i])==-1)==scene_look);
                kh_scene_pack_begin();
                TEST(kh_scene_pack_active());
                TEST(kh_look_key(KH_SCENE_MDLX)==(scene_look?-1:KH_SCENE_MODEL));
                TEST(kh_look_key(scene_files[3])==(scene_look?0:KH_SCENE_MODEL));
                TEST((kh_look_key("obj/H_EX500_BTLF.mdlx")==-1)==scene_look && (kh_look_key("obj/H_EX500_ULTF.mdlx")==-1)==scene_look);
                if(!scene_look) TEST(kh_file_loose_path(g,KH_SCENE_MDLX,resolved,sizeof resolved)==KH_FILE_LOOK && !strcmp(resolved+strlen(pack),"/" KH_SCENE_MDLX));
                kh_scene_pack_end();
                setenv("KHNMC_SCENE_ROXAS_DIR",nopack,1);                         /* no overlay installed, the look's H_EX500 present */
                kh_scene_pack_begin();
                TEST(kh_scene_pack_active()==scene_look && kh_look_key(KH_SCENE_MDLX)==(scene_look?-1:0));
                kh_scene_pack_end();
                setenv("KHNMC_SCENE_ROXAS_DIR",pack,1);
            }
        }
        kh_xion_enabled=prior_xion; kh_axel_enabled=prior_axel;
        kh_look_set(g,1);
        if(initial_axel) setenv("KHNMC_LOOK_AXEL_DIR",initial_axel,1); else unsetenv("KHNMC_LOOK_AXEL_DIR");
        free(initial_axel);
    }
    if(initial_sl) setenv("KHNMC_SCENE_LOOK",initial_sl,1); else unsetenv("KHNMC_SCENE_LOOK");
    free(initial_sl);
    {   /* lane HM: the Holo-Mission companion takes the Xion pack's body with any look (here Roxas, then hooded), model + sheet -0 */
        char body[KH_TMP_MAX+512],hdir[KH_TMP_MAX+512],sheet[KH_TMP_MAX+512]; int costume=-1;
        snprintf(body,sizeof body,"%s/obj/N_PO010_BTL.mdlx",pack);
        snprintf(hdir,sizeof hdir,"%s/remastered/obj/N_PO010_BTL.mdlx",pack);
        snprintf(sheet,sizeof sheet,"%s/-0.dds",hdir);
        FILE *part=fopen(body,"wb"); TEST(part!=NULL); if(part){ fputc('x',part); fclose(part); }
        TEST(!kh_look_key("obj/N_PO010_BTL.mdlx"));                  /* no HD sheet: NMC's own companion */
        TEST(mkdir(hdir,0700)==0);
        part=fopen(sheet,"wb"); TEST(part!=NULL); if(part){ fputc('x',part); fclose(part); }
        TEST(kh_look_key("obj/N_PO010_BTL.mdlx")==KH_LOOK_COMPANION && kh_look_key("./OBJ//n_po010_btl.MDLX")==KH_LOOK_COMPANION);
        TEST(kh_file_loose_path(g,"obj/N_PO010_BTL.mdlx",resolved,sizeof resolved)==KH_FILE_LOOK && !strcmp(resolved,body));
        TEST(kh_hd_look_probe("obj/N_PO010_BTL.mdlx",&costume)==KH_LOOK_COMPANION && costume==0);
        TEST(kh_companion_asset("remastered/obj/N_PO010_BTL.mdlx/-0.dds",resolved,sizeof resolved) && !strcmp(resolved,sheet));
        TEST(!kh_look_key("remastered/obj/N_PO010_BTL.mdlx/-0.dds") && !kh_look_key("obj/N_PO010_BTL.mset") &&
             !kh_look_key("obj/N_PO010_BTL.a.us") && !kh_look_key("obj/N_PO010_SIT_RTN.mdlx") && !kh_look_key("obj/N_PO010_RTN.mdlx"));
        TEST(!kh_companion_asset("remastered/obj/N_PO010_BTL.mdlx/a/-0.dds",NULL,0) && !kh_companion_asset("remastered/obj/N_PO010_BTL.mdlx/",NULL,0) &&
             !kh_companion_asset("obj/N_PO010_BTL.mdlx.bak",NULL,0) && !kh_companion_asset("obj/P_EX220.mdlx",NULL,0));
        kh_look_set(g,KH_LOOK_HOODED);
        TEST(kh_look_key("obj/N_PO010_BTL.mdlx")==KH_LOOK_COMPANION);
        kh_look_set(g,0);
        unlink(sheet); rmdir(hdir);
        TEST(!kh_look_key("obj/N_PO010_BTL.mdlx"));
        unlink(body);
    }
    if(initial_dir) setenv("KHNMC_LOOK_DIR",initial_dir,1); else unsetenv("KHNMC_LOOK_DIR");
    free(initial_dir);
    kh_look_set(g,initial_look);
    for(size_t i=0;i<sizeof scene_files/sizeof *scene_files;i++){
        snprintf(member,sizeof member,"%s/%s",pack,scene_files[i]); unlink(member);
    }
    for(size_t i=sizeof dirs/sizeof *dirs;i>0;i--){
        snprintf(member,sizeof member,"%s%s",pack,dirs[i-1]); rmdir(member);
    }
    if(initial_pack) setenv("KHNMC_SCENE_ROXAS_DIR",initial_pack,1); else unsetenv("KHNMC_SCENE_ROXAS_DIR");
    free(initial_pack);
    TEST(kh_call(g,GS_BASE+0x1063d0,0,name,0,0)==4);
    {
        char overlay[KH_TMP_MAX+32],file[KH_TMP_MAX+64];
        snprintf(overlay,sizeof overlay,"%s/rmc",dir);
        kh_rmc_init(overlay);
        TEST(kh_call(g,GS_BASE+0x106700,0,name,dst,0)==4 && !memcmp(hp(g,dst),"test",4));
        TEST(mkdir(overlay,0700)==0);
        snprintf(file,sizeof file,"%s/MIXED.bin",overlay);
        FILE *af=fopen(file,"wb"); TEST(af!=NULL);
        if(af){ fputs("patch",af); fclose(af); }
        snprintf(file,sizeof file,"%s/stale",overlay); af=fopen(file,"wb"); TEST(af!=NULL); if(af) fclose(af);
        snprintf(file,sizeof file,"%s/rmc-pack.pending",dir);
        af=fopen(file,"wb"); TEST(af!=NULL);
        if(af){ fwrite("mixed.bin\0/\0",1,12,af); fclose(af); }
        TEST(kh_rmc_sync(dir,overlay)==1 && !kh_rmc_find("stale"));
        snprintf(file,sizeof file,"%s/stale",overlay); TEST(access(file,F_OK)!=0);
        u64 key=ga_strdup(".\\MiXeD.BIN");
        TEST(kh_call(g,GS_BASE+0x106700,0,key,dst,0)==5 && !memcmp(hp(g,dst),"patch",5));
        ga_free(key); kh_rmc_init(NULL);
        snprintf(file,sizeof file,"%s/MIXED.bin",overlay); unlink(file); rmdir(overlay);
    }
    char prefixed[2048]; snprintf(prefixed,sizeof prefixed,"%s\\.\\MIXED.BIN",gstr(g,GS_BASE+0x2bd4340));
    u64 windows=ga_strdup(prefixed); TEST(kh_call(g,GS_BASE+0x1063d0,0,windows,0,0)==4); ga_free(windows);
    u64 parent=ga_strdup("../MiXeD.bin"); TEST((s32)kh_call(g,GS_BASE+0x106700,0,parent,dst,0)==-1); ga_free(parent);
    wr32(g,sz,123); TEST(kh_call5(g,GS_BASE+0x106870,0,missing,sz,0,0)==0&&rd32(g,sz)==123);
    TEST((s32)kh_call(g,GS_BASE+0x106700,0,missing,dst,0)==-1);
    TEST(kh_call5(g,GS_BASE+0x106790,0,missing,dst,0,0)==0);
    TEST((s32)kh_call5(g,GS_BASE+0x106790,0,name,dst,3,0)==-6);
    TEST(kh_call(g,GS_BASE+0x106700,0,name,dst,0)==4&&!memcmp(hp(g,dst),"test",4));
    TEST(kh_call5(g,GS_BASE+0x106790,0,name,dst,4,0)==4);
    wr32(g,sz,-1); TEST(kh_call5(g,GS_BASE+0x106870,0,name,sz,0,0)==0&&rd32(g,sz)==4);
    wr32(g,sz,0); u64 p=kh_call5(g,GS_BASE+0x106870,0,name,sz,0,0); TEST(p&&!(p&15)&&rd32(g,sz)==4&&!memcmp(hp(g,p),"test",4)); ga_free(p);
    u64 obj=ga_alloc(0x260,16); TEST(kh_call(g,GS_BASE+0x106000,obj,name,0,0)==obj&&rd64(g,obj+8)&&rd32(g,obj+0x14)==0); ga_free(rd64(g,obj+8)); ga_free(obj);
    const char *oldpkg=getenv("KHNMC_PKGDIR"); char *pkg=oldpkg?strdup(oldpkg):NULL;
    char image[KH_TMP_MAX+256],mapped[2048],expected[KH_TMP_MAX+256];
    snprintf(image,sizeof image,"%s/Image",dir); mkdir(image,0700);
    snprintf(expected,sizeof expected,"%s/Image/SettingMenu.hed",dir);
    f=fopen(expected,"wb"); if(!f) return 1; fclose(f);
    setenv("KHNMC_PKGDIR",dir,1);
    TEST(kh_winpath("C:\\hd28\\STEAM\\Image\\settingmenu.HED",mapped,sizeof mapped)&&!strcmp(mapped,expected));
    TEST(kh_winpath("C:\\KH2\\image/SettingMenu.hed",mapped,sizeof mapped)&&!strcmp(mapped,expected));
    TEST(!kh_winpath("C:/hd28/STEAM/Image/../SettingMenu.hed",mapped,sizeof mapped));
    TEST(!real_package("C:/KH2/Image/SettingMenu")); /* HED alone must not select the original constructor. */
    char pkgpath[KH_TMP_MAX+256]; snprintf(pkgpath,sizeof pkgpath,"%s/Image/SettingMenu.pkg",dir);
    f=fopen(pkgpath,"wb"); if(!f) return 1; fclose(f);
    TEST(real_package("C:/KH2/Image/SettingMenu"));
    unlink(pkgpath);
    TEST(!real_package("C:/KH2/Image/SettingMenu"));
    TEST(!package_fallback("C:/hd28/STEAM/SettingMenu/WIN/uk/font/debug.inf"));
    unsigned saved_packages=real_packages; real_packages=1;
    TEST(package_fallback("C:/hd28/STEAM/SettingMenu/WIN/uk/font/debug.inf"));
    TEST(!package_fallback("../mixed.bin")&&!package_fallback("WIN\\..\\mixed.bin"));
    /* No engine registry exists in selftest: invoking fallback here would hang, so loose must win. */
    TEST(kh_call(g,GS_BASE+0x1063d0,0,name,0,0)==4);
    TEST(kh_call(g,GS_BASE+0x106700,0,name,dst,0)==4&&!memcmp(hp(g,dst),"test",4));
    TEST(kh_call5(g,GS_BASE+0x106790,0,name,dst,4,0)==4);
    wr32(g,sz,0); p=kh_call5(g,GS_BASE+0x106870,0,name,sz,0,0);
    TEST(p&&rd32(g,sz)==4&&!memcmp(hp(g,p),"test",4)); if(p) ga_free(p);
    real_packages=saved_packages;
    if(pkg) setenv("KHNMC_PKGDIR",pkg,1); else unsetenv("KHNMC_PKGDIR"); free(pkg);
    unlink(expected); rmdir(image);
    ga_free(name); ga_free(missing); ga_free(dst); ga_free(sz);
    if(root) setenv("KHNMC_DATA",root,1); else unsetenv("KHNMC_DATA");
    if(log) setenv("KHNMC_FILELOG",log,1); else unsetenv("KHNMC_FILELOG");
    free(root); free(log); unlink(path); unlink(lp); rmdir(dir);
    /* task 31: the held-buffer report: a noted `file` block is listed while it lives and forgotten when it is freed; a note taken
     * while files_lock is held does not wait for it (an asset is handed out inside a load: a regression here hangs this test) */
    { u64 b1=ga_alloc_src(3u<<20,16,GA_SRC_FILE), b2=ga_alloc_src(5000,16,GA_SRC_FILE); char l[4096]; size_t nr; FILE *tf;
      pthread_mutex_lock(&files_lock); kh_file_live_note(b1,3u<<20,"selftest/big.asset"); pthread_mutex_unlock(&files_lock); kh_file_live_note(b2,5000,"selftest/small.asset");
      tf=kh_tmpfile(); TEST(tf!=NULL);
      if(tf){ kh_file_live_report(tf,40); rewind(tf); nr=fread(l,1,sizeof l-1,tf); l[nr]=0; fclose(tf);
          TEST(strstr(l,"kh: file buffers: ") && strstr(l,"3.0 MiB held since game frame") && strstr(l,"selftest/big.asset") && strstr(l,"selftest/small.asset"));
          TEST(strstr(l,"(MiB by kind: selftest/sd 3.0)") != NULL);                                       /* the totals by kind */
          { u64 b3=ga_alloc_src(1u<<20,16,GA_SRC_FILE); kh_file_live_note(b3,1u<<20,"obj/T31.mdlx#0:-0.dds"); FILE *t3=kh_tmpfile(); TEST(t3!=NULL);
            if(t3){ kh_file_live_report(t3,1); rewind(t3); nr=fread(l,1,sizeof l-1,t3); l[nr]=0; fclose(t3);
                TEST(strstr(l,"(MiB by kind: selftest/sd 3.0, obj/hd 1.0)") && strstr(l,"selftest/big.asset") && !strstr(l,"obj/T31.mdlx"));   /* top 1: the largest only */
                t3=kh_tmpfile(); if(t3){ kh_file_live_report(t3,-1); rewind(t3); nr=fread(l,1,sizeof l-1,t3); l[nr]=0; fclose(t3);
                    TEST(strstr(l,"selftest/big.asset") && strstr(l,"selftest/small.asset") && strstr(l,"obj/T31.mdlx#0:-0.dds")); }   /* -1: all */
                t3=kh_tmpfile(); if(t3){ kh_file_live_report(t3,0); rewind(t3); nr=fread(l,1,sizeof l-1,t3); l[nr]=0; fclose(t3); TEST(!strstr(l,"held since")); } }   /* 0: the summary only */
            ga_free(b3); }
          ga_free(b1); tf=kh_tmpfile(); if(tf){ kh_file_live_report(tf,40); rewind(tf); nr=fread(l,1,sizeof l-1,tf); l[nr]=0; fclose(tf);
              TEST(!strstr(l,"selftest/big.asset") && strstr(l,"selftest/small.asset")); }
          ga_free(b2); tf=kh_tmpfile(); if(tf){ kh_file_live_report(tf,40); rewind(tf); nr=fread(l,1,sizeof l-1,tf); l[nr]=0; fclose(tf); TEST(!strstr(l,"selftest/small.asset")); } }
      else { ga_free(b1); ga_free(b2); } }
    fprintf(stderr,"kh: file selftest: %d checks, %d failures\n",checks,bad); return bad;
}

#include "rewind.h"
void kh_rewind_files(KhRecords *r){
    KH_RECORD(r,voice_pending); KH_RECORD(r,voice_retired);
    KH_RECORD(r,voice_slot); KH_RECORD(r,voice_data);
    /* Not a record (the stream's layout is fixed): a restored arena may not hold these copies, so they are read again. */
    if(r->loading) memset(voice_axel,0,sizeof voice_axel);
    KH_RECORD(r,real_packages);
    KH_RECORD(r,scene_pack);
    KH_RECORD(r,name_overlays);
    KH_RECORD(r,player_look);
    kh_rewind_look(r);
}

          for(int i=0;i<200;i++) kh_route_menu_text_note(g,0x2000+i,T+oA);                   /* 126 more fit (128 ids per page), then one line says so */
          QCHECK(kh_route_menu_text_lines(&last)==l0+6+126 && strstr(last,"menu 50 page -1: more than 128 different messages; no more lines for this page"));
          wr8(g,GS_BASE+0x9006b0,0); kh_route_menu_text_note(g,0x44d,T+oA); kh_route_menu_text_test_reset(); }
        /* i. why START would not open the camp menu */
        { char why[96]; u64 w=ga_calloc(1,0x6a8);
          memset((void*)XL(g,RECS),0,0x180); wr32(g,GS_BASE+0x749804,0); wr64(g,GS_BASE+0x2a105d0ull,obj); wr32(g,GS_BASE+0x2a10504ull,0); wr32(g,GS_BASE+0x9ab580ull,0); wr32(g,GS_BASE+0x9ab584ull,0); wr64(g,GS_BASE+0x2a0d628ull,0);
          QCHECK(!kh_route_camp_menu_closed(g,why,sizeof why) && why[0]==0 && !EV(KR_MENU_LOCKED,-1));
          wr16(g,RECS+3*0x40,5); QCHECK(kh_route_camp_menu_closed(g,why,sizeof why) && strstr(why,"mission-record") && EV(KR_MENU_LOCKED,-1)); wr16(g,RECS+3*0x40,0);
          wr32(g,GS_BASE+0x749804,0x2000000); QCHECK(kh_route_camp_menu_closed(g,why,sizeof why) && strstr(why,"bit-25")); wr32(g,GS_BASE+0x749804,0x1000000|0x4000000); QCHECK(!kh_route_camp_menu_closed(g,why,sizeof why)); wr32(g,GS_BASE+0x749804,0);
          wr32(g,GS_BASE+0x9ab580ull,0x800000); QCHECK(kh_route_camp_menu_closed(g,why,sizeof why) && strstr(why,"save-flags") && EV(KR_MENU_LOCKED,-1));   /* progress flag 0x817 without 0x834: the prologue before its menu tutorial */
          wr32(g,GS_BASE+0x9ab584ull,0x100000); QCHECK(!kh_route_camp_menu_closed(g,why,sizeof why) && !EV(KR_MENU_LOCKED,-1));
          wr32(g,GS_BASE+0x9ab584ull,0x80000|0x200000); QCHECK(kh_route_camp_menu_closed(g,why,sizeof why)); wr32(g,GS_BASE+0x9ab580ull,0x400000|0x1000000); QCHECK(!kh_route_camp_menu_closed(g,why,sizeof why));
          wr32(g,GS_BASE+0x2a10504ull,4); QCHECK(kh_route_camp_menu_closed(g,why,sizeof why) && strstr(why,"0x142a10504")); wr32(g,GS_BASE+0x2a10504ull,0);
          wr64(g,obj+0xd68,w); wr64(g,w+0x158,T); wr32(g,w+0x6a0,0); QCHECK(kh_route_camp_menu_closed(g,why,sizeof why) && strstr(why,"weapon-1"));
          wr32(g,w+0x6a0,t29_id(g,w)); QCHECK(!kh_route_camp_menu_closed(g,why,sizeof why)); wr32(g,w+0x6a0,0); wr64(g,w+0x158,0); QCHECK(!kh_route_camp_menu_closed(g,why,sizeof why)); wr64(g,obj+0xd68,0);
          wr32(g,obj+0xde0,0xc); QCHECK(kh_route_camp_menu_closed(g,why,sizeof why) && strstr(why,"form-12")); wr32(g,obj+0xde0,0);
          wr32(g,obj+0x18c,0x4000); QCHECK(kh_route_camp_menu_closed(g,why,sizeof why) && strstr(why,"18c")); wr32(g,obj+0x18c,0x8000|0x2000); QCHECK(!kh_route_camp_menu_closed(g,why,sizeof why)); wr32(g,obj+0x18c,0);
          wr64(g,GS_BASE+0x2a0d628ull,T); QCHECK(kh_route_camp_menu_closed(g,why,sizeof why) && strstr(why,"0x142a0d628")); wr64(g,GS_BASE+0x2a0d628ull,0);
          wr64(g,GS_BASE+0x2a105d0ull,0); QCHECK(kh_route_camp_menu_closed(g,why,sizeof why) && strstr(why,"no-player")); wr64(g,GS_BASE+0x2a105d0ull,obj); ga_free(w); }
        /* j. the player's item slots: his equipment record (the id at sheet+0x250) */
        { u64 rec=ga_calloc(1,0x114); int it[8],ar=-1,ac=-1; memset((void*)XL(g,SH),0,0x278); wr64(g,obj+0x5c0,SH); wr32(g,SH+0x250,t29_id(g,rec));
          wr8(g,rec+0x10,1); wr8(g,rec+0x11,2); wr8(g,rec+0x12,3);
          QCHECK(kh_route_item_slots(g,it,&ar,&ac)==3 && ar==1 && ac==2 && it[0]==0 && it[1]==0 && it[2]==0 && !EV(KR_ITEM_SLOT,1));
          wr16(g,rec+0x34+2,1); wr16(g,rec+0x34+6,3); QCHECK(kh_route_item_slots(g,it,NULL,NULL)==3 && it[1]==1 && it[3]==0 && EV(KR_ITEM_SLOT,1) && !EV(KR_ITEM_SLOT,3));   /* the fourth word is no slot of his */
          wr16(g,rec+0x34+4,3); QCHECK(EV(KR_ITEM_SLOT,3) && EV(KR_ITEM_SLOT,1) && !EV(KR_ITEM_SLOT,2));
          wr32(g,SH+0x250,0); QCHECK(kh_route_item_slots(g,it,NULL,NULL)==-1 && EV(KR_ITEM_SLOT,1)==KR_UNREADABLE); wr32(g,SH+0x250,t29_id(g,rec));   /* review of task 31: unreadable, not "false" */
          QCHECK(EV(KR_ITEM_SLOT,2)==0 && EV(KR_HP_BELOW_MAX,-1)==0 && EV(KR_MP_AT_MOST,-1)==0 && EV(KR_HP_AT_MOST,0)==1);                  /* read: a real 0 / 1 */
          wr64(g,obj+0x5c0,0); QCHECK(kh_route_item_slots(g,it,NULL,NULL)==-1);
          QCHECK(EV(KR_ITEM_SLOT,1)==KR_UNREADABLE && EV(KR_HP_BELOW_MAX,-1)==KR_UNREADABLE && EV(KR_MP_BELOW_MAX,-1)==KR_UNREADABLE && EV(KR_HP_AT_MOST,20)==KR_UNREADABLE &&
                 EV(KR_MP_AT_MOST,20)==KR_UNREADABLE && EV(KR_COMMAND_HAS,3)==KR_UNREADABLE && EV(KR_COMMAND_ROW,0)==KR_UNREADABLE && EV(KR_COMMAND_ID,3)==KR_UNREADABLE && EV(KR_COMMAND_DEPTH,0)==1);
          { char sum[1100]; kh_route_state_summary(g,1000,sum,sizeof sum); QCHECK(strstr(sum," player=none item-slots=unreadable ")!=NULL);
            wr64(g,obj+0x5c0,SH); wr16(g,rec+0x34+2,1); kh_route_state_summary(g,1000,sum,sizeof sum); QCHECK(strstr(sum," item-slots=3:0,1,3 ")!=NULL); wr64(g,obj+0x5c0,0); }
          ga_free(rec); }
        /* j2. the save's progress flags (N = world << 10 | index) and menu flags: 0x834 = TT #52 is bit 20 of [0x1409ab584] (as the camp
         *     menu gate above reads it), 0x84a = TT #74 bit 10 of [0x1409ab588], 0x0c00 = DI #0 bit 0 of [0x1409ab5a0]; menu flag 0x70 = bit 16
         *     of [0x1409abc4c] (the Items row), 0x72 bit 18 */
        { memset((void*)XL(g,GS_BASE+0x9ab540ull),0,0x400); memset((void*)XL(g,GS_BASE+0x9abc40ull),0,0x20);
          QCHECK(kh_route_progress_flag(g,0x834)==0 && !EV(KR_PROGRESS_FLAG,0x834) && kh_route_menu_flag(g,0x70)==0 && !EV(KR_MENU_FLAG,0x70));
          wr32(g,GS_BASE+0x9ab584ull,0x100000); QCHECK(EV(KR_PROGRESS_FLAG,0x834) && !EV(KR_PROGRESS_FLAG,0x84a) && !EV(KR_PROGRESS_FLAG,0x814) && !EV(KR_PROGRESS_FLAG,0x434) && !EV(KR_PROGRESS_FLAG,0xc14));
          wr32(g,GS_BASE+0x9ab584ull,0x100400); QCHECK(!EV(KR_PROGRESS_FLAG,0x84a) && EV(KR_PROGRESS_FLAG,0x82a) && EV(KR_PROGRESS_FLAG,0x834));
          wr32(g,GS_BASE+0x9ab588ull,0x400); QCHECK(EV(KR_PROGRESS_FLAG,0x84a) && EV(KR_PROGRESS_FLAG,0x834) && !EV(KR_PROGRESS_FLAG,0x849));
          wr32(g,GS_BASE+0x9ab5a0ull,1); QCHECK(EV(KR_PROGRESS_FLAG,0xc00) && !EV(KR_PROGRESS_FLAG,0x800) && !EV(KR_PROGRESS_FLAG,0x1000));
          wr32(g,GS_BASE+0x9ab540ull,1); QCHECK(EV(KR_PROGRESS_FLAG,0) && !EV(KR_PROGRESS_FLAG,1));
          { char why[96]; wr32(g,GS_BASE+0x9ab580ull,0x800000); wr32(g,GS_BASE+0x9ab584ull,0); QCHECK(EV(KR_PROGRESS_FLAG,0x817) && kh_route_camp_menu_closed(g,why,sizeof why) && strstr(why,"save-flags"));
            wr32(g,GS_BASE+0x9ab580ull,0); }                                                      /* the gate reads the same bits */
          wr32(g,GS_BASE+0x9abc4cull,0x10000); QCHECK(EV(KR_MENU_FLAG,0x70) && !EV(KR_MENU_FLAG,0x72) && !EV(KR_MENU_FLAG,0x50) && !EV(KR_MENU_FLAG,0x71) && kh_route_menu_flag(g,0x70)==1);
          wr32(g,GS_BASE+0x9abc4cull,0x50000); QCHECK(EV(KR_MENU_FLAG,0x72) && EV(KR_MENU_FLAG,0x70)); wr32(g,GS_BASE+0x9abc40ull,0x80000000u); QCHECK(EV(KR_MENU_FLAG,31) && !EV(KR_MENU_FLAG,0));
          QCHECK(kh_route_progress_flag(g,-1)==-1 && kh_route_progress_flag(g,0x8000)==-1 && kh_route_menu_flag(g,256)==-1); }
        /* k. the INFORMATION bar's note (what the 0x17b710 hook does before it passes the call on) */
        { int last=-2; u64 n0=kh_route_information_shown(&last); kh_route_information_note(g,T+oB); QCHECK(kh_route_information_shown(&last)==n0+1 && last==0x3f5c);
          kh_route_information_note(g,T+oB+2); QCHECK(kh_route_information_shown(&last)==n0+2 && last==-1);
          /* (review of task 31) a text two ids share (0x3f56 = 0x3f59, as in msg/us/eh.bar): without the game's lookup both are named
           * and none is claimed; with a lookup of 0x3f59 in the same frame on this thread that gave this pointer, 0x3f59 is the id */
          int ids[8]; QCHECK(kh_route_message_ids(g,T+oA,ids,8)==2 && ids[0]==0x3f56 && ids[1]==0x3f59 && kh_route_message_ids(g,T+oB,ids,8)==1 && ids[0]==0x3f5c && kh_route_message_ids(g,T+oB+1,ids,8)==0);
          kh_route_message_lookup_note(0x3f5c,T+oB); kh_route_information_note(g,T+oA);                                   /* the last lookup gave another pointer */
          QCHECK(kh_route_information_shown(&last)==n0+3 && last==-1 && strstr(kh_route_information_line(),"\"@KHINPUT(message,data/msg/us/al.bar,16887,22,ec2868684a372f5b27808ee4c45c7ef828d91910f50a7f5623cb0e97c7028880)@\" (message 0x3f56 = 0x3f59: the text of each of these ids; the game's lookup was not seen"));
          kh_route_message_lookup_note(0x3f59,T+oA); kh_route_information_note(g,T+oA);
          QCHECK(kh_route_information_shown(&last)==n0+4 && last==0x3f59 && strstr(kh_route_information_line(),"\"@KHINPUT(message,data/msg/us/al.bar,16887,22,ec2868684a372f5b27808ee4c45c7ef828d91910f50a7f5623cb0e97c7028880)@\" (message 0x3f59, the id the game looked up; the same text is message 0x3f56 = 0x3f59)"));
          kh_route_message_lookup_note(0x8000|0x3f56,T+oA); kh_route_information_note(g,T+oA); QCHECK(kh_route_information_shown(&last)==n0+5 && last==0x3f56);   /* bit 15: the same id */
          kh_route_message_lookup_note(0x3f5c,T+oB); kh_route_information_note(g,T+oB); QCHECK(kh_route_information_shown(&last)==n0+6 && last==0x3f5c && strstr(kh_route_information_line(),"\"@KHINPUT(message,data/msg/us/eh.bar,4859,27,bcba566c70bce9cb1339b6ca2fa097d4b8cc8e72787b20f1bb92f19c076de0e5)@\" (message 0x3f5c)"));
          kh_route_message_lookup_note(-1,0); }
#undef EV
#undef WF
        for(size_t i=0;i<sizeof R/sizeof *R;i++){ memcpy((void*)XL(g,GS_BASE+R[i].a),sv[i],R[i].n); free(sv[i]); }
        ga_free(T); ga_free(M); ga_free(H); ga_free(obj); ga_free(tobj); ga_free(o2); ga_free(o3); ga_free(E1); ga_free(E2); ga_free(C);
        kh_route_objective_test_reset(); kh_route_message_test_reset(); kh_route_state_test_reset();
    }
    if(sv_env) setenv("KHNMC_ROUTE_DIFFICULTY",sv_envv,1);
    kh_input_load(g,getenv("KHNMC_INPUT_SCRIPT"));
    fprintf(stderr,"kh: input route Q31 selftest: %d checks, %d failures\n",checks,fails);
#undef QCHECK
    return fails;
}

/* ---- task 33: the debug warp steps (`@warp`, `@warp list`; the warp itself is runtime/warp.c, tested there) ---------------------
 * Here: the route lines, the step's hand-over (met when the warp reached the field, one list entry after the other), the route report's
 * `debug warps`, the named fatal of a single warp that fails, the end of a list that stops (exit 6) and the load errors. */
static int w33_field, w33_busy, w33_place_w=0x12, w33_place_r=2, w33_req, w33_stuck_from=1000000;
static int w33_cond(KCtx *g,int kind,u64 n){ (void)g; (void)n; return kind==KR_FIELD?w33_field:0; }
static int w33_jbusy(KCtx *g){ (void)g; return w33_busy; }
static int w33_place(KCtx *g,int *w,int *r){ (void)g; *w=w33_place_w; *r=w33_place_r; return 1; }
static void w33_request(KCtx *g,const u8 rec[10]){ (void)g; w33_req++; w33_busy=1; if(w33_req<w33_stuck_from){ w33_place_w=rec[0]; w33_place_r=rec[1]; } }
/* a game that carries out every jump at once: the jump task appears with the request and is gone at the next frame; the field is
 * always up, except after the w33_stuck_from-th request (that room never comes back) */
static void w33_tick(KCtx *g,u64 n){ route_tick(g,n); if(w33_busy) w33_busy=0; w33_field=w33_req<w33_stuck_from; }
static void w33_run(KCtx *g,u64 n0,u64 n1){ for(u64 n=n0;n<=n1;n++) w33_tick(g,n); }
static void w33_body(void){ kh_input_load(t_g,t_child_path); w33_run(t_g,1,t_fatal_ticks); _exit(0); }
int kh_input_route33_selftest(KCtx *g){
    int checks=0,fails=0; t_g=g;
#define WCHECK(c) do{ checks++; if(!(c)){ fails++; fprintf(stderr,"input route S33 selftest FAIL: %s (line %d)\n",#c,__LINE__); } }while(0)
    char *sv_env=getenv("KHNMC_ROUTE_DIFFICULTY"); char sv_envv[16]=""; if(sv_env) snprintf(sv_envv,sizeof sv_envv,"%s",sv_env); unsetenv("KHNMC_ROUTE_DIFFICULTY");
    KhWarpProbe fp={w33_cond,w33_jbusy,w33_place,w33_request}; kh_warp_set_probe(&fp);
    /* 1. a single warp: parsed, met when the field has stayed up `settle` frames in the new room, counted in the report */
    WCHECK(t_load(g,"@timeout 500\n@warp mu 13 door 1 map 0x4f settle 5\n+1 +1 A\n") && nsteps==1 && steps[0].type==ST_WARP && steps[0].nwarp==1 &&
           steps[0].warp[0].world==8 && steps[0].warp[0].room==13 && steps[0].warp[0].door==1 && steps[0].warp[0].prog[0]==0x4f && steps[0].warp[0].prog[1]==0xffff &&
           steps[0].settle==5 && steps[0].timeout==500 && steps[0].nrel==1);
    WCHECK(t_load(g,"@warp lk 3\n") && steps[0].settle==KH_WARP_SETTLE_DEFAULT && steps[0].timeout==3600);
    w33_req=0; w33_busy=0; w33_field=1; w33_place_w=0x12; w33_place_r=2; w33_stuck_from=1000000;
    t_load(g,"@warp mu 13 settle 5\n+1 +1 A\n"); u64 rq0=kh_warp_count();
    w33_run(g,1,4); WCHECK(w33_req==0 && !steps[0].met);                       /* 5 safe frames before the request */
    w33_run(g,5,5); WCHECK(w33_req==1 && w33_place_w==8 && w33_place_r==13);
    w33_run(g,6,40); WCHECK(steps[0].met>0 && route_done && kh_warp_count()==rq0+1);
    { FILE *f=kh_tmpfile(); if(f){ route_report(f); rewind(f); char l[2048]=""; size_t nr=fread(l,1,sizeof l-1,f); l[nr]=0; fclose(f);
        WCHECK(strstr(l,"L1:warp=") && strstr(l,"debug warps ") && strstr(l,"this room loads from this state, not that the game reaches it")); }
      else kh_selftest_not_run("input route S33","route report into a temp file",1); }
    /* a route without a warp says nothing about warps */
    WCHECK(t_load(g,"@wait field\n")); { FILE *f=kh_tmpfile(); if(f){ route_report(f); rewind(f); char l[2048]=""; size_t nr=fread(l,1,sizeof l-1,f); l[nr]=0; fclose(f); WCHECK(!strstr(l,"debug warps")); } }
    /* 2. the list: relative to the route file, every entry in turn, the step met after the last */
    char lp[KH_TMP_MAX]; kh_tmp_path(lp,sizeof lp,"khnmc-r33list-XXXXXX"); int fd=mkstemp(lp); WCHECK(fd>=0);
    if(fd>=0){ const char *txt="mu 12\nmu 13 map 0x4f btl 0x4f evt 0x4f\n# a comment\nlm 3\n"; WCHECK(write(fd,txt,strlen(txt))==(ssize_t)strlen(txt)); close(fd); }
    const char *base=strrchr(lp,'/'); base=base?base+1:lp;
    char rt[600]; snprintf(rt,sizeof rt,"@warp list %s settle 4 timeout 200\n@warp eh 2 settle 2\n",base);
    w33_req=0; w33_busy=0; w33_field=1; w33_place_w=0x12; w33_place_r=2; w33_stuck_from=1000000;
    WCHECK(t_load(g,rt) && nsteps==2 && steps[0].type==ST_WARPLIST && steps[0].nwarp==3 && steps[0].settle==4 && steps[0].timeout==200 &&
           steps[0].warp[1].prog[2]==0x4f && steps[0].warp[2].world==11 && steps[0].warp[2].line==4);
    w33_run(g,1,200); WCHECK(w33_req==4 && steps[0].warp_i==3 && steps[0].met>0 && steps[1].met>steps[0].met && w33_place_w==0x12 && w33_place_r==2 && route_done);
    /* 3. named fatals and the stop of a list, in a child */
    if(kh_fork_ok()){
        char o[32768];
        w33_req=0; w33_busy=0; w33_field=1; w33_place_w=0x12; w33_place_r=2; w33_stuck_from=1;
        t_fatal_txt="@warp mu 13 settle 3 timeout 40\n"; t_fatal_ticks=300;
        WCHECK(t_child(w33_body,o,sizeof o)==3 && strstr(o,"route-warp-failed:") && strstr(o,"line 1 `@warp mu 13 settle 3 timeout 40`") && strstr(o,"JUMP-NOT-DONE"));
        w33_req=0; w33_busy=0; w33_field=1; w33_place_w=0x12; w33_place_r=2; w33_stuck_from=2;   /* the second entry never comes back */
        snprintf(rt,sizeof rt,"@warp list %s settle 3 timeout 40\n",lp); t_fatal_txt=rt; t_fatal_ticks=400;
        int st=t_child(w33_body,o,sizeof o);
        WCHECK(st==6 && strstr(o,"kh: warp: #1 result mu12 FIELD") && strstr(o,"kh: warp: #2 result mu13 JUMP-NOT-DONE") &&
               strstr(o,"kh: warp: list stopped at entry 2 of 3 (list line 2 `mu 13 map 0x4f btl 0x4f evt 0x4f`)") && strstr(o,"the 1 entries after it are not warped in this run") &&
               strstr(o,"ROUTE INCOMPLETE") && strstr(o,"debug warps 2 (field reached 1, jumped on by the room's own program 0, failed 1;"));
        if(st!=6 || !strstr(o,"kh: warp: #2 result mu13")){ const char *k=strstr(o,"kh: warp:"); fprintf(stderr,"  list stop: status %d: %.1500s\n",st,k?k:o); }
        static const struct { const char *txt, *msg; } bad[]={
            {"@warp\n","line 1: @warp WORLD ROOM"}, {"@warp qq 1\n","line 1: @warp: unknown world"}, {"@warp mu 99\n","line 1: @warp: the room is a number 0..63"},
            {"@warp mu 1 speed 2\n","line 1: unknown option for @warp"}, {"@warp list\n","line 1: @warp list FILE"}, {"@warp list khnmc-no-such-list.txt\n","cannot open the warp list"},
            {"@warp list x settle\n","line 1: @warp list: settle and timeout take a number"}, {"@warp list x color 2\n","line 1: unknown option for @warp list"},
            {"@warp mu 1\n+0 +1 A\n","line 2: +A +B BUTTONS"},
        };
        for(size_t i=0;i<sizeof bad/sizeof *bad;i++){ t_fatal_txt=bad[i].txt; t_fatal_ticks=1;
            int s2=t_child(w33_body,o,sizeof o); WCHECK(s2==3 && strstr(o,"scripted XInput: ") && strstr(o,bad[i].msg)); if(s2!=3||!strstr(o,bad[i].msg)) fprintf(stderr,"  case %zu: status %d: %.300s\n",i,s2,o); }
    } else kh_selftest_not_run("input route S33","@warp fatals and the stop of a list (in a child)",11);
    if(fd>=0) unlink(lp);
    kh_warp_set_probe(NULL);
    kh_input_load(g,NULL);
    if(sv_env) setenv("KHNMC_ROUTE_DIFFICULTY",sv_envv,1);
    kh_input_load(g,getenv("KHNMC_INPUT_SCRIPT"));
    fprintf(stderr,"kh: input route S33 selftest: %d checks, %d failures\n",checks,fails);
#undef WCHECK
    return fails;
}

#include "rewind.h"
void kh_rewind_input(KhRecords *r){
    KH_RECORD(r,game_frames);
    KH_RECORD(r,last_pad);
    KH_RECORD(r,packet);
    KH_RECORD(r,route_pad);
    KH_RECORD(r,step_base);
    KH_RECORD(r,cur_step);
    KH_RECORD(r,step_phase);
    KH_RECORD(r,step_t0);
    KH_RECORD(r,step_anchor);
    KH_RECORD(r,route_done);
    KH_RECORD(r,sel_from);
    KH_RECORD(r,sel_until);
    KH_RECORD(r,sel_dir);
    KH_RECORD(r,sel_v0);
    KH_RECORD(r,goto_best);
    KH_RECORD(r,goto_d);
    KH_RECORD(r,goto_x);
    KH_RECORD(r,goto_z);
    KH_RECORD(r,goto_cam);
    KH_RECORD(r,goto_tx);
    KH_RECORD(r,goto_tz);
    KH_RECORD(r,goto_best_at);
    KH_RECORD(r,goto_seen);
    KH_RECORD(r,goto_have_cam);
    KH_RECORD(r,goto_lx);
    KH_RECORD(r,goto_ly);
    KH_RECORD(r,fight_a);
    KH_RECORD(r,fight_enemies);
    KH_RECORD(r,fight_presses);
    KH_RECORD(r,fight_pages);
    KH_RECORD(r,skip_btn);
    KH_RECORD(r,skip_hold);
    KH_RECORD(r,skip_gap);
    KH_RECORD(r,skip_starts);
    KH_RECORD(r,skip_skips);
    KH_RECORD(r,skip_moves);
    KH_RECORD(r,skip_pages);
    KH_RECORD(r,talk_run);
    KH_RECORD(r,talk_presses);
    KH_RECORD(r,talk_msg);
    KH_RECORD(r,goto_noobj);
    KH_RECORD(r,react_presses);
    KH_RECORD(r,react_seen);
    KH_RECORD(r,goto_ox);
    KH_RECORD(r,goto_oz);
    KH_RECORD(r,react_landing);
    KH_RECORD(r,react_open);
    KH_RECORD(r,react_shut);
    static char reason[160];
    if(!r->loading){
        if(react_why && strlen(react_why)>=sizeof reason) kh_fatal(NULL,"savestate-input-reaction-name");
        char copy[sizeof reason]={0};
        if(react_why) strcpy(copy,react_why);
        memcpy(reason,copy,sizeof reason);
    }
    KH_RECORD(r,reason);
    if(r->loading) react_why=*reason?reason:NULL;
    KH_RECORD(r,warp_watching);
    KH_RECORD(r,warp_seq);
    KH_RECORD(r,last_script_frame);
    KH_RECORD(r,hold_shift);
    KH_RECORD(r,hold_released);
    KH_RECORD(r,clock_sf0);
    KH_RECORD(r,clock_gf0);
    KH_RECORD(r,host_pad_on);
    pthread_mutex_lock(&input_lock);
    ScriptPad physical=host_pad;
    KH_RECORD(r,host_pad);
    KH_RECORD(r,host_latched);
    if(r->loading && host_pad_on && kh_theater_active()){
        /* The controller can have released Confirm while the scene played. */
        host_pad=physical;
        host_latched=0;
    }
    pthread_mutex_unlock(&input_lock);
    for(size_t i=0;i<nsteps;i++){
        Step *s=&steps[i];
        KH_RECORD(r,s->started); KH_RECORD(r,s->met); KH_RECORD(r,s->waited); KH_RECORD(r,s->warp_i);
    }
}

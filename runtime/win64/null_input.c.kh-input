        static const struct kh_item_obs heal={.id=1,.pct=40,.mult=100,.cmd=23,.byte2f=0,.reversed=0,.hp_before=12,.hp_after=20,.hp_max=20,.mp_before=100,.mp_after=100,.mp_max=100,.hp_amount=8,.hp_call=1};

#include "savestate.h"
#include "settings.h"
#include "khnmc_rt.h"
/* Scripted XInput pad 0; other input backends remain empty. Ranges are inclusive;
 * gaps release all controls, and later lines win when ranges overlap.
 * Two kinds of script (input/README.md):
 *   frame-numbered  `FROM TO BUTTONS [lx ly]` lines, optionally `@hold FRAME until initial-state N` and `@clock game-frames`
 *                   (tasks 5, 14): presses at fixed frame numbers.  Unchanged by task 27.
 *   route           (task 27) steps that follow the GAME's state: `@wait COND`, `@press BUTTONS until COND`, `@select CURSOR N`,
 *                   `@expect COND`, each followed by presses relative to the game frame in which its condition was met
 *                   (`+A +B BUTTONS [lx ly]`).  Conditions are read by runtime/route_state.c at the end of every game frame; a
 *                   condition that does not come within its time-out ends the run with a named fatal that says which state never
 *                   came.  Everything is counted in game frames (calls of 0x105e10), nothing in wall time or presents.
 *                   Task 29 adds `@goto X Z` (walks the player toward a point of the map with the left stick, camera-relative),
 *                   `@select command-row N | command-id N` (the field command menu) and the player / menu / map / item conditions.
 *   The two kinds cannot be mixed in one file (a named fatal at load). */
#include <errno.h>
#include <unistd.h>
#include <limits.h>
#include <sys/wait.h>
#include <math.h>
#include "route_state.h"
#include "mod_config.h"
#include "warp.h"
#include "xion_swap.h"
#include "autosave.h"
#include "slot_disk.h"
typedef struct { u16 buttons; u8 lt,rt; s16 lx,ly,rx,ry; } ScriptPad;
_Static_assert(sizeof(ScriptPad)==12,"XINPUT_GAMEPAD layout");
typedef struct { u64 start,end; ScriptPad pad; } InputRange;
static InputRange *ranges;
static size_t nranges;
static int scripted;
static ScriptPad last_pad;
static u32 packet;
static pthread_mutex_t input_lock=PTHREAD_MUTEX_INITIALIZER;
/* host pad (2026-11-18, the iPhone): the platform shell's game controller as XInput pad 0.  KHNMC_INPUT=host turns it on when no input
 * script is loaded and the run is not a selftest; the shell (runtime/ios/ios_main.m: GameController framework) writes the whole state
 * with kh_input_host_pad_set from its own thread.  Unlike a script, it drives the right stick (the camera) too. */
static int host_pad_on; static ScriptPad host_pad; static u64 host_pad_changes, host_pad_logged;
static u16 host_latched;   /* review r9: buttons pressed since the last poll stay pressed for that poll (a tap shorter than a frame) */
static int pad_source(void){ return scripted||host_pad_on; }
void kh_input_host_pad_set(u16 buttons,u8 lt,u8 rt,s16 lx,s16 ly,s16 rx,s16 ry){
    ScriptPad p={buttons,lt,rt,lx,ly,rx,ry}; u16 was;
    pthread_mutex_lock(&input_lock); was=host_pad.buttons;
    if(memcmp(&p,&host_pad,sizeof p)){ host_pad=p; host_pad_changes++; }
    host_latched|=(u16)(buttons&~was);
    int logit=was!=buttons && host_pad_logged<200; if(logit) host_pad_logged++;
    pthread_mutex_unlock(&input_lock);
    if(logit) fprintf(stderr,"kh: input: host pad buttons 0x%04x (lt %u rt %u, left %d,%d right %d,%d)\n",buttons,lt,rt,lx,ly,rx,ry);
    /* the first full deflection of each trigger and stick direction is logged once (a controller check reads them; the button lines
     * above show only button changes) */
    static _Atomic unsigned seen; static const char *const what[]={"L2 / LT full","R2 / RT full","left stick left","left stick right",
        "left stick down","left stick up","right stick left","right stick right","right stick down","right stick up"};
    unsigned now=(lt>=200?1u:0)|(rt>=200?2u:0)|(lx<=-25000?4u:0)|(lx>=25000?8u:0)|(ly<=-25000?16u:0)|(ly>=25000?32u:0)
                |(rx<=-25000?64u:0)|(rx>=25000?128u:0)|(ry<=-25000?256u:0)|(ry>=25000?512u:0);
    unsigned fresh=now&~atomic_fetch_or(&seen,now);
    for(int i=0;i<10;i++) if(fresh&(1u<<i)) fprintf(stderr,"kh: input: host pad first full deflection: %s (lt %u rt %u, left %d,%d right %d,%d)\n",what[i],lt,rt,lx,ly,rx,ry);
}
int kh_input_host_test(int on){ int was=host_pad_on; host_pad_on=on; pthread_mutex_lock(&input_lock); memset(&host_pad,0,sizeof host_pad); host_latched=0; pthread_mutex_unlock(&input_lock); return was; }   /* selftest */
/* TASK41 (docs/IOS-SHELL.md "Leaving the screen" step 5): the host pad neutral, as XInputGetState reports a pad with nothing held.  A
 * button held when the app left the screen must not stay held: its release may never arrive.  The latched taps are dropped too (a tap
 * just before the lock must not fire after the resume).  Returns the buttons that were held or latched, | 0x10000 when a stick or trigger was off centre (0 = it was neutral already). */
unsigned kh_input_host_pad_neutral(void){
    pthread_mutex_lock(&input_lock); u16 was=(u16)(host_pad.buttons|host_latched); int moved=host_pad.lt||host_pad.rt||host_pad.lx||host_pad.ly||host_pad.rx||host_pad.ry;
    if(was||moved) host_pad_changes++; memset(&host_pad,0,sizeof host_pad); host_latched=0; pthread_mutex_unlock(&input_lock);
    if(was||moved) fprintf(stderr,"kh: input: host pad set neutral (buttons 0x%04x were held or latched%s)\n",was,moved?", a stick or trigger was off centre":"");
    return (unsigned)was|(moved?0x10000u:0u); }
void kh_input_host_pad_get(u16 *buttons,u16 *latched,s16 *lx){ pthread_mutex_lock(&input_lock); if(buttons) *buttons=host_pad.buttons; if(latched) *latched=host_latched; if(lx) *lx=host_pad.lx; pthread_mutex_unlock(&input_lock); }   /* selftest */
extern _Atomic u64 gfx_presents;
static const char *button_names[]={"DPAD_UP","DPAD_DOWN","DPAD_LEFT","DPAD_RIGHT","START","BACK","LSTICK","RSTICK","LB","RB",NULL,NULL,"A","B","X","Y","LT","RT"};
static int number(const char *s,long long lo,long long hi,long long *v){
    char *end; errno=0; *v=strtoll(s,&end,10); return !errno && end!=s && !*end && *v>=lo && *v<=hi;
}
/* `@hold FRAME until initial-state N` : script frames >= FRAME are not sampled before the Initial Settings screen has reached state N.
 * The script clock is the present counter, but the game thread's progress per present depends on the machine's load (the render
 * thread keeps presenting while the game thread boots): a confirm press scripted for present 180 misses a screen that only reaches
 * its prompt at present 186, and the route then loops in the settings menu for the whole run.  With a hold the script waits at
 * FRAME-1 and is delayed by exactly the lateness; a run that reaches the state in time is sampled exactly as without the line. */
static long long hold_frame=-1; static int hold_state=-1; static _Atomic long long hold_shift; static _Atomic int hold_released;
/* `@hold FRAME until initial-state N [timeout T]` (task 31, the 2026-11-17 review): a hold that is not released by present FRAME-1+T
 * ends the run with the named fatal `input-hold-timeout` (before, it waited for ever and the run still exited 0).  T counts presents,
 * the clock of a frame-numbered script before its release; the default is generous (the state comes at present 100..200 on this
 * machine, later only under load). */
#define HOLD_TIMEOUT_DEFAULT 6000
static long long hold_timeout=HOLD_TIMEOUT_DEFAULT; static unsigned hold_line;
/* `@clock game-frames` (needs a hold): after the hold is released the script advances with the GAME thread's frames instead of
 * presents.  A game frame = one call of 0x105e10, which the end-of-frame task 0x1548e0 / 0x154740 makes once per frame and the
 * settings menu's own loop (0x4edef9, nested inside one such call) once per iteration.  One game frame is one present on
 * an idle machine, so a script written in presents keeps its meaning; on a loaded machine the game thread makes fewer frames than
 * the render thread presents, and a script clocked by presents runs ahead of the menus it is driving. */
static int clock_game; static _Atomic u64 game_frames; static _Atomic long long clock_sf0, clock_gf0; static _Atomic u64 last_script_frame;
/* KH_RUN_GAME_FRAMES=n ends the run (exit 0, with the reports) when the game thread has made n frames: a route length that does not
 * depend on the machine's load, unlike KH_RUN_SECONDS, which then only serves as the watchdog. */
static u64 run_game_frames;
u64 kh_game_frames(void){ return atomic_load(&game_frames); }      /* frames the game thread has made (diagnostic logs) */
static void route_tick(KCtx *g,u64 n);                                /* task 27: the route's steps, once per game frame */
static void hold_check(KCtx *g,u64 present);                          /* task 31 review: the hold's time-out */
u16 kh_input_buttons(void){
    pthread_mutex_lock(&input_lock); u16 buttons=last_pad.buttons; pthread_mutex_unlock(&input_lock); return buttons;
}
void orig_f_105e10(KCtx *g);
void f_105e10(KCtx *g){
    if(kh_cut_enabled) kh_cut_frame(g,atomic_load(&game_frames)+1);
    kh_game_frame_step(g);
}
void kh_game_frame_step(KCtx *g){
    u64 n=atomic_fetch_add(&game_frames,1)+1;
    extern void kh_settings_frame(KCtx *,uint64_t); kh_settings_frame(g,n);
    extern void kh_retry_frame(KCtx *); kh_retry_frame(g);
    extern void kh_shortcut_frame(KCtx *); kh_shortcut_frame(g);
    extern void kh_test_resize_frame(u64); kh_test_resize_frame(n);
    { extern void kh_idtable_game_frame(u64); kh_idtable_game_frame(n); extern void kh_moose_game_frame(KCtx *); kh_moose_game_frame(g); }
    if(kh_xion_enabled){
        kh_xion_frame(g,kh_input_buttons());
    }
    kh_route_state_tick(g,n); route_tick(g,n); hold_check(g,atomic_load(&gfx_presents));
    if(run_game_frames && n>=run_game_frames){ extern void kh_exit_process(int); kh_warn("input: KH_RUN_GAME_FRAMES=%llu reached, ending the run",(unsigned long long)run_game_frames); kh_exit_process(0); }
    orig_f_105e10(g);
}
long long kh_phase_initial_first(int state);
static u64 script_frame(u64 present){
    if(hold_frame<0) return present;
    if(!atomic_load(&hold_released)){
        long long first=kh_phase_initial_first(hold_state);
        if(first<0) return present<(u64)hold_frame?present:(u64)hold_frame-1;
        long long shift=first>hold_frame-1?first-(hold_frame-1):0; int z=0;
        atomic_store(&hold_shift,shift);
        atomic_store(&clock_sf0,(long long)present-shift>0?(long long)present-shift:0); atomic_store(&clock_gf0,(long long)atomic_load(&game_frames));
        if(atomic_compare_exchange_strong(&hold_released,&z,1))
            fprintf(stderr,"kh: scripted XInput: hold at script frame %lld released: InitialSetting state %d first seen at present %lld, script delayed by %lld presents%s\n",hold_frame,hold_state,first,shift,clock_game?"; from here the script follows game frames":"");
    }
    if(clock_game){ long long f=atomic_load(&clock_sf0)+((long long)atomic_load(&game_frames)-atomic_load(&clock_gf0)); return f>0?(u64)f:0; }
    long long sh=atomic_load(&hold_shift); return present>(u64)sh?present-(u64)sh:0;
}
u64 kh_input_game_frames(void){ return atomic_load(&game_frames); }
static char route_path[512];
/* the hold's time-out (see HOLD_TIMEOUT_DEFAULT): checked on every pad poll and at the end of every game frame.  A state that has been
 * seen counts as a release even before the next poll performs it. */
static void hold_check(KCtx *g,u64 present){
    if(!scripted || hold_frame<0 || atomic_load(&hold_released) || kh_phase_initial_first(hold_state)>=0) return;
    if(present+1<(u64)hold_frame+(u64)hold_timeout) return;                      /* present < FRAME-1+T */
    int kh_phase_initial_alive(void); int kh_phase_initial_state(void);
    kh_fatal(g,"input-hold-timeout: %s line %u `@hold %lld until initial-state %d`: the Initial Settings screen did not reach state %d within %lld presents "
               "of script frame %lld (now present %llu, game frame %llu; the Initial Settings screen %s%d); the script's frames from %lld on would never be played",
             route_path,hold_line,hold_frame,hold_state,hold_state,hold_timeout,hold_frame-1,(unsigned long long)present,(unsigned long long)atomic_load(&game_frames),
             kh_phase_initial_alive()?"runs, state ":"does not run, last state ",kh_phase_initial_state(),hold_frame);
}
/* ---- task 27: route steps ----------------------------------------------------------------------------------------------------
 * A step starts at the end of a game frame (a "tick", the 0x105e10 hook) and reads its condition there.  Game frame numbers: the
 * tick that ends frame F carries n = F+1 (the counter after the increment); the pad that tick computes is the pad of the NEXT frame,
 * counter n.  A step met at tick n has its anchor at counter n-1 (the frame in which the state was seen): `+A +B` presses counters
 * anchor+A .. anchor+B, so `+1` is the very next frame (A >= 1 is required).  The next step starts at the tick that ends the first
 * frame after the last relative press, a frame with nothing pressed: two steps' presses are always separated by at least one
 * released frame, so the game sees every press as a new one.  A step without relative lines hands over in the same tick, unless the
 * frame that just ended had a button or trigger down (review U35 routes n=4: `@press A until field` then `@wait field` + `+1 +1 A` was
 * one continuous A): then the next frame is released first, and the next step starts at the tick that ends it.  The stick alone does
 * not count, so a chain of @goto steps keeps walking. */
typedef struct { int kind, arg, neg; } Cond;
enum { ST_WAIT, ST_PRESS, ST_SELECT, ST_EXPECT, ST_GOTO, ST_FIGHT, ST_SKIP, ST_TALK, ST_REACT, ST_WARP, ST_WARPLIST };   /* task 33: the debug warp (runtime/warp.c) */
static const char *st_name[]={"@wait","@press","@select","@expect","@goto","@fight","@skip","@talk","@react","@warp","@warp list"};
typedef struct { u64 a,b; ScriptPad pad; } RelRange;
typedef struct { int type; Cond c; ScriptPad pad, held; u64 every, hold, timeout; unsigned line; char text[160]; RelRange *rel; size_t nrel; u64 maxb;
                 u64 started, met, waited;
                 float gx, gz, radius; u64 stall; int has_until, to_enemy; u64 stable;
                 int to_object; char obj_name[40];       /* task 31: @goto object NAME (the nearest object with that objentry model name) */
                 int only;                               /* task 31: @if-difficulty N: -1 = always */
                 int react_id;                           /* task 31: @react [id N]: only this reaction command is answered (-1 = any) */
                 KhWarpTarget *warp; size_t nwarp, warp_i; u64 settle; } Step;   /* @warp / @warp list (task 33): the places, the next one, frames the field must stay up */   /* @talk: frames `until` must hold in a row */   /* @goto: target (or the nearest enemy), radius, frames without progress, `until` in c */
static Step *steps; static size_t nsteps;
#define ARG_DIFFICULTY (-2)                /* a condition argument `difficulty`: the route's difficulty (@difficulty N or KHNMC_ROUTE_DIFFICULTY) */
static int route_difficulty=-1; static const char *route_difficulty_from="";
static size_t cur_step; static int step_phase;            /* 0 not started, 1 waiting / pressing, 2 relative presses */
static u64 step_t0, step_anchor; static int route_done; static KhRouteBase step_base;
static ScriptPad route_pad;                               /* the pad of the next frame (counter = game_frames), written by route_tick */
static long long sel_from=-1, sel_until=-1; static int sel_dir, sel_v0;
static int (*cond_fn)(KCtx *,int,int,u64,const KhRouteBase *)=kh_route_cond_eval;   /* the selftest replaces these with recorders */
static int (*cursor_fn)(KCtx *,int)=kh_route_cursor;
static int (*target_fn)(KCtx *,int,int)=kh_route_cursor_target;
static int (*pos_fn)(KCtx *,float *,float *,float *,float *)=kh_route_player_pos;
static int (*yaw_fn)(KCtx *,float *)=kh_route_camera_yaw;
static int (*enemy_fn)(KCtx *,float,float,float *,float *,float *)=kh_route_enemies;
/* @goto (task 29): progress bookkeeping of the running step and the stick it computed for the next frame */
#define GOTO_PROGRESS 10.0f                                   /* the distance must shrink by this much (map units) to count as progress */
#define FIGHT_SETBACK 50.0f                                   /* @fight: a distance this much above the closest one starts a new approach (task 30: a knock-back
                                                                 made the first version time a walk of 1,000 units against a closest distance of 166 seen before it) */
static float goto_best, goto_d, goto_x, goto_z, goto_cam, goto_tx, goto_tz; static u64 goto_best_at; static int goto_seen, goto_have_cam; static s16 goto_lx, goto_ly;
/* @fight (task 30): A pressed for the next frame, enemies seen at the last tick (-1 = no map), A presses made (new presses) */
static int fight_a, fight_enemies; static u64 fight_presses, fight_pages;
/* @skip (task 30): the button pressed for the next frame, frames it stays pressed, released frames before the next press, and counts */
#define SKIP_ROW 5                                            /* the pause screen's "skip the event" row id (row 6 continues) */
static u16 skip_btn; static int skip_hold, skip_gap; static u64 skip_starts, skip_skips, skip_moves, skip_pages;
/* @talk (task 30): `until` held this many frames in a row; A presses made while a message waited */
static u64 talk_run, talk_presses; static int talk_msg;
static int (*pause_fn)(KCtx *,KhPauseMenu *)=kh_route_pause_menu;
/* task 31: @goto object (objects of that name: count and the nearest), @react (the reaction rows; Y presses made, the command seen last) */
static int (*object_fn)(KCtx *,const char *,float,float,float *,float *,float *)=kh_route_objects_named;
static int (*reaction_fn)(KCtx *,KhReaction *)=kh_route_reaction;
static int (*react_name_fn)(KCtx *,const KhReaction *,char *,size_t)=kh_route_reaction_target;
static int goto_noobj; static u64 react_presses; static int react_seen; static float goto_ox, goto_oz;   /* where the object stood when the closest distance was taken */
/* review of task 31: a press whose frame has not been checked yet; game frames with an offer of what the step answers (answerable or not)
 * and why the one seen last could not be answered */
static int react_landing; static u64 react_open, react_shut; static const char *react_why;
#define REACT_BUTTON 0x8000                                   /* Y on an XInput pad: the reaction button (triangle on the PS2) */
static int warp_watching; static int warp_seq;            /* task 33: a warp of the current step is being watched; warps begun in this run */
#define WARP_LIST_STOPPED_EXIT 6                          /* `@warp list`: a place did not come back to the field, the run ends here (tools/room_sweep.sh goes on) */
static int route_exit_at_end;                             /* KHNMC_ROUTE_END=exit: the run ends (exit 0, with the reports) when the route is done */
u64 kh_phase_damage_hits(void);
/* a condition's value after its `not`: 1 holds, 0 does not, -1 its reader cannot read the state now (KR_UNREADABLE): then neither the
 * condition nor its negation holds (review of task 31: `not` was applied to a failed read, so `@expect not item-slot 1` passed on a
 * sheet nobody could read); a waiting step goes on waiting, an @expect is the named fatal route-condition-unreadable */
static int cond_val(KCtx *g,const Cond *c,u64 n){ int v=cond_fn(g,c->kind,c->arg,n,&step_base); if(v<0) return -1; v=v!=0; return c->neg?!v:v; }
static int cond_true(KCtx *g,const Cond *c,u64 n){ return cond_val(g,c,n)>0; }
static void route_fatal_state(KCtx *g,u64 n,const char *name,const Step *s,const char *what){
    char st[1100]; kh_route_state_summary(g,n,st,sizeof st);
    kh_fatal(g,"%s: %s line %u `%s`: %s (step %zu of %zu, started at game frame %llu, now game frame %llu, present %llu); game state now: %s",
             name,route_path,s->line,s->text,what,cur_step+1,nsteps,(unsigned long long)s->started,(unsigned long long)n,(unsigned long long)atomic_load(&gfx_presents),st);
}
static void step_met(Step *s,u64 n,u64 anchor){
    s->met=n; s->waited=n-s->started; step_anchor=anchor; step_phase=2;
    fprintf(stderr,"kh: route: step %zu/%zu line %u `%s` met at game frame %llu (present %llu, after %llu game frames)\n",cur_step+1,nsteps,s->line,s->text,
            (unsigned long long)n,(unsigned long long)atomic_load(&gfx_presents),(unsigned long long)s->waited);
}
static void route_tick(KCtx *g,u64 n){
    if(!nsteps || route_done) return;
    for(int guard=0;guard<=(int)nsteps+1;guard++){
        if(cur_step>=nsteps){
            route_done=1; memset(&route_pad,0,sizeof route_pad);
            fprintf(stderr,"kh: route: all %zu steps done at game frame %llu (present %llu)\n",nsteps,(unsigned long long)n,(unsigned long long)atomic_load(&gfx_presents));
            if(route_exit_at_end){ extern void kh_exit_process(int); kh_warn("input: KHNMC_ROUTE_END=exit: the route is done, ending the run"); kh_exit_process(0); }
            return;
        }
        Step *s=&steps[cur_step];
        /* The baseline of the counting conditions (frames N, hits N, item-uses N, item-drain, item-heal) is taken when a step starts,
         * EXCEPT for an @expect: it reads in the very tick it starts, so a baseline of its own would always count zero events (`@expect
         * item-drain` could never pass, `@expect not item-drain` never fail: the 2026-11-17 review).  An @expect keeps the baseline of
         * the last step before it that is not an @expect: it checks what that step brought about (`@press A until item-uses 1` then
         * `@expect item-drain`).  Before any such step the baseline is the start of the run. */
        if(step_phase==0){ step_phase=1; step_t0=n; if(s->type!=ST_EXPECT) kh_route_base_now(n,&step_base); s->started=n; sel_from=sel_until=-1;
                           goto_best=1e30f; goto_best_at=n; goto_seen=0; goto_lx=goto_ly=0; fight_a=0; fight_enemies=0; fight_presses=0; fight_pages=0; skip_btn=0; skip_hold=skip_gap=0; skip_starts=skip_skips=skip_moves=skip_pages=0; talk_run=talk_presses=0; talk_msg=0; goto_noobj=0; react_presses=0; react_seen=-1; goto_ox=goto_oz=1e30f;
                           react_landing=0; react_open=react_shut=0; react_why=NULL; }
        if(step_phase==1){
            int cv=s->type==ST_GOTO||s->type==ST_FIGHT||s->type==ST_SKIP||s->type==ST_TALK||s->type==ST_REACT||s->type==ST_WARP||s->type==ST_WARPLIST?0:cond_val(g,&s->c,n), ok=cv>0;   /* @goto / @fight / @skip / @talk / @react read their `until` themselves; @warp has none */
            if(s->type==ST_EXPECT){
                if(cv<0) route_fatal_state(g,n,"route-condition-unreadable",s,"the state this condition reads cannot be read now (no field player or status sheet, no command menu, no item slots): neither it nor its negation can be checked");
                if(!ok) route_fatal_state(g,n,"route-expect-failed",s,"the game is not in this state");
                step_met(s,n,n-1);
                { char st[1100]; kh_route_state_summary(g,n,st,sizeof st); fprintf(stderr,"kh: route: @expect line %u read at game frame %llu: %s\n",s->line,(unsigned long long)n,st); } }   /* what it read: the evidence in the log */
            else if(s->type==ST_WAIT){ if(ok) step_met(s,n,n-1); }
            else if(s->type==ST_PRESS){
                int pressed_last=n-1>=step_t0 && (n-1-step_t0)%s->every<s->hold;
                if(ok) step_met(s,n,pressed_last?n:n-1);        /* keep one released frame before the next press */
            } else if(s->type==ST_GOTO){                       /* walk toward (gx, gz): met within the radius, or when `until` holds */
                int pressed_last=goto_lx||goto_ly; float x,y,z,h,cy;
                goto_lx=goto_ly=0;
                if(s->has_until && cond_true(g,&s->c,n)) step_met(s,n,pressed_last?n:n-1);
                else if(pos_fn(g,&x,&y,&z,&h)){
                    float tx=s->gx,tz=s->gz; int none=0;
                    if(s->to_enemy){ float ex=0,ez=0,ed=0; int ne=enemy_fn(g,x,z,&ex,&ez,&ed); if(ne<=0) none=1; else { tx=ex; tz=ez; } goto_tx=tx; goto_tz=tz; }
                    goto_noobj=0;
                    if(s->to_object){ float ex=0,ez=0,ed=0; int no=object_fn(g,s->obj_name,x,z,&ex,&ez,&ed); if(no<=0) goto_noobj=1; else { tx=ex; tz=ez; goto_tx=tx; goto_tz=tz; } }
                    float d=hypotf(x-tx,z-tz); goto_seen=1; goto_x=x; goto_z=z;
                    if(goto_noobj){ }                                                  /* no object of that name (yet): stand, the stall clock runs: a named fatal, never a walk to nowhere */
                    else { goto_d=d;
                    if(d+GOTO_PROGRESS<=goto_best || (s->to_object && hypotf(tx-goto_ox,tz-goto_oz)>=GOTO_PROGRESS)){ goto_best=d; goto_best_at=n; goto_ox=tx; goto_oz=tz; }   /* task 31: an object that moves on (a guide who keeps his distance) is followed, not a stall */
                    if(none || d<=s->radius) step_met(s,n,pressed_last?n:n-1);      /* @goto enemy: no enemy left = nothing to walk to */
                    else if((goto_have_cam=yaw_fn(g,&cy))){ goto_cam=cy; kh_route_goto_stick(x,z,tx,tz,cy,d<2.0f*s->radius?0.6f:1.0f,&goto_lx,&goto_ly); } }
                }
                if(step_phase==1 && n-goto_best_at>=s->stall){
                    char what[400];
                    if(goto_seen && goto_noobj) snprintf(what,sizeof what,"no object named %s is in the object list (for %llu game frames without progress): the player is at (%.0f, %.0f)",s->obj_name,(unsigned long long)s->stall,goto_x,goto_z);
                    else if(goto_seen && s->to_object) snprintf(what,sizeof what,"no progress toward the object %s (%.0f, %.0f) for %llu game frames: the player is at (%.0f, %.0f), %.0f away; the closest was %.0f at game frame %llu; camera yaw %s%.3f",
                                           s->obj_name,goto_tx,goto_tz,(unsigned long long)s->stall,goto_x,goto_z,goto_d,goto_best,(unsigned long long)goto_best_at,goto_have_cam?"":"(unreadable) ",goto_cam);
                    else if(goto_seen) snprintf(what,sizeof what,"no progress toward %s(%.0f, %.0f) for %llu game frames: the player is at (%.0f, %.0f), %.0f away; the closest was %.0f at game frame %llu; camera yaw %s%.3f",
                                           s->to_enemy?"the nearest enemy ":"",s->to_enemy?goto_tx:s->gx,s->to_enemy?goto_tz:s->gz,(unsigned long long)s->stall,goto_x,goto_z,goto_d,goto_best,(unsigned long long)goto_best_at,goto_have_cam?"":"(unreadable) ",goto_cam);
                    else snprintf(what,sizeof what,"the player's position could not be read for %llu game frames (no field player)",(unsigned long long)s->stall);
                    route_fatal_state(g,n,"route-goto-stalled",s,what);
                }
            } else if(s->type==ST_TALK){                       /* answer message windows with A until COND has held `stable` frames in a row */
                int pressed_last=skip_btn!=0; Cond msg={KR_MESSAGE,-1,0};
                talk_run=cond_true(g,&s->c,n)?talk_run+1:0; talk_msg=cond_true(g,&msg,n);
                if(talk_run>=s->stable){ skip_btn=0; step_met(s,n,pressed_last?n:n-1); }
                else if(skip_hold>0) skip_hold--;
                else if(skip_gap>0){ skip_btn=0; skip_gap--; }
                else if(talk_msg){ skip_btn=0x1000; talk_presses++; skip_hold=(int)s->hold-1; skip_gap=(int)(s->every-s->hold); }   /* A: the next page / the answer */
                else skip_btn=0;
            } else if(s->type==ST_REACT){                      /* answer the reaction command the menu offers (Y) until COND */
                int pressed_last=skip_btn!=0; KhReaction rc; int usable=reaction_fn(g,&rc)>0, mine=rc.offered; char tn[40]="";
                if(rc.offered) react_name_fn(g,&rc,tn,sizeof tn);
                if(mine && s->react_id>=0 && rc.cmd!=s->react_id) mine=0;
                if(mine && s->to_object && strcmp(tn,s->obj_name)) mine=0;                    /* another object's command: not answered */
                int off=usable && mine;
                /* (review of task 31) the press decided at the last tick came in the game frame that just ended, and the game's reaction
                 * handler 0x408520 picked its entry again at that frame's start, before 0x3b2340 tested the button: the entry now is the
                 * one the press met (0x3b22d0, the answer, does not write it).  When that is an answerable command the step does not
                 * answer (another command, another object's), the press may have answered it: a named fatal, never a silent wrong answer. */
                if(react_landing){ react_landing=0;
                    if(usable && !mine && (s->react_id>=0 || s->to_object)){ char what[400], want[80];
                        if(s->react_id>=0 && s->to_object) snprintf(want,sizeof want,"command %d on %s",s->react_id,s->obj_name);
                        else if(s->react_id>=0) snprintf(want,sizeof want,"command %d",s->react_id); else snprintf(want,sizeof want,"a command on %s",s->obj_name);
                        snprintf(what,sizeof what,"the reaction button pressed for game frame %llu met another reaction command than the step answers: in that frame the game's entry was command %d on %s, "
                                 "answerable; the step answers only %s (what it saw when it pressed)",(unsigned long long)(n-1),rc.cmd,tn[0]?tn:"an object without a model name",want);
                        route_fatal_state(g,n,"route-react-other-command",s,what); } }
                react_seen=rc.offered?rc.cmd:-1; react_why=rc.offered&&!usable?(rc.closed?rc.closed:"refused"):NULL;
                if(off) react_open++; else if(mine) react_shut++;                            /* an offer of what the step answers, answerable or not */
                if(cond_true(g,&s->c,n)){ skip_btn=0; step_met(s,n,pressed_last?n:n-1); }
                else if(skip_hold>0) skip_hold--;
                else if(skip_gap>0){ skip_btn=0; skip_gap--; }
                else if(off){ skip_btn=REACT_BUTTON; react_presses++; react_landing=1; skip_hold=(int)s->hold-1; skip_gap=(int)(s->every-s->hold); }
                else skip_btn=0;
            } else if(s->type==ST_SKIP){                       /* skip events through the pause screen until COND */
                int pressed_last=skip_btn!=0;
                if(cond_true(g,&s->c,n)){ skip_btn=0; step_met(s,n,pressed_last?n:n-1); }
                else if(skip_hold>0) skip_hold--;                                  /* the current press goes on */
                else if(skip_gap>0){ skip_btn=0; skip_gap--; }                       /* released frames before the next press */
                else { KhPauseMenu pm; Cond msg={KR_MESSAGE,-1,0};
                    if(!pause_fn(g,&pm) && cond_true(g,&msg,n)){        /* task 31: a message window waits (START does nothing then): a page is answered with A, a choice is the route's to answer */
                        if(cursor_fn(g,KR_MESSAGE_CHOICE)>=0) route_fatal_state(g,n,"route-skip-choice",s,"a message window asks for a choice: @skip answers pages only; answer it with `@select message-choice N` and a press of A");
                        skip_btn=0x1000; skip_pages++; skip_gap=20; }
                    else if(pause_fn(g,&pm)){ int want=-1; for(int i=0;i<pm.rows;i++) if(pm.id[i]==SKIP_ROW) want=i;
                        if(want<0){ char what[300]; size_t o=(size_t)snprintf(what,sizeof what,"the pause screen is up without a row to skip an event (id %d); its rows:",SKIP_ROW);
                            for(int i=0;i<pm.rows && o<sizeof what-8;i++) o+=(size_t)snprintf(what+o,sizeof what-o," %u",(unsigned)pm.id[i]);
                            route_fatal_state(g,n,"route-skip-no-skip-row",s,what); }
                        if(pm.cursor==want){ skip_btn=0x1000; skip_skips++; skip_gap=s->every; }          /* A on "skip" */
                        else { skip_btn=pm.cursor>=0&&pm.cursor<want?0x2:0x1; skip_moves++; skip_gap=4; }   /* DPAD_DOWN / DPAD_UP one row */
                    } else { skip_btn=0x10; skip_starts++; skip_gap=s->every; }                      /* START: open the pause screen */
                    skip_hold=(int)s->hold-1; }
            } else if(s->type==ST_FIGHT){                      /* walk to the nearest enemy, attack it within the radius, until COND */
                int pressed_last=goto_lx||goto_ly||fight_a, was_a=fight_a; float x,y,z,h,cy;
                goto_lx=goto_ly=0; fight_a=0;
                Cond fmsg={KR_MESSAGE,-1,0};
                if(cond_true(g,&s->c,n)) step_met(s,n,pressed_last?n:n-1);
                else if(cond_true(g,&fmsg,n)){                  /* task 31: a message window waits in the fight (a tutorial page: run-Q31/x31 stood before one with no enemy left): A on the attack cadence; a choice is the route's to answer */
                    if(cursor_fn(g,KR_MESSAGE_CHOICE)>=0) route_fatal_state(g,n,"route-fight-choice",s,"a message window asks for a choice during the fight: answer it with `@select message-choice N` and a press of A");
                    goto_best=1e30f; goto_best_at=n;
                    if((n-step_t0)%s->every<s->hold){ fight_a=1; if(!was_a) fight_pages++; } }
                else if(pos_fn(g,&x,&y,&z,&h)){
                    float ex=0,ez=0,ed=0; int ne=enemy_fn(g,x,z,&ex,&ez,&ed); goto_seen=1; goto_x=x; goto_z=z; fight_enemies=ne;
                    if(ne<=0){ goto_best=1e30f; goto_best_at=n; }                 /* nothing to fight: stand still, no A (it would talk to whoever stands near) */
                    else { float d=hypotf(x-ex,z-ez); goto_tx=ex; goto_tz=ez; goto_d=d;
                        if(d<=s->radius){ goto_best=1e30f; goto_best_at=n;           /* in reach: attack, as @press A every P hold H */
                            if((n-step_t0)%s->every<s->hold){ fight_a=1; if(!was_a) fight_presses++; } }
                        else { if(d+GOTO_PROGRESS<=goto_best || d>goto_best+FIGHT_SETBACK){ goto_best=d; goto_best_at=n; }   /* knocked back, or the enemy moved off: a new approach */
                            if((goto_have_cam=yaw_fn(g,&cy))){ goto_cam=cy; kh_route_goto_stick(x,z,ex,ez,cy,d<2.0f*s->radius?0.6f:1.0f,&goto_lx,&goto_ly); } } }
                } else { goto_best=1e30f; goto_best_at=n; }                       /* no field player (a map change, a menu): wait, the time-out still runs */
                if(step_phase==1 && n-goto_best_at>=s->stall){
                    char what[400]; snprintf(what,sizeof what,"no progress toward the nearest enemy (%.0f, %.0f) for %llu game frames: the player is at (%.0f, %.0f), %.0f away; the closest was %.0f at game frame %llu; %d enemies; camera yaw %s%.3f",
                                             goto_tx,goto_tz,(unsigned long long)s->stall,goto_x,goto_z,goto_d,goto_best,(unsigned long long)goto_best_at,fight_enemies,goto_have_cam?"":"(unreadable) ",goto_cam);
                    route_fatal_state(g,n,"route-goto-stalled",s,what);
                }
            } else if(s->type==ST_WARP||s->type==ST_WARPLIST){   /* task 33: the debug warp, one place after the other (runtime/warp.c) */
                if(!warp_watching){ KhWarpTarget t=s->warp[s->warp_i]; if(s->type==ST_WARP) t.line=s->line; kh_warp_begin(g,++warp_seq,&t,n); warp_watching=1; }
                char what[600]; int r=kh_warp_tick(g,n,s->settle,s->timeout,what,sizeof what);
                if(r>0){ warp_watching=0; if(++s->warp_i>=s->nwarp) step_met(s,n,n-1); }
                else if(r<0){
                    warp_watching=0;
                    if(s->type==ST_WARP) route_fatal_state(g,n,"route-warp-failed",s,what);
                    fprintf(stderr,"kh: warp: list stopped at entry %zu of %zu (list line %u `%s`): %s; the %zu entries after it are not warped in this run\n",
                            s->warp_i+1,s->nwarp,s->warp[s->warp_i].line,s->warp[s->warp_i].text,what,s->nwarp-s->warp_i-1);
                    extern void kh_exit_process(int); kh_exit_process(WARP_LIST_STOPPED_EXIT);       /* prints the route report (debug warps) */
                }
            } else {                                           /* ST_SELECT: move the cursor one row at a time until it is on the row */
                int pressing=sel_from>=0 && (long long)n-1<sel_until;
                int v=cursor_fn(g,s->c.kind), want=target_fn(g,s->c.kind,s->c.arg);
                if(!pressing){
                    if(v>=0 && v==want) step_met(s,n,n-1);
                    else if(v>=0 && want>=0 && (sel_from<0 || ((long long)n>=sel_until+2 && (v!=sel_v0 || (long long)n>=sel_until+20)))){
                        sel_from=(long long)n; sel_until=(long long)n+(long long)s->hold; sel_dir=v<want?1:0; sel_v0=v;   /* bit 1 = DPAD_DOWN, bit 0 = DPAD_UP */
                    }
                }
            }
            if(step_phase==1){
                if(s->type!=ST_WARP && s->type!=ST_WARPLIST && n-s->started>=s->timeout){      /* @warp: a time-out per place, kept by runtime/warp.c */
                    char what[800];
                    if(s->type==ST_SELECT && s->c.kind==KR_PAUSE_ID) snprintf(what,sizeof what,"the pause screen's cursor did not reach the row with id %d within %llu game frames; "
                                                     "that row is %d (-1 = no such row or the screen is not up), the cursor is on row %d",s->c.arg,(unsigned long long)s->timeout,target_fn(g,s->c.kind,s->c.arg),cursor_fn(g,s->c.kind));
                    else if(s->type==ST_SELECT && s->c.kind==KR_COMMAND_ID) snprintf(what,sizeof what,"the command menu's cursor did not reach a row of command %d within %llu game frames; "
                                                     "that row is %d (-1 = the top list has no such row), the cursor is on row %d (-1 = not up)",s->c.arg,(unsigned long long)s->timeout,target_fn(g,s->c.kind,s->c.arg),cursor_fn(g,s->c.kind));
                    else if(s->type==ST_SELECT) snprintf(what,sizeof what,"the cursor (%s) did not reach row %d within %llu game frames; it is on row %d (-1 = not up)",
                                                     kh_route_cond_info[s->c.kind].name,s->c.arg,(unsigned long long)s->timeout,cursor_fn(g,s->c.kind));
                    else if(s->type==ST_GOTO && s->to_object) snprintf(what,sizeof what,"the player did not get within %.0f of the object %s %s(%.0f, %.0f) within %llu game frames%s; %s at (%.0f, %.0f), %.0f away",
                                                     s->radius,s->obj_name,goto_noobj?"(not in the object list now; last seen at) ":"",goto_tx,goto_tz,(unsigned long long)s->timeout,s->has_until?" and `until` did not hold":"",goto_seen?"last seen":"never seen",goto_x,goto_z,goto_d);
                    else if(s->type==ST_REACT) snprintf(what,sizeof what,"what the reaction command leads to (%s%s) did not come within %llu game frames; the reaction button was pressed %llu times; the command menu offers %s now (command %d)%s%s%s; "
                                                     "game frames with an offer of what the step answers: %llu answerable, %llu seen but not answerable%s",
                                                     s->c.neg?"NOT: ":"",kh_route_cond_info[s->c.kind].what,(unsigned long long)s->timeout,(unsigned long long)react_presses,react_seen>=0?"a reaction command":"no reaction command",react_seen,
                                                     react_why?", which cannot be answered now: ":"",react_why?react_why:"",
                                                     s->react_id>=0||s->to_object?"; the step answers only the command / the object it names":"",(unsigned long long)react_open,(unsigned long long)react_shut,
                                                     react_shut&&!react_open?" (an offer was there, never answerable: see the reason)":"");
                    else if(s->type==ST_GOTO) snprintf(what,sizeof what,"the player did not get within %.0f of %s(%.0f, %.0f) within %llu game frames%s; %s at (%.0f, %.0f), %.0f away",
                                                     s->radius,s->to_enemy?"the nearest enemy ":"",s->to_enemy?goto_tx:s->gx,s->to_enemy?goto_tz:s->gz,(unsigned long long)s->timeout,s->has_until?" and `until` did not hold":"",goto_seen?"last seen":"never seen",goto_x,goto_z,goto_d);
                    else if(s->type==ST_TALK) snprintf(what,sizeof what,"the end of the dialogue (%s%s for %llu game frames in a row) did not come within %llu game frames; A pressed %llu times; a message %s now",
                                                     s->c.neg?"NOT: ":"",kh_route_cond_info[s->c.kind].what,(unsigned long long)s->stable,(unsigned long long)s->timeout,(unsigned long long)talk_presses,talk_msg?"waits":"does not wait");
                    else if(s->type==ST_SKIP) snprintf(what,sizeof what,"the end of the events (%s%s) did not come within %llu game frames; START pressed %llu times, \"skip\" chosen %llu times, cursor moved %llu times, %llu message pages answered",
                                                     s->c.neg?"NOT: ":"",kh_route_cond_info[s->c.kind].what,(unsigned long long)s->timeout,(unsigned long long)skip_starts,(unsigned long long)skip_skips,(unsigned long long)skip_moves,(unsigned long long)skip_pages);
                    else if(s->type==ST_FIGHT) snprintf(what,sizeof what,"the fight's end (%s%s) did not come within %llu game frames; %d enemies at the last look%s, %llu attacks pressed; the player %s at (%.0f, %.0f)%s",
                                                     s->c.neg?"NOT: ":"",kh_route_cond_info[s->c.kind].what,(unsigned long long)s->timeout,fight_enemies,fight_enemies>0?"":" (none to walk to)",(unsigned long long)fight_presses,goto_seen?"last seen":"never seen",goto_x,goto_z,
                                                     fight_pages?"; message pages were answered during it":"");
                    else snprintf(what,sizeof what,"%s%s never came within %llu game frames%s",s->c.neg?"NOT: ":"",kh_route_cond_info[s->c.kind].what,(unsigned long long)s->timeout,
                                  cond_val(g,&s->c,n)<0?" (its reader cannot read the state now: neither it nor its negation holds)":"");
                    route_fatal_state(g,n,"route-wait-timeout",s,what);
                }
                break;
            }
        }
        /* step_phase == 2: the relative presses; done once the frame after the last one (released) has ended.  Without relative lines:
         * at once, or (route_pad = the pad of the frame that just ended) after one released frame, which phase 2 publishes */
        if(s->nrel ? n-1>=step_anchor+s->maxb+1 : !(route_pad.buttons||route_pad.lt||route_pad.rt)){ cur_step++; step_phase=0; continue; }
        break;
    }
    ScriptPad pad={0};
    if(!route_done && cur_step<nsteps){
        Step *s=&steps[cur_step];
        if(step_phase==2){ for(size_t i=0;i<s->nrel;i++) if(n>=step_anchor+s->rel[i].a && n<=step_anchor+s->rel[i].b) pad=s->rel[i].pad; }
        else if(step_phase==1 && s->type==ST_PRESS){ pad=s->held;                                   /* the held buttons stay down between the presses */
            if(n>=step_t0 && (n-step_t0)%s->every<s->hold){ pad=s->pad; pad.buttons|=s->held.buttons; if(s->held.lt) pad.lt=s->held.lt; if(s->held.rt) pad.rt=s->held.rt; } }
        else if(step_phase==1 && s->type==ST_SELECT && sel_from>=0 && (long long)n>=sel_from && (long long)n<sel_until) pad.buttons=sel_dir?0x2:0x1;
        else if(step_phase==1 && s->type==ST_GOTO){ pad.lx=goto_lx; pad.ly=goto_ly; }
        else if(step_phase==1 && s->type==ST_FIGHT){ pad.lx=goto_lx; pad.ly=goto_ly; if(fight_a) pad.buttons=0x1000; }      /* A (bit 12) */
        else if(step_phase==1 && (s->type==ST_SKIP||s->type==ST_TALK||s->type==ST_REACT)) pad.buttons=skip_btn;
    }
    pthread_mutex_lock(&input_lock); route_pad=pad; pthread_mutex_unlock(&input_lock);
}
static void route_report(FILE *f){
    size_t done=0; for(size_t i=0;i<nsteps;i++) if(steps[i].met) done++;
    fprintf(f,"kh: route report: %zu of %zu steps done%s; difficulty %d%s; met at game frame:",done,nsteps,route_done?"":" -- ROUTE INCOMPLETE",route_difficulty,route_difficulty_from);
    int warps=0; for(size_t i=0;i<nsteps;i++) if(steps[i].type==ST_WARP||steps[i].type==ST_WARPLIST) warps=1;
    for(size_t i=0;i<nsteps;i++) if(steps[i].met) fprintf(f," L%u:%s=%llu",steps[i].line,steps[i].type==ST_SELECT?"select":steps[i].type==ST_GOTO?"goto":steps[i].type==ST_FIGHT?"fight":steps[i].type==ST_SKIP?"skip":steps[i].type==ST_TALK?"talk":steps[i].type==ST_REACT?"react":
                                                         steps[i].type==ST_WARP?"warp":steps[i].type==ST_WARPLIST?"warp-list":kh_route_cond_info[steps[i].c.kind].name,(unsigned long long)steps[i].met);
    if(!route_done && cur_step<nsteps) fprintf(f,"; waiting at line %u `%s` since game frame %llu",steps[cur_step].line,steps[cur_step].text,(unsigned long long)steps[cur_step].started);
    if(warps){ u64 rq=0,fd=0,jo=0,fl=0; kh_warp_counts(&rq,&fd,&jo,&fl);
        fprintf(f,"; debug warps %llu (field reached %llu, jumped on by the room's own program %llu, failed %llu; a TEST TOOL: a result after a warp says this room loads from this state, "
                  "not that the game reaches it)",(unsigned long long)rq,(unsigned long long)fd,(unsigned long long)jo,(unsigned long long)fl); }
    fputc('\n',f);
}
void kh_input_report(FILE *f){
    if(!scripted) return;
    fprintf(f,"kh: input report: presents=%llu game-frames=%llu last-script-frame=%llu clock=%s hold=%s\n",(unsigned long long)atomic_load(&gfx_presents),(unsigned long long)atomic_load(&game_frames),
            (unsigned long long)atomic_load(&last_script_frame),nsteps?"game-frames (route)":clock_game?"game-frames":"presents",hold_frame<0?"none":atomic_load(&hold_released)?"released":"NEVER RELEASED (the awaited state was not reached)");
    if(nsteps) route_report(f);
}
int kh_input_hold_pending(void){ return scripted && hold_frame>=0 && !atomic_load(&hold_released); }
/* Task 31 (the 2026-11-17 review): an input script that was not played to its end is no success.  Why it was not ("" = it was, or
 * there is no script): a route with steps left, a hold that was never released, or a frame-numbered script whose clock never reached
 * the last frame of its ranges. */
static int script_unfinished(char *why,size_t cap){
    if(cap) why[0]=0;
    if(!scripted) return 0;
    if(nsteps){
        if(route_done) return 0;
        size_t done=0; for(size_t i=0;i<nsteps;i++) if(steps[i].met) done++;
        if(cur_step<nsteps) snprintf(why,cap,"the route %s is not done: %zu of %zu steps met, waiting at line %u `%s` since game frame %llu",route_path,done,nsteps,steps[cur_step].line,steps[cur_step].text,(unsigned long long)steps[cur_step].started);
        else snprintf(why,cap,"the route %s is not done: %zu of %zu steps met (its end was not reached by a game frame)",route_path,done,nsteps);
        return 1; }
    if(hold_frame>=0 && !atomic_load(&hold_released)){
        snprintf(why,cap,"%s line %u `@hold %lld until initial-state %d` was never released: the Initial Settings screen never reached state %d, no script frame from %lld on was played",
                 route_path,hold_line,hold_frame,hold_state,hold_state,hold_frame);
        return 1; }
    u64 last=0; for(size_t i=0;i<nranges;i++) if(ranges[i].end>last) last=ranges[i].end;
    u64 at=atomic_load(&last_script_frame);
    if(nranges && at<last){ snprintf(why,cap,"%s: the script's last frame %llu was not reached: its clock stopped at script frame %llu",route_path,(unsigned long long)last,(unsigned long long)at); return 1; }
    return 0;
}
/* the run's exit status (runtime/loader.c kh_exit_process): 0 becomes 3, the status of a named fatal, when the script is unfinished */
int kh_input_exit_status(int code,FILE *f){
    char why[900]; if(code!=0 || !script_unfinished(why,sizeof why)) return code;
    fprintf(f,"kh: FATAL: input-script-unfinished: %s; the run ends with status 3 instead of 0\n",why); return 3;
}
static int parse_buttons(char *w,ScriptPad *pad){
    if(!strcmp(w,"-")) return 1;
    size_t len=strlen(w); if(!len || w[0]=='+'||w[len-1]=='+'||strstr(w,"++")) return 0;
    char *bs; for(char *b=strtok_r(w,"+",&bs);b;b=strtok_r(NULL,"+",&bs)){
        int bit; for(bit=0;bit<18;bit++) if(button_names[bit]&&!strcmp(b,button_names[bit])) break;
        if(bit==18) return 0;
        if(bit==16) pad->lt=255; else if(bit==17) pad->rt=255; else pad->buttons|=1u<<bit;
    }
    return 1;
}
/* `[not] NAME [ARG]` from words[*i]; ARG may be `difficulty`.  0 + a reason on error */
static int parse_cond(char **words,int n,int *i,Cond *c,const char **why){
    c->neg=0; c->arg=-1;
    if(*i<n && !strcmp(words[*i],"not")){ c->neg=1; (*i)++; }
    if(*i>=n){ *why="a condition is missing"; return 0; }
    c->kind=kh_route_cond_lookup(words[*i]);
    if(c->kind<0){ static char known[1500]; size_t o=(size_t)snprintf(known,sizeof known,"unknown condition (known:");
        for(int k=0;k<KR_NCOND && o<sizeof known;k++) o+=(size_t)snprintf(known+o,sizeof known-o," %s",kh_route_cond_info[k].name);
        if(o<sizeof known) snprintf(known+o,sizeof known-o,")"); *why=known; return 0; }
    (*i)++;
    const KhRouteCondInfo *ci=&kh_route_cond_info[c->kind];
    if(ci->has_arg==2){                                     /* task 31: a name (an object's model name) */
        if(*i>=n){ *why="this condition takes an object's model name"; return 0; }
        c->arg=kh_route_name_intern(words[*i]);
        if(c->arg<0){ *why="the condition's name is too long (39 characters at most) or the route names more than 32 different objects"; return 0; }
        (*i)++;
    } else if(ci->has_arg){
        long long v;
        if(*i>=n){ *why="this condition takes a number"; return 0; }
        if(!strcmp(words[*i],"difficulty") && ci->hi>=3 && ci->lo==0) c->arg=ARG_DIFFICULTY;
        else if(number(words[*i],ci->lo,ci->hi,&v)) c->arg=(int)v;
        else if(words[*i][0]=='0' && words[*i][1]=='x' && words[*i][2]){ char *e; errno=0; v=strtoll(words[*i]+2,&e,16);       /* task 30: 0x1301 (program ids are hex in the area data) */
            if(errno || *e || v<ci->lo || v>ci->hi){ *why="the condition's number is out of range"; return 0; } c->arg=(int)v; }
        else { *why="the condition's number is out of range"; return 0; }
        (*i)++;
    }
    return 1;
}
static void route_free(void){ for(size_t i=0;i<nsteps;i++){ free(steps[i].rel); free(steps[i].warp); } free(steps); steps=NULL; nsteps=0; }
void kh_input_load(KCtx *g,const char *path){
    free(ranges); ranges=NULL; nranges=0; scripted=path!=NULL; packet=0; memset(&last_pad,0,sizeof last_pad);
    hold_frame=-1; hold_state=-1; atomic_store(&hold_shift,0); atomic_store(&hold_released,0); clock_game=0;
    route_free(); cur_step=0; step_phase=0; route_done=0; warp_watching=0; warp_seq=0; kh_warp_reset_counts(); memset(&route_pad,0,sizeof route_pad); route_difficulty=-1; route_difficulty_from=""; sel_from=sel_until=-1;
    memset(&step_base,0,sizeof step_base); hold_timeout=HOLD_TIMEOUT_DEFAULT; hold_line=0;
    if(!path) return;
    snprintf(route_path,sizeof route_path,"%s",path);
    FILE *f=fopen(path,"r"); if(!f) kh_fatal(g,"scripted XInput: cannot open %s",path);
    char line[1024], text[1024]; unsigned lineno=0, first_frame_line=0; u64 timeout_default=3600; int uses_difficulty=0;
    const char *why="";
    while(fgets(line,sizeof line,f)){
        lineno++; why="";
        if(strlen(line)==sizeof line-1 && line[sizeof line-2]!='\n') goto invalid;
        char *comment=strchr(line,'#'); if(comment) *comment=0;
        snprintf(text,sizeof text,"%s",line); { char *e=text+strlen(text); while(e>text && (e[-1]=='\n'||e[-1]=='\r'||e[-1]==' '||e[-1]=='\t')) *--e=0; }
        char *t0=text; while(*t0==' '||*t0=='\t') t0++;
        char *words[20],*save; int n=0;
        for(char *w=strtok_r(line," \t\r\n",&save);w;w=strtok_r(NULL," \t\r\n",&save)){
            if(n==20) goto invalid; words[n++]=w;
        }
        if(!n) continue;
        int only=-1;                                        /* task 31: `@if-difficulty N STEP`: the step exists only in a run of that difficulty */
        if(!strcmp(words[0],"@if-difficulty")){ long long v;
            if(n<3 || !number(words[1],0,3,&v) || words[2][0]!='@' || !strcmp(words[2],"@if-difficulty") || !strcmp(words[2],"@difficulty") || !strcmp(words[2],"@timeout") || !strcmp(words[2],"@hold") || !strcmp(words[2],"@clock")){
                why="@if-difficulty N STEP: N is 0..3 and STEP a route step (@wait, @expect, @press, ...)"; goto invalid; }
            only=(int)v; for(int k=2;k<n;k++) words[k-2]=words[k]; n-=2;
            t0=strstr(t0,words[0]) ? strstr(t0,"@")+1 : t0; { char *q=strchr(t0,'@'); if(q) t0=q; } }
        if(!strcmp(words[0],"@hold")){
            long long hf,hs;
            long long ht=HOLD_TIMEOUT_DEFAULT;
            if((n!=5&&n!=7)||strcmp(words[2],"until")||strcmp(words[3],"initial-state")||!number(words[1],1,LLONG_MAX/4,&hf)||!number(words[4],0,63,&hs)||hold_frame>=0) goto invalid;
            if(n==7 && (strcmp(words[5],"timeout")||!number(words[6],1,100000000,&ht))){ why="@hold FRAME until initial-state N [timeout T]: T is a number of presents (1..100000000)"; goto invalid; }
            hold_frame=hf; hold_state=(int)hs; hold_timeout=ht; hold_line=lineno; if(!first_frame_line) first_frame_line=lineno; continue;
        }
        if(!strcmp(words[0],"@clock")){ if(n!=2||strcmp(words[1],"game-frames")||clock_game) goto invalid; clock_game=1; if(!first_frame_line) first_frame_line=lineno; continue; }
        if(!strcmp(words[0],"@timeout")){ long long v; if(n!=2||!number(words[1],1,100000000,&v)){ why="@timeout takes a number of game frames"; goto invalid; } timeout_default=(u64)v; continue; }
        if(!strcmp(words[0],"@difficulty")){ long long v; if(n!=2||!number(words[1],0,3,&v)||route_difficulty>=0){ why="@difficulty takes 0..3, once"; goto invalid; } route_difficulty=(int)v; route_difficulty_from=" (@difficulty)"; continue; }
        if(!strcmp(words[0],"@wait")||!strcmp(words[0],"@expect")||!strcmp(words[0],"@press")||!strcmp(words[0],"@select")||!strcmp(words[0],"@goto")||!strcmp(words[0],"@fight")||!strcmp(words[0],"@skip")||!strcmp(words[0],"@talk")||!strcmp(words[0],"@react")||!strcmp(words[0],"@warp")){
            Step st; memset(&st,0,sizeof st); st.line=lineno; st.timeout=timeout_default; st.every=8; st.hold=2; st.radius=100.0f; st.stall=240; st.c.kind=-1; st.react_id=-1; st.only=only;
            snprintf(st.text,sizeof st.text,"%s",t0);
            int i=1;
            if(!strcmp(words[0],"@wait")||!strcmp(words[0],"@expect")){
                st.type=words[0][1]=='w'?ST_WAIT:ST_EXPECT;
                if(!parse_cond(words,n,&i,&st.c,&why)) goto invalid;
            } else if(!strcmp(words[0],"@press")){
                st.type=ST_PRESS;
                if(n<4 || !parse_buttons(words[1],&st.pad) || !st.pad.buttons&&!st.pad.lt&&!st.pad.rt){ why="@press BUTTONS [lx ly] until COND: bad buttons"; goto invalid; }
                i=2; long long x,y;
                if(i+1<n && number(words[i],-32768,32767,&x) && number(words[i+1],-32768,32767,&y)){ st.pad.lx=(s16)x; st.pad.ly=(s16)y; i+=2; }
                if(i+1<n && !strcmp(words[i],"held")){               /* task 31: buttons kept down for the whole step (a modifier: R2 + square) */
                    if(!parse_buttons(words[i+1],&st.held) || !st.held.buttons&&!st.held.lt&&!st.held.rt){ why="@press BUTTONS held BUTTONS until COND: bad held buttons"; goto invalid; }
                    if(st.held.buttons&st.pad.buttons || st.held.lt&&st.pad.lt || st.held.rt&&st.pad.rt){ why="@press BUTTONS held BUTTONS: a button cannot be both pressed and held"; goto invalid; }
                    i+=2; }
                if(i>=n||strcmp(words[i],"until")){ why="@press BUTTONS [lx ly] [held BUTTONS] until COND"; goto invalid; }
                i++; if(!parse_cond(words,n,&i,&st.c,&why)) goto invalid;
            } else if(!strcmp(words[0],"@goto")){                 /* @goto X Z [radius R] [until COND] [stall N] [timeout N] */
                st.type=ST_GOTO; double v; char *e;
                if(n>=2 && !strcmp(words[1],"enemy")){ st.to_enemy=1; i=2; }
                else if(n>=2 && !strcmp(words[1],"object")){                           /* task 31: @goto object NAME */
                    if(n<3 || strlen(words[2])>=sizeof st.obj_name || !strcmp(words[2],"radius") || !strcmp(words[2],"until") || !strcmp(words[2],"stall") || !strcmp(words[2],"timeout")){
                        why="@goto object NAME: NAME is an object's model name (at most 39 characters), e.g. N_EX760_TT_SHOP_ACCE"; goto invalid; }
                    st.to_object=1; snprintf(st.obj_name,sizeof st.obj_name,"%s",words[2]); i=3; }
                else {
                    if(n<3){ why="@goto X Z|enemy [radius R] [until COND] [stall N] [timeout N]"; goto invalid; }
                    for(int k=1;k<=2;k++){ errno=0; v=strtod(words[k],&e); if(errno||e==words[k]||*e||!isfinite(v)||v<-1e6||v>1e6){ why="@goto X Z: X and Z are map coordinates (numbers)"; goto invalid; } if(k==1) st.gx=(float)v; else st.gz=(float)v; }
                    i=3;
                }
                while(i<n){
                    if(!strcmp(words[i],"until")){ if(st.has_until){ why="@goto: one `until` only"; goto invalid; } i++; if(!parse_cond(words,n,&i,&st.c,&why)) goto invalid; st.has_until=1; continue; }
                    long long w; if(i+1>=n || !number(words[i+1],1,100000000,&w)){ why="@goto: radius, stall and timeout take a number"; goto invalid; }
                    if(!strcmp(words[i],"radius")) st.radius=(float)w; else if(!strcmp(words[i],"stall")) st.stall=(u64)w; else if(!strcmp(words[i],"timeout")) st.timeout=(u64)w;
                    else { why="unknown option for @goto (radius, until, stall, timeout)"; goto invalid; }
                    i+=2;
                }
            } else if(!strcmp(words[0],"@warp")){                 /* task 33: the debug warp, a TEST TOOL (runtime/warp.c; input/README.md) */
                st.settle=KH_WARP_SETTLE_DEFAULT;
                if(n>=2 && !strcmp(words[1],"list")){             /* @warp list FILE [settle S] [timeout T] */
                    st.type=ST_WARPLIST;
                    if(n<3){ why="@warp list FILE [settle S] [timeout T]"; goto invalid; }
                    char lp[1024]; const char *slash=strrchr(path,'/');
                    if(words[2][0]=='/' || !slash) snprintf(lp,sizeof lp,"%s",words[2]);     /* relative: next to the route file */
                    else snprintf(lp,sizeof lp,"%.*s/%s",(int)(slash-path),path,words[2]);
                    i=3;
                    while(i<n){ long long w; if(i+1>=n || !number(words[i+1],1,100000000,&w)){ why="@warp list: settle and timeout take a number of game frames"; goto invalid; }
                        if(!strcmp(words[i],"settle")) st.settle=(u64)w; else if(!strcmp(words[i],"timeout")) st.timeout=(u64)w;
                        else { why="unknown option for @warp list (settle, timeout)"; goto invalid; }
                        i+=2; }
                    static char lwhy[700];
                    if(!kh_warp_list_load(lp,&st.warp,&st.nwarp,lwhy,sizeof lwhy)){ why=lwhy; goto invalid; }
                } else {                                          /* @warp WORLD ROOM [door N] [map N] [btl N] [evt N] [settle S] [timeout T] */
                    st.type=ST_WARP; KhWarpTarget t;
                    if(!kh_warp_parse(words,n,&i,&t,1,&st.settle,&st.timeout,&why)) goto invalid;
                    t.line=lineno; snprintf(t.text,sizeof t.text,"%s",t0);
                    st.warp=malloc(sizeof t); if(!st.warp) kh_fatal(g,"scripted XInput: allocation failed"); st.warp[0]=t; st.nwarp=1;
                }
            } else if(!strcmp(words[0],"@talk")){                 /* @talk until COND [every P] [hold H] [stable S] [timeout N] (task 30) */
                st.type=ST_TALK; st.every=20; st.hold=2; st.stable=30;
                if(n<3 || strcmp(words[1],"until")){ why="@talk until COND [every P] [hold H] [stable S] [timeout N]"; goto invalid; }
                i=2; if(!parse_cond(words,n,&i,&st.c,&why)) goto invalid; st.has_until=1;
                while(i<n){ long long w; if(i+1>=n || !number(words[i+1],1,100000000,&w)){ why="@talk: every, hold, stable and timeout take a number"; goto invalid; }
                    if(!strcmp(words[i],"every")) st.every=(u64)w; else if(!strcmp(words[i],"hold")) st.hold=(u64)w; else if(!strcmp(words[i],"stable")) st.stable=(u64)w; else if(!strcmp(words[i],"timeout")) st.timeout=(u64)w;
                    else { why="unknown option for @talk (every, hold, stable, timeout)"; goto invalid; }
                    i+=2; }
                if(st.hold>=st.every){ why="@talk: hold must be shorter than every (a press needs a release before the next)"; goto invalid; }
            } else if(!strcmp(words[0],"@react")){                /* @react [id N] until COND [every P] [hold H] [timeout N] (task 31) */
                st.type=ST_REACT; st.every=20; st.hold=2; i=1;
                if(i+1<n && !strcmp(words[i],"id")){ long long w; if(!number(words[i+1],1,65535,&w)){ char *e; errno=0; w=words[i+1][0]=='0'&&words[i+1][1]=='x'?strtoll(words[i+1]+2,&e,16):-1;
                        if(w<1 || w>65535 || errno || *e){ why="@react id N: N is a command id (1..65535)"; goto invalid; } }
                    st.react_id=(int)w; i+=2; }
                if(i+1<n && !strcmp(words[i],"on")){ if(strlen(words[i+1])>=sizeof st.obj_name){ why="@react on NAME: NAME is an object's model name (at most 39 characters)"; goto invalid; }
                    snprintf(st.obj_name,sizeof st.obj_name,"%s",words[i+1]); st.to_object=1; i+=2; }
                if(i>=n || strcmp(words[i],"until")){ why="@react [id N] [on NAME] until COND [every P] [hold H] [timeout N]"; goto invalid; }
                i++; if(!parse_cond(words,n,&i,&st.c,&why)) goto invalid; st.has_until=1;
                while(i<n){ long long w; if(i+1>=n || !number(words[i+1],1,100000000,&w)){ why="@react: every, hold and timeout take a number"; goto invalid; }
                    if(!strcmp(words[i],"every")) st.every=(u64)w; else if(!strcmp(words[i],"hold")) st.hold=(u64)w; else if(!strcmp(words[i],"timeout")) st.timeout=(u64)w;
                    else { why="unknown option for @react (id, until, every, hold, timeout)"; goto invalid; }
                    i+=2; }
                if(st.hold>=st.every){ why="@react: hold must be shorter than every (a press needs a release before the next)"; goto invalid; }
            } else if(!strcmp(words[0],"@skip")){                 /* @skip until COND [every P] [hold H] [timeout N] (task 30) */
                st.type=ST_SKIP; st.every=30; st.hold=2;
                if(n<3 || strcmp(words[1],"until")){ why="@skip until COND [every P] [hold H] [timeout N]"; goto invalid; }
                i=2; if(!parse_cond(words,n,&i,&st.c,&why)) goto invalid; st.has_until=1;
                while(i<n){ long long w; if(i+1>=n || !number(words[i+1],1,100000000,&w)){ why="@skip: every, hold and timeout take a number"; goto invalid; }
                    if(!strcmp(words[i],"every")) st.every=(u64)w; else if(!strcmp(words[i],"hold")) st.hold=(u64)w; else if(!strcmp(words[i],"timeout")) st.timeout=(u64)w;
                    else { why="unknown option for @skip (every, hold, timeout)"; goto invalid; }
                    i+=2; }
            } else if(!strcmp(words[0],"@fight")){                /* @fight until COND [radius R] [every P] [hold H] [stall N] [timeout N] (task 30) */
                st.type=ST_FIGHT; st.radius=150.0f; st.every=20; st.hold=3; st.stall=600;
                while(i<n){
                    if(!strcmp(words[i],"until")){ if(st.has_until){ why="@fight: one `until` only"; goto invalid; } i++; if(!parse_cond(words,n,&i,&st.c,&why)) goto invalid; st.has_until=1; continue; }
                    long long w; if(i+1>=n || !number(words[i+1],1,100000000,&w)){ why="@fight: radius, every, hold, stall and timeout take a number"; goto invalid; }
                    if(!strcmp(words[i],"radius")) st.radius=(float)w; else if(!strcmp(words[i],"every")) st.every=(u64)w; else if(!strcmp(words[i],"hold")) st.hold=(u64)w;
                    else if(!strcmp(words[i],"stall")) st.stall=(u64)w; else if(!strcmp(words[i],"timeout")) st.timeout=(u64)w;
                    else { why="unknown option for @fight (until, radius, every, hold, stall, timeout)"; goto invalid; }
                    i+=2;
                }
                if(!st.has_until){ why="@fight needs `until COND` (what ends the fight: e.g. until not mission, until enemies-at-most 0)"; goto invalid; }
                if(st.hold>=st.every){ why="@fight: hold must be shorter than every (a press needs a release before the next)"; goto invalid; }
            } else {
                st.type=ST_SELECT; st.hold=2;
                if(n<3){ why="@select title-choice|newgame-choice N (or command-row N, command-id N)"; goto invalid; }
                if(!parse_cond(words,n,&i,&st.c,&why)) goto invalid;
                if(st.c.neg || (st.c.kind!=KR_TITLE_CHOICE && st.c.kind!=KR_NEWGAME_CHOICE && st.c.kind!=KR_COMMAND_ROW && st.c.kind!=KR_COMMAND_ID && st.c.kind!=KR_PAUSE_ID && st.c.kind!=KR_MESSAGE_CHOICE)){
                    why="@select moves title-choice or newgame-choice (or the field command menu: command-row, command-id; the pause screen: pause-id; a choice window: message-choice)"; goto invalid; }
            }
            while(st.type!=ST_GOTO && st.type!=ST_FIGHT && st.type!=ST_SKIP && st.type!=ST_TALK && st.type!=ST_REACT && st.type!=ST_WARP && st.type!=ST_WARPLIST && i<n){                /* options: every P, hold H (@press), timeout T (every step but @expect) */
                long long v; if(i+1>=n || !number(words[i+1],1,100000000,&v)){ why="an option takes a number"; goto invalid; }
                if(!strcmp(words[i],"timeout") && st.type!=ST_EXPECT) st.timeout=(u64)v;
                else if(!strcmp(words[i],"every") && st.type==ST_PRESS) st.every=(u64)v;
                else if(!strcmp(words[i],"hold") && st.type==ST_PRESS) st.hold=(u64)v;
                else { why="unknown option for this directive (timeout; @press also every, hold)"; goto invalid; }
                i+=2;
            }
            if(st.type==ST_PRESS && st.hold>=st.every){ why="@press: hold must be shorter than every (a press needs a release before the next)"; goto invalid; }
            if(st.c.arg==ARG_DIFFICULTY) uses_difficulty=1;
            Step *next=realloc(steps,(nsteps+1)*sizeof *steps); if(!next) kh_fatal(g,"scripted XInput: allocation failed");
            steps=next; steps[nsteps++]=st; continue;
        }
        if(words[0][0]=='@'){ why="unknown directive"; goto invalid; }
        if(words[0][0]=='+'){                              /* relative press of the last step */
            long long a,b,x=0,y=0;
            if(!nsteps){ why="a relative line (+A +B) needs a step (@wait, @press, @select, @expect, @goto, @fight, @skip, @talk, @react) before it"; goto invalid; }
            if((n!=3 && n!=5) || words[1][0]!='+' || !number(words[0]+1,1,100000000,&a) || !number(words[1]+1,a,100000000,&b)){ why="+A +B BUTTONS [lx ly] with 1 <= A <= B"; goto invalid; }
            if(n==5 && (!number(words[3],-32768,32767,&x)||!number(words[4],-32768,32767,&y))) goto invalid;
            ScriptPad pad={.lx=(s16)x,.ly=(s16)y}; if(!parse_buttons(words[2],&pad)) goto invalid;
            Step *s=&steps[nsteps-1];
            RelRange *next=realloc(s->rel,(s->nrel+1)*sizeof *s->rel); if(!next) kh_fatal(g,"scripted XInput: allocation failed");
            s->rel=next; s->rel[s->nrel++]=(RelRange){(u64)a,(u64)b,pad}; if((u64)b>s->maxb) s->maxb=(u64)b;
            continue;
        }
        if(n!=3 && n!=5) goto invalid;
        long long a,b,x=0,y=0;
        if(!number(words[0],0,LLONG_MAX,&a)||!number(words[1],a,LLONG_MAX,&b)) goto invalid;
        if(n==5 && (!number(words[3],-32768,32767,&x)||!number(words[4],-32768,32767,&y))) goto invalid;
        ScriptPad pad={.lx=x,.ly=y};
        if(!parse_buttons(words[2],&pad)) goto invalid;
        InputRange *next=realloc(ranges,(nranges+1)*sizeof *ranges);
        if(!next) kh_fatal(g,"scripted XInput: allocation failed"); ranges=next;
        ranges[nranges++]=(InputRange){a,b,pad}; if(!first_frame_line) first_frame_line=lineno;
        continue;
invalid: kh_fatal(g,"scripted XInput: invalid %s line %u%s%s",path,lineno,*why?": ":"",why);
    }
    if(ferror(f)) kh_fatal(g,"scripted XInput: read failed %s",path);
    fclose(f);
    if(clock_game && hold_frame<0) kh_fatal(g,"scripted XInput: %s: @clock game-frames needs an @hold line (the point from which game frames are counted)",path);
    if(nsteps && first_frame_line) kh_fatal(g,"scripted XInput: %s: line %u is a frame-numbered line (FROM TO, @hold or @clock) in a route of @wait / @press / @select / @expect steps; "
                                          "a route presses relative to the state it waited for (+A +B BUTTONS): the two kinds cannot be mixed",path,first_frame_line);
    if(nsteps){
        const char *e=getenv("KHNMC_ROUTE_DIFFICULTY");
        if(e&&*e){ if(e[0]<'0'||e[0]>'3'||e[1]) kh_fatal(g,"KHNMC_ROUTE_DIFFICULTY must be one of 0,1,2,3 (0 Beginner, 1 Standard, 2 Critical, 3 Less Than Nothing)"); route_difficulty=e[0]-'0'; route_difficulty_from=" (KHNMC_ROUTE_DIFFICULTY)"; }
        { int cond=0; for(size_t i=0;i<nsteps;i++) if(steps[i].only>=0) cond=1; if(cond) uses_difficulty=1; }
        if(uses_difficulty && route_difficulty<0) kh_fatal(g,"scripted XInput: %s uses `difficulty` in a condition but sets none: add `@difficulty N` or set KHNMC_ROUTE_DIFFICULTY",path);
        for(size_t i=0;i<nsteps;i++) if(steps[i].c.arg==ARG_DIFFICULTY) steps[i].c.arg=route_difficulty;
        { size_t k=0, dropped=0; for(size_t i=0;i<nsteps;i++){ if(steps[i].only>=0 && steps[i].only!=route_difficulty){ free(steps[i].rel); dropped++; continue; } steps[k++]=steps[i]; }   /* @if-difficulty */
          nsteps=k; if(dropped) kh_warn("scripted XInput: %zu step(s) of another difficulty (@if-difficulty) left out",dropped); }
        { const char *x=getenv("KHNMC_ROUTE_END"); route_exit_at_end=0;
          if(x&&*x){ if(!strcmp(x,"exit")) route_exit_at_end=1; else if(strcmp(x,"idle")) kh_fatal(g,"KHNMC_ROUTE_END=%s: known values are idle (the default: after the last step the pad stays released) and exit (the run ends, exit 0)",x); } }
        kh_warn("scripted XInput pad 0: route of %zu steps from %s (difficulty %d%s; game-frame clock; after the last step: %s)",nsteps,path,route_difficulty,route_difficulty_from,route_exit_at_end?"exit":"idle");
    } else kh_warn("scripted XInput pad 0: %zu ranges from %s",nranges,path);
}
/* Successful pad samples are ordered by input_lock. A held pad costs one
 * transition regardless of how many times the polling worker reads it. */
static KhPadHistory history;
static size_t history_capacity, replay_index;
static const KhPadHistory *replay;
static void resize_history(size_t n){
    if(n<=history_capacity) return;
    size_t cap=n+128;
    if(cap<n || cap>SIZE_MAX/sizeof(KhPadChange)) kh_fatal(NULL,"savestate-pad-history-size");
    void *p=realloc(history.changes,cap*sizeof(KhPadChange));
    if(!p) kh_fatal(NULL,"savestate-pad-history-memory");
    history.changes=p; history_capacity=cap;
}
static void cut_pad_sample(ScriptPad *pad){
    if(replay && history.polls<replay->polls){
        if(replay_index<replay->count && replay->changes[replay_index].poll==history.polls) replay_index++;
        if(!replay_index) kh_fatal(NULL,"savestate-pad-history-first");
        memcpy(pad,replay->changes[replay_index-1].pad,sizeof *pad);
    }
    if(!history.count||memcmp(history.changes[history.count-1].pad,pad,sizeof *pad)){
        resize_history(history.count+1);
        KhPadChange *c=history.changes+history.count++;
        *c=(KhPadChange){.poll=history.polls};
        memcpy(c->pad,pad,sizeof *pad);
    }
    history.polls++;
}
void kh_pad_capture(KhPadHistory *out){
    pthread_mutex_lock(&input_lock);
    *out=history;
    out->changes=history.count?malloc(history.count*sizeof *history.changes):NULL;
    if(history.count){
        if(!out->changes) kh_fatal(NULL,"savestate-pad-history-memory");
        memcpy(out->changes,history.changes,history.count*sizeof *history.changes);
    }
    pthread_mutex_unlock(&input_lock);
}
void kh_pad_restore(const KhPadHistory *saved){
    pthread_mutex_lock(&input_lock);
    resize_history(saved->count);
    if(saved->count) memcpy(history.changes,saved->changes,saved->count*sizeof *saved->changes);
    history.count=saved->count; history.polls=saved->polls; replay=NULL;
    pthread_mutex_unlock(&input_lock);
}
int kh_pad_bootstrap(const KhPadHistory *saved){
    pthread_mutex_lock(&input_lock);
    size_t n=0;
    while(n<saved->count&&saved->changes[n].poll<history.polls) n++;
    int ok=history.polls<=saved->polls && n==history.count &&
        (!n || !memcmp(saved->changes,history.changes,n*sizeof *saved->changes));
    if(ok){ replay=saved; replay_index=n; }
    pthread_mutex_unlock(&input_lock);
    return ok;
}
int kh_pad_caught_up(void){
    pthread_mutex_lock(&input_lock);
    int ok=replay && history.polls==replay->polls && history.count==replay->count;
    pthread_mutex_unlock(&input_lock);
    return ok;
}
void kh_pad_stop_bootstrap(void){
    pthread_mutex_lock(&input_lock); replay=NULL; pthread_mutex_unlock(&input_lock);
}
u32 kh_input_state(KCtx *g,u32 slot,u64 out,u64 frame){
    if(!pad_source()||slot) return 1167;
    if(!out) return 87;
    ScriptPad pad={0};
    pthread_mutex_lock(&input_lock);
    if(nsteps) pad=route_pad;                               /* a route: the pad route_tick computed for this game frame */
    else if(scripted){ for(size_t i=0;i<nranges;i++) if(frame>=ranges[i].start && frame<=ranges[i].end) pad=ranges[i].pad; }
    else { pad=host_pad; pad.buttons|=host_latched; host_latched=0; }   /* the shell's controller (KHNMC_INPUT=host); a tap shorter than a frame is seen once */
    if(kh_cut_enabled) cut_pad_sample(&pad);
    if(!packet || memcmp(&last_pad,&pad,sizeof pad)){ packet++; last_pad=pad; }
    wr32(g,out,packet); wr16(g,out+4,pad.buttons); wr8(g,out+6,pad.lt); wr8(g,out+7,pad.rt);
    wr16(g,out+8,(u16)pad.lx); wr16(g,out+10,(u16)pad.ly); wr16(g,out+12,(u16)pad.rx); wr16(g,out+14,(u16)pad.ry);   /* scripts leave rx/ry 0 */
    pthread_mutex_unlock(&input_lock); return 0;
}
static void input_get(KCtx *g){ kh_cnt_input_calls++; u64 pr=atomic_load(&gfx_presents), sf=nsteps?atomic_load(&game_frames):script_frame(pr); if(!nsteps) hold_check(g,pr);
    atomic_store(&last_script_frame,sf); SET_RAX(g,kh_input_state(g,(u32)A0(g),A1(g),sf)); }
IMP(xinput1_4,XInputGetState){ input_get(g); }
IMP(xinput1_4,XInputGetStateEx){ input_get(g); }
IMP(xinput1_4,ord100){ input_get(g); }
static int C_di,C_dev;
static int h_di(KCtx *g,u64 o,int s,const char *c){ (void)o;(void)c;
    if(s==3){ wr64(g,A2(g),kh_com_obj(C_dev,16)); SET_RAX(g,0); return 1; }          /* CreateDevice(guid, **ppDevice, outer) */
    SET_RAX(g,0); return 1; }                                                          /* EnumDevices etc.: S_OK, no callbacks */
static int h_dev(KCtx *g,u64 o,int s,const char *c){ (void)o;(void)c;
    if(s==9){ memset(hp(g,A2(g)),0,(size_t)(u32)A1(g)); SET_RAX(g,0); return 1; }    /* GetDeviceState(cb, data): all zero */
    SET_RAX(g,0); return 1; }
void kh_seam_input_init(void){ kh_cut_init(); kh_autosave_init(); kh_xion_init(); kh_input_load(NULL,getenv("KHNMC_INPUT_SCRIPT"));
    { const char *e=getenv("KH_RUN_GAME_FRAMES"); if(e&&*e) run_game_frames=strtoull(e,0,0); }
    { const char *im=getenv("KHNMC_INPUT"); extern int kh_run_is_selftest;
      if(im&&*im&&strcmp(im,"host")&&strcmp(im,"script")) kh_fatal(NULL,"KHNMC_INPUT=%s: known values are host (the platform's game controller as pad 0) and script (KHNMC_INPUT_SCRIPT only)",im);
      if(im&&!strcmp(im,"host")){
          if(scripted) kh_warn("input: KHNMC_INPUT=host is not used: an input script is loaded (KHNMC_INPUT_SCRIPT)");
          else if(kh_run_is_selftest) kh_warn("input: KHNMC_INPUT=host is not used in a selftest run");
          else { host_pad_on=1; kh_warn("input: host pad 0: the platform's game controller (KHNMC_INPUT=host)"); } } }
    if(pad_source()){

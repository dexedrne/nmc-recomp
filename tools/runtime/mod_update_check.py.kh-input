#!/usr/bin/env python3
"""mod_update_check.py - is a Nobody May Cry checkout the version this port is built from?  If not: what changed, and which steps of the
port must be redone, in order (task 34).

  mod_update_check.py [--fingerprint FILE] [--exe EXE] [--json OUT] [--quiet-files] NEW_MOD_DIR     compare a checkout with the pin
  mod_update_check.py --write-fingerprint MOD_DIR [--fingerprint FILE] [--edit-list FILE] [--exe EXE] re-pin (after a port update)
  mod_update_check.py --remote                    print the command that shows whether the public repository has new commits
  mod_update_check.py --selftest                  comparison logic on small synthetic mod trees (no game or mod data needed)

The port follows ONE version of the PC mod (the public repository ProjectNobodyMayCry/SillyBillyMod1).  `mod/nmc-version.json` (the
"fingerprint", committed: hashes, counts and addresses only) records that version: every file's path, size and sha256; mod.yml's asset
list; for each of the three DLLs its sha256, the functions the port was derived from (bounds from the DLL's own unwind table, .pdata)
with a hash of their bytes, and for KH2Tweaks_Refactor.dll the detour table, the 114-entry script system call table and the static-edit
list as the port records them; the ini keys and values as the DLLs read them; the mod's added script calls each script uses; the counts
the port's selftests pin.  docs/MOD-VERSION-INVENTORY.md says what in the port depends on each of them, docs/MOD-UPDATES.md is the
procedure.

What the comparison does (everything is read; nothing is written except --json OUT and, with --write-fingerprint, the fingerprint):
  * files: added, removed, changed, and "line endings only" (a text file whose bytes differ but whose content with CR LF / CR turned into
    LF is the same).  Every changed path is put into a KIND by its place in the mod (mod.yml, a DLL, an ini file, the DLL's own data
    files, HD textures, scripts, area files, ...).  A path that fits no known kind is reported as UNKNOWN, loudly, never dropped.
  * mod.yml: assets added / removed, a method other than `copy` (the bake tool refuses those), sources that are not the file of the same
    name, top-level keys.
  * ini files: per key, with the semantics of GetPrivateProfileString as the DLLs use it (first occurrence wins, value trimmed, an inline
    `#comment` is PART of the value: that is why the AntiForm options read as off); for each changed key what in the port depends on it.
  * DLLs: sha256; then, statically (objdump listing + the PE file; no DLL code is run): the .pdata bounds and bytes of every function the
    pin records, and a NORMALISED hash (instruction text with addresses replaced by what they name: an import, a string, a constant, an
    exe function the slot's signature scanner resolves to, a place in the same function) that survives a rebuild that only moved code,
    and a DEEP hash (the function and every DLL function it can reach).  For KH2Tweaks_Refactor.dll the detour table is re-derived from
    the new DLL (every call of Detours' DetourAttach / DetourAttachEx, found by its byte signature, with the slot and handler it is given)
    and matched row by row: same handler bytes / moved but the same code / code changed (re-audit) / removed; a detour the pin does not
    have is NEW.  The script system call table is re-read from its builder function and compared entry by entry.  "Reaches" includes
    leaf routines without a .pdata entry (a tail jump to one too), and identical bytes are "same" only when the deep hash is too.
    The ini keys the port depends on are compared as the DLL reads them: the key still named, the loader / initialiser that reads
    it (hashed like a handler: no handler reaches those), the default for an absent key (decoded from the loader).
  * names in any letter case (Windows and Panacea do not see it); a case-only rename of a file the port opens by its exact name
    (dll/KH2Moose.ini) is loud.
  * data the port's subsets were chosen from: the item effect kinds of 03system.bin (the item-effect port has only the kinds the
    shipped items use) and the extra files the DLL probes for; the gummi removal is redone after every bake.
  * scripts: every BAR / BDX of the checkout is scanned with tools/bdxscan.py; the table-3 calls (the mod's added script system calls)
    each file uses are compared with the pin; a call the port does not implement is a step of its own.
Exit status: 0 = identical (every file byte for byte), 1 = changes found, 2 = usage error or an input that cannot be read.
`--remote` only PRINTS a `git ls-remote` command: this tool never touches the network.
"""
import argparse, collections, hashlib, io, json, os, re, shutil, struct, subprocess, sys, tempfile
sys.dont_write_bytecode = True

HERE = os.path.dirname(os.path.abspath(__file__))
PORT = os.path.dirname(HERE)
DEFAULT_FP = os.path.join(PORT, 'mod', 'nmc-version.json')
DEFAULT_EXE = os.path.join(PORT, 'pc', 'kh2fm.exe')
DEFAULT_EDITS = '/home/user/projects/kh2-nmc-analysis/scratch/mod-gummi/edit_list.json'   # Makefile MOD_EDITS
REPO = 'ProjectNobodyMayCry/SillyBillyMod1'
REMOTE = 'https://github.com/ProjectNobodyMayCry/SillyBillyMod1.git'
SCHEMA = 2          # 2 (task 34 review): ini-key records, leaf callees in the hashes, derived inline slots, item kinds, case map
TEXT_EXT = ('.ini', '.yml', '.yaml', '.txt', '.lua', '.json', '.md', '.cfg', '.csv', '.log')
EXE_SHA256 = '9002b2de6a1f91a790bd0673de125d1cf833f7942bfec827cdcf6ba64d5849ed'   # the pinned kh2fm.exe (Steam build)

TWEAKS = 'dll/KH2Tweaks_Refactor.dll'
MOOSE = 'dll/KH2Moose.dll'
NEVERLAND = 'dll/NeverlandFly.dll'
KNOWN_DLLS = (TWEAKS, MOOSE, NEVERLAND)


def sha256(b):
    return hashlib.sha256(b).hexdigest()


# =====================================================================================================================================
# files
# =====================================================================================================================================
def eol_normal(b):
    return b.replace(b'\r\n', b'\n').replace(b'\r', b'\n')


def file_info(path):
    """[size, sha256, sha256 of the LF-normalised text or None]"""
    size = os.path.getsize(path)
    if size <= (8 << 20):
        with open(path, 'rb') as f:
            b = f.read()
        lf = None
        if path.lower().endswith(TEXT_EXT) and b'\0' not in b:
            lf = sha256(eol_normal(b))
        return [len(b), sha256(b), lf]
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for blk in iter(lambda: f.read(1 << 22), b''):
            h.update(blk)
    return [size, h.hexdigest(), None]


def walk_tree(root):
    """relative path (forward slashes) -> [size, sha256, sha256_lf]; .git is skipped, a symbolic link is an error (a mod has none)"""
    out = {}
    for dp, dn, fn in os.walk(root):
        dn[:] = sorted(d for d in dn if d != '.git')
        for f in sorted(fn):
            p = os.path.join(dp, f)
            rel = os.path.relpath(p, root).replace(os.sep, '/')
            if os.path.islink(p):
                out[rel] = [-1, 'symlink:' + os.readlink(p), None]
                continue
            out[rel] = file_info(p)
    return out


# =====================================================================================================================================
# mod.yml (OpenKH mod description) and ini files
# =====================================================================================================================================
def parse_mod_yml(data):
    """-> dict(assets=[{name, method, sources:[{name, type?, ...}], extra:{}}], top={key: value}, unparsed=[lines]).  Handles the
    shapes OpenKH mods use (`- name:` / `  method:` / `  source:` / `  - name:` / `    type:`); any other line is kept in `unparsed`."""
    text = data.decode('utf-8', 'replace').replace('\r\n', '\n').replace('\r', '\n')
    assets, top, unparsed = [], {}, []
    cur = None
    for line in text.split('\n'):
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        m = re.match(r'^- name:\s*(.*?)\s*$', line)
        if m:
            cur = {'name': m.group(1).strip('"\''), 'method': 'copy', 'sources': [], 'extra': {}}
            assets.append(cur)
            continue
        m = re.match(r'^  - name:\s*(.*?)\s*$', line)
        if m and cur is not None:
            cur['sources'].append({'name': m.group(1).strip('"\'')})
            continue
        m = re.match(r'^    ([A-Za-z_][A-Za-z0-9_]*):\s*(.*?)\s*$', line)
        if m and cur is not None and cur['sources']:
            cur['sources'][-1][m.group(1)] = m.group(2).strip('"\'')
            continue
        m = re.match(r'^  ([A-Za-z_][A-Za-z0-9_]*):\s*(.*?)\s*$', line)
        if m and cur is not None:
            k, v = m.group(1), m.group(2).strip('"\'')
            if k == 'method':
                cur['method'] = v
            elif k == 'source' and v == '':
                pass
            else:
                cur['extra'][k] = v
            continue
        m = re.match(r'^([A-Za-z_][A-Za-z0-9_]*):\s*(.*?)\s*$', line)
        if m:
            cur = None
            if m.group(1) != 'assets':
                top[m.group(1)] = m.group(2)
            continue
        unparsed.append(line)
    return dict(assets=assets, top=top, unparsed=unparsed)


def norm_path(p):
    return p.replace('\\', '/').lstrip('/')


def asset_is_plain(a):
    """a `copy` asset whose one source is the mod file of the same name (all 4,861 of the pinned version)"""
    return (a['method'] == 'copy' and not a['extra'] and len(a['sources']) == 1 and set(a['sources'][0]) == {'name'}
            and norm_path(a['sources'][0]['name']).lower() == norm_path(a['name']).lower())


def parse_ini(data):
    """[[section, key, value], ...] in file order, as GetPrivateProfileStringA reads the file: `;` lines are comments, a key line is
    `key=value`, key and value trimmed, the value keeps an inline `#...` (the API does not strip it: that is why
    `antiform_tweaks=on #Makes ...` is not "on" for the DLL's boolean reader)."""
    text = data.decode('latin1').replace('\r\n', '\n').replace('\r', '\n')
    out, sec = [], None
    for ln in text.split('\n'):
        s = ln.strip()
        if not s or s[0] == ';':
            continue
        if s[0] == '[':
            sec = s[1:s.index(']')] if ']' in s else s[1:]
            continue
        if '=' in s:
            k, v = s.split('=', 1)
            out.append([sec, k.strip(), v.strip()])
    return out


def ini_effective(entries):
    """(section lower, key lower) -> value of the FIRST occurrence (what the API returns)"""
    d = {}
    for sec, k, v in entries:
        d.setdefault(((sec or '').lower(), k.lower()), v)
    return d


# =====================================================================================================================================
# PE files (stdlib only)
# =====================================================================================================================================
class PE:
    def __init__(self, data):
        r = self.raw = data
        if r[:2] != b'MZ':
            raise ValueError('not an MZ/PE file')
        pe = struct.unpack_from('<I', r, 0x3c)[0]
        if r[pe:pe + 4] != b'PE\0\0':
            raise ValueError('no PE header')
        self.machine, nsec, self.timestamp = struct.unpack_from('<HHI', r, pe + 4)
        optsz = struct.unpack_from('<H', r, pe + 20)[0]
        opt = pe + 24
        if struct.unpack_from('<H', r, opt)[0] != 0x20b:
            raise ValueError('not a PE32+ file')
        self.base = struct.unpack_from('<Q', r, opt + 24)[0]
        self.size_of_image = struct.unpack_from('<I', r, opt + 56)[0]
        self.entry = struct.unpack_from('<I', r, opt + 16)[0]
        ndd = struct.unpack_from('<I', r, opt + 108)[0]
        self.dd = [struct.unpack_from('<II', r, opt + 112 + 8 * i) for i in range(min(ndd, 16))]
        self.secs = []
        for i in range(nsec):
            o = opt + optsz + 40 * i
            name = r[o:o + 8].rstrip(b'\0').decode('latin1')
            vsz, va, rsz, rp = struct.unpack_from('<IIII', r, o + 8)
            chars = struct.unpack_from('<I', r, o + 36)[0]
            self.secs.append((name, va, vsz, rp, rsz, chars))
        img = bytearray(self.size_of_image)
        hdr = struct.unpack_from('<I', r, opt + 60)[0]
        img[:hdr] = r[:hdr]
        for name, va, vsz, rp, rsz, ch in self.secs:
            n = min(rsz, vsz) if vsz else rsz
            img[va:va + n] = r[rp:rp + n]
        self.img = bytes(img)
        self._funcs = None

    def section_of(self, rva):
        for s in self.secs:
            if s[1] <= rva < s[1] + max(s[2], s[4]):
                return s
        return None

    def u32(self, rva):
        return struct.unpack_from('<I', self.img, rva)[0]

    def cstr(self, rva, maxlen=256):
        if not (0 <= rva < len(self.img)):
            return None
        e = self.img.find(b'\0', rva, rva + maxlen)
        if e < 0:
            return None
        return self.img[rva:e]

    def exports(self):
        """rva -> sorted list of export names"""
        out = collections.defaultdict(list)
        rva, size = self.dd[0] if self.dd else (0, 0)
        if not rva:
            return {}
        nfun, nnames, afun, anames, aords = struct.unpack_from('<IIIII', self.img, rva + 20)
        for i in range(nnames):
            nm = self.cstr(self.u32(anames + 4 * i)).decode('latin1')
            ordi = struct.unpack_from('<H', self.img, aords + 2 * i)[0]
            out[self.u32(afun + 4 * ordi)].append(nm)
        return {k: sorted(v) for k, v in out.items()}

    def imports(self):
        """IAT rva -> 'dll!name'"""
        out = {}
        rva = self.dd[1][0] if len(self.dd) > 1 else 0
        while rva:
            oft, _, _, name, ft = struct.unpack_from('<IIIII', self.img, rva)
            if not name:
                break
            dll = self.cstr(name).decode('latin1').lower()
            k = 0
            while True:
                v = struct.unpack_from('<Q', self.img, (oft or ft) + 8 * k)[0]
                if not v:
                    break
                out[ft + 8 * k] = dll + '!' + (('#%d' % (v & 0xffff)) if v >> 63 else self.cstr(v + 2).decode('latin1'))
                k += 1
            rva += 20
        return out

    def functions(self):
        """primary begin rva -> sorted list of (begin, end) fragments, from the exception directory (.pdata); a fragment whose
        UNWIND_INFO carries UNW_FLAG_CHAININFO belongs to the function its chained entry names"""
        if self._funcs is not None:
            return self._funcs
        rva, size = self.dd[3] if len(self.dd) > 3 else (0, 0)
        ents = [struct.unpack_from('<III', self.img, rva + 12 * i) for i in range(size // 12)]
        byb = {b: (b, e, u) for b, e, u in ents}

        def root(ent, depth=0):
            b, e, u = ent
            if depth > 32 or not (0 < u < len(self.img) - 4):
                return b
            flags = self.img[u] >> 3
            if flags & 4:
                cnt = self.img[u + 2]
                o = u + 4 + 2 * ((cnt + 1) & ~1)
                pb, pe_, pu = struct.unpack_from('<III', self.img, o)
                par = byb.get(pb, (pb, pe_, pu))
                return root(par, depth + 1)
            return b
        f = collections.defaultdict(list)
        for ent in ents:
            if ent[0] == 0 and ent[1] == 0:
                continue
            f[root(ent)].append((ent[0], ent[1]))
        self._funcs = {k: sorted(set(v)) for k, v in f.items()}
        self._starts = sorted((b, e, k) for k, fr in self._funcs.items() for b, e in fr)
        return self._funcs

    def func_of(self, rva):
        """primary begin of the .pdata function that contains rva, or None"""
        self.functions()
        lo, hi = 0, len(self._starts)
        while lo < hi:
            mid = (lo + hi) // 2
            if self._starts[mid][0] <= rva:
                lo = mid + 1
            else:
                hi = mid
        if lo and self._starts[lo - 1][0] <= rva < self._starts[lo - 1][1]:
            return self._starts[lo - 1][2]
        return None

    def func_bytes(self, begin):
        return b''.join(self.img[b:e] for b, e in self.functions().get(begin, []))


# =====================================================================================================================================
# static listing (objdump) and normalised function hashes
# =====================================================================================================================================
class Listing:
    """objdump -d -Mintel of a PE file: (rva, text) per instruction; None when objdump is not installed"""
    def __init__(self, path, pe):
        self.ok = False
        self.ins, self.idx = [], {}
        exe = shutil.which('objdump')
        if not exe:
            self.err = 'objdump not found (binutils): the normalised hashes and the detour / syscall-table re-derivation are SKIPPED'
            return
        try:
            out = subprocess.run(['nice', '-n', '10', exe, '-d', '-Mintel', '--no-show-raw-insn', path], capture_output=True,
                                 text=True, check=True).stdout
        except Exception as e:
            self.err = 'objdump failed on %s: %s' % (path, e)
            return
        for ln in out.splitlines():
            m = re.match(r'^\s*([0-9a-f]+):\t(.*)$', ln)
            if m:
                a = int(m.group(1), 16) - pe.base
                self.idx[a] = len(self.ins)
                self.ins.append((a, m.group(2).strip()))
        self.ok = bool(self.ins)
        if not self.ok:
            self.err = 'objdump produced no instructions for %s' % path

    def range(self, b, e):
        i = self.idx.get(b)
        if i is None:
            return []
        out = []
        while i < len(self.ins) and self.ins[i][0] < e:
            out.append(self.ins[i])
            i += 1
        return out


class SlotResolver:
    """slot (a .data qword the DLL fills by a signature scan of the exe) -> exe rva, through tools/mod_dll_slots.py's scanner reader.
    Optional: without the exe or that module every slot stays unresolved; normalised hashes then write every global as 'G', detour
    rows have no exe target and are matched by their handler's code instead."""
    def __init__(self, dll_path, exe_path, listing):
        self.ok = False
        self.cache = {}
        try:
            sys.path.insert(0, HERE)
            import mod_dll_slots as M
            self.M = M
            if not exe_path or not os.path.isfile(exe_path):
                self.err = 'exe not found (%s): slots are not resolved' % exe_path
                return
            self.dll = M.PE(dll_path)
            self.exe = M.PE(exe_path)
            self.ins = [(a + M.DLL_BASE, t) for a, t in listing.ins]
            self.by_addr = {x[0]: i for i, x in enumerate(self.ins)}
            M.IMPORTS.clear(); M.IMPORTS.update(M.imports(self.dll))
            M.BY_TAG.clear(); M.RANGE_OK.clear()
            for i, (ad, t) in enumerate(self.ins):
                m = re.search(r'# 0x([0-9a-f]+)$', t)
                if m:
                    M.BY_TAG.setdefault(int(m.group(1), 16) - M.DLL_BASE, []).append(i)
            self.ok = True
        except SystemExit as e:
            self.err = 'mod_dll_slots stopped: %s' % e
        except Exception as e:
            self.err = 'mod_dll_slots not usable: %s' % e

    def resolve(self, slot):
        if not self.ok:
            return None
        if slot in self.cache:
            return self.cache[slot]
        v = None
        try:
            if slot in self.M.BY_TAG:
                r = self.M.resolve_scanner(self.ins, self.by_addr, self.dll, self.exe, slot)
                if 'value' in r:
                    v = r['value']
        except SystemExit:
            v = None
        except Exception:
            v = None
        self.cache[slot] = v
        return v


ADDR_RE = re.compile(r'0x(1800[0-9a-f]{5})\b')


def norm_function(pe, lst, begin, imports, exports, slots, frs, leaf_ref=None):
    """normalised instruction text of the function `begin` (fragments frs) and the DLL functions it refers to (calls, jumps, lea of
    a code address).  Addresses are replaced by what they name, so a rebuild that only moves code keeps the text.
    leaf_ref(rva): called for a code address that belongs to no .pdata function (a leaf routine: MSVC gives a function that touches
    neither the stack nor a non-volatile register no unwind entry); when it returns True the address is a function of its own (leaf
    bounds, DllInfo.leaf_bounds) and is followed like any callee, so a call to it, a jump to it (a tail jump: row 4's handler DLL
    0x2de50 ends with `jmp 0x2dd60`, the ability-level helper the port transcribes) and a lea of it all reach its code."""
    lines, refs = [], set()
    rdata = [s for s in pe.secs if s[0] in ('.rdata',)]

    def tok(va, text):
        rva = va - pe.base
        for b, e in frs:
            if b <= rva < e:
                return 'L%x' % (rva - begin)
        if rva in imports:
            return 'I:' + imports[rva]
        f = pe.func_of(rva)
        if f is not None:
            refs.add(f)
            return 'F' + ('+%x' % (rva - f) if rva != f else '') + (':' + exports[f][0] if f in exports else '')
        s = pe.section_of(rva)
        if s is None:
            return 'A?'
        if s[0] == '.text':
            if leaf_ref is not None and leaf_ref(rva):
                refs.add(rva)
                return 'F' + (':' + exports[rva][0] if rva in exports else '')
            return 'T'          # not an instruction start of the listing (data in .text): named only as "code"
        if s in rdata:
            st = pe.cstr(rva, 200)
            if st is not None and len(st) >= 2 and all(32 <= c < 127 or c in (9, 10, 13) for c in st):
                return 'S:' + st.decode('latin1')
            n = 16 if 'XMMWORD' in text else 8 if 'QWORD' in text else 4 if 'DWORD' in text else 2 if 'WORD' in text else 1 if 'BYTE' in text else 0
            return 'K:' + pe.img[rva:rva + n].hex() if n else 'R'
        x = slots.resolve(rva) if slots else None
        if x is not None:
            return 'X:%x' % x
        return 'G'
    for b, e in frs:
        for a, t in lst.range(b, e):
            m = re.search(r'\s+#\s+0x([0-9a-f]+)\s*(<[^>]*>)?$', t)
            body = t[:m.start()] if m else t
            body = re.sub(r'rip[+-]0x[0-9a-f]+', 'rip', body)
            body = ADDR_RE.sub(lambda mm: tok(int(mm.group(0), 16), body), body)
            body = re.sub(r'\s+', ' ', body)
            if m:
                body += ' ;' + tok(int(m.group(1), 16), t)
            lines.append(body)
    return '\n'.join(lines), refs


REG32 = {'eax': 'rax', 'ebx': 'rbx', 'ecx': 'rcx', 'edx': 'rdx', 'esi': 'rsi', 'edi': 'rdi', 'ebp': 'rbp', 'esp': 'rsp'}


def reg64(r):
    if r in REG32:
        return REG32[r]
    m = re.match(r'^(r\d+)[dwb]$', r)
    return m.group(1) if m else r


class DllInfo:
    """static facts of one DLL file: hashes of chosen functions, re-derived tables"""
    def __init__(self, path, exe_path=None, want_listing=True):
        self.path = path
        self.data = open(path, 'rb').read()
        self.sha256 = sha256(self.data)
        self.pe = PE(self.data)
        self.funcs = self.pe.functions()
        self.imports = self.pe.imports()
        self.exports = self.pe.exports()
        self.lst = Listing(path, self.pe) if want_listing else None
        self.slots = SlotResolver(path, exe_path, self.lst) if (self.lst and self.lst.ok and exe_path) else None
        self._norm = {}
        self.leaf = {}

    def frags(self, begin):
        return self.funcs.get(begin) or self.leaf.get(begin) or []

    def leaf_bounds(self, rva):
        """a function with no .pdata entry (a leaf: the two inline-detour handlers are such stubs): from rva to the first int3 at
        an instruction boundary, or to the next .pdata function, whichever comes first"""
        nxt = min([b for b in self.funcs if b > rva] + [len(self.pe.img)])
        end = nxt
        if self.lst and self.lst.ok and rva in self.lst.idx:
            for a, t in self.lst.range(rva, nxt):
                if t == 'int3':
                    end = a
                    break
        else:
            k = self.pe.img.find(b'\xcc\xcc', rva, nxt)
            end = k if k >= 0 else nxt
        return [(rva, end)]

    def leaf_ref(self, rva):
        """a code address no .pdata function contains: when it starts an instruction of the listing it becomes a leaf function
        (bounds: leaf_bounds) that norm() and deep() follow like any other.  -> True when it is one"""
        if rva in self.leaf:
            return True
        if not (self.lst and self.lst.ok and rva in self.lst.idx) or self.pe.func_of(rva) is not None:
            return False
        self.leaf[rva] = self.leaf_bounds(rva)
        return True

    def raw_hash(self, begin):
        fr = self.frags(begin)
        return sha256(b''.join(self.pe.img[b:e] for b, e in fr)) if fr else None

    def norm(self, begin):
        if begin not in self._norm:
            if not (self.lst and self.lst.ok) or not self.frags(begin):
                self._norm[begin] = (None, set())
            else:
                text, refs = norm_function(self.pe, self.lst, begin, self.imports, self.exports, self.slots, self.frags(begin),
                                           leaf_ref=self.leaf_ref)
                self._norm[begin] = (sha256(text.encode()), refs)
        return self._norm[begin]

    def deep(self, begin):
        """hash over the normalised hashes of every DLL function reachable from begin (begin included)"""
        if self.norm(begin)[0] is None:
            return None, 0
        seen, todo = set(), [begin]
        while todo:
            f = todo.pop()
            if f in seen:
                continue
            seen.add(f)
            todo.extend(self.norm(f)[1] - seen)
        return sha256('\n'.join(sorted(self.norm(f)[0] for f in seen)).encode()), len(seen)

    def func_record(self, rva):
        """the .pdata function containing rva: bounds and the three hashes"""
        f = self.pe.func_of(rva)
        bounds = 'pdata'
        if f is None:
            if not (0 < rva < len(self.pe.img)):
                return dict(rva=rva, error='0x%x is outside the image' % rva)
            f = rva
            self.leaf[f] = self.leaf_bounds(rva)
            bounds = 'leaf (no .pdata entry): to the first int3'
        dh, nreach = self.deep(f)
        fr = self.frags(f)
        return dict(rva=rva, begin=f, bounds=bounds, fragments=[list(x) for x in fr], size=sum(e - b for b, e in fr),
                    sha256=self.raw_hash(f), norm=self.norm(f)[0], deep=dh, reach=nreach)

    def by_norm(self):
        """normalised hash -> [begin] over every function of the DLL (for "moved but the same code")"""
        if not hasattr(self, '_bynorm'):
            d = collections.defaultdict(list)
            for f in self.funcs:
                h = self.norm(f)[0]
                if h:
                    d[h].append(f)
            self._bynorm = d
        return self._bynorm

    # ---- KH2Tweaks_Refactor.dll: Detours' attach calls ----------------------------------------------------------------------------
    # DetourAttach(ppPointer, pDetour) = DetourAttachEx(ppPointer, pDetour, NULL, NULL, NULL) as compiled into the pinned DLL (rva
    # 0x35d00): spill rdx / rcx, sub rsp,0x38, [rsp+0x20] = 0, r9d = r8d = 0, reload rdx / rcx, call DetourAttachEx.
    ATTACH_SIG = bytes.fromhex('@KHINPUT(hex,mod/dll/KH2Tweaks_Refactor.dll,217344,40,ae279f5c0fd557649d7719e924fb6827f6ddd3c140723327e230637e374194fd)@')

    def detour_sites(self):
        """-> dict(attach, attach_ex, sites=[{site, kind, slot, handler, func}], error)"""
        R = dict(attach=None, attach_ex=None, sites=[], error=None)
        hits = []
        p = self.pe.img.find(self.ATTACH_SIG)
        while p >= 0:
            hits.append(p)
            p = self.pe.img.find(self.ATTACH_SIG, p + 1)
        if len(hits) != 1:
            R['error'] = 'DetourAttach signature found %d times (expected once): the Detours library changed; derive the detour table by hand' % len(hits)
            return R
        att = hits[0]
        call = att + len(self.ATTACH_SIG) - 1
        ex = call + 5 + struct.unpack_from('<i', self.pe.img, call + 1)[0]
        R['attach'], R['attach_ex'] = att, ex
        if not (self.lst and self.lst.ok):
            R['error'] = self.lst.err if self.lst else 'no listing'
            return R
        for i, (a, t) in enumerate(self.lst.ins):
            m = re.match(r'call\s+0x([0-9a-f]+)$', t)
            if not m:
                continue
            tgt = int(m.group(1), 16) - self.pe.base
            if tgt not in (att, ex) or self.pe.func_of(a) == att:
                continue
            regs = {}
            for j in range(i - 1, max(-1, i - 14), -1):
                tj = self.lst.ins[j][1]
                if re.match(r'(call|ret|jmp|int3)\b', tj):
                    break
                m2 = re.match(r'lea\s+(rcx|rdx),\[rip[+-]0x[0-9a-f]+\]\s+#\s+0x([0-9a-f]+)', tj)
                if m2 and m2.group(1) not in regs:
                    regs[m2.group(1)] = int(m2.group(2), 16) - self.pe.base
                    continue
                m3 = re.match(r'(?:mov|lea|xor|movsxd|movzx|pop)\s+(rcx|rdx|ecx|edx),', tj)
                if m3:
                    r64 = 'r' + m3.group(1)[1:]
                    regs.setdefault(r64, None)
            ent = dict(site=a, kind='attach' if tgt == att else 'attach_ex', slot=regs.get('rcx'), handler=regs.get('rdx'),
                       func=self.pe.func_of(a))
            if ent['kind'] == 'attach_ex':
                # an inline site: the target is a place inside an exe function, formed as `mov REG,[slot]; add REG,N` in front of the
                # call (DLL 0x1bdd7 / 0x1bde7 for dualwield_forms, 0x1ee9d / 0x1eea4 for patch_ability_categories): exe = slot + N
                ent['slot'], ent['site_add'] = None, None
                for j in range(i - 1, max(-1, i - 40), -1):
                    tj = self.lst.ins[j][1]
                    if re.match(r'(ret|int3)\b', tj):
                        break
                    m4 = re.match(r'add\s+(r\w+),0x([0-9a-f]+)$', tj)
                    if not m4:
                        continue
                    for k in range(j - 1, max(-1, j - 10), -1):
                        tk = self.lst.ins[k][1]
                        m5 = re.match(r'mov\s+%s,QWORD PTR \[rip[+-]0x[0-9a-f]+\]\s+#\s+0x([0-9a-f]+)' % m4.group(1), tk)
                        if m5:
                            ent['slot'], ent['site_add'] = int(m5.group(1), 16) - self.pe.base, int(m4.group(2), 16)
                            break
                        if re.match(r'(?!test|cmp)\w+\s+%s,' % m4.group(1), tk) or re.match(r'(call|ret|jmp)\b', tk):
                            break
                    break
            R['sites'].append(ent)
        return R

    def function_strings(self, begin):
        """printable strings the function names through rip-relative operands (the ini keys an option initialiser reads)"""
        out = []
        if not (self.lst and self.lst.ok):
            return out
        for b, e in self.funcs.get(begin, []):
            for a, t in self.lst.range(b, e):
                m = re.search(r'#\s+0x([0-9a-f]+)', t)
                if not m:
                    continue
                rva = int(m.group(1), 16) - self.pe.base
                s = self.pe.section_of(rva)
                if not s or s[0] != '.rdata':
                    continue
                st = self.pe.cstr(rva, 120)
                if st and len(st) >= 3 and all(32 <= c < 127 for c in st):
                    out.append(st.decode('latin1'))
        return out

    # ---- KH2Tweaks_Refactor.dll: the ini keys the port depends on, as the DLL reads them ----------------------------------------------
    # The option loaders (DLL 0x20590 damage percent, 0x21090 AP / HP / MP multipliers, 0x22440 drive_add_mult, the option
    # initialisers) build the key as a std::string from a NUL-terminated .rdata string (`lea rdx,[key]; call <ctor>`), then call the
    # reader (0x2ab00 integer, 0x2ad10 float, 0x2a840 boolean) with the key, the section and the file name; the 4th argument is the
    # default for an absent key (r9d for the integer reader, xmm3 for the float reader; the boolean reader takes none).  No handler
    # reaches these functions (they only read the stored global), so they are recorded here: a new key name, default or parse is a
    # step even when every detour handler is byte-identical.
    def key_sites(self):
        """lower-cased printable .rdata string -> [(listing index, site rva)] of every `lea reg,[rip+X]` that names it (cached)"""
        if getattr(self, '_keysites', None) is not None:
            return self._keysites
        out = collections.defaultdict(list)
        if self.lst and self.lst.ok:
            for i, (a, t) in enumerate(self.lst.ins):
                m = re.match(r'lea\s+\w+,\[rip[+-]0x[0-9a-f]+\]\s+#\s+0x([0-9a-f]+)', t)
                if not m:
                    continue
                r = int(m.group(1), 16) - self.pe.base
                s = self.pe.section_of(r)
                if not s or s[0] != '.rdata':
                    continue
                st = self.pe.cstr(r, 120)
                if st and len(st) >= 2 and all(32 <= c < 127 for c in st):
                    out[st.decode('latin1').lower()].append((i, a))
        self._keysites = out
        return out

    def _xmm_source(self, k, reg, lo):
        """the value the last write before listing index k gives xmm register `reg` (searching back to index lo)"""
        for j in range(k - 1, lo - 1, -1):
            t = self.lst.ins[j][1]
            m = re.match(r'(\w+)\s+%s,(.*)$' % reg, t)
            if not m:
                continue
            op, src = m.group(1), m.group(2)
            if op in ('xorps', 'pxor', 'xorpd') and src.strip() == reg:
                return 0.0, '%s = 0 at DLL 0x%x' % (reg, self.lst.ins[j][0])
            mm = re.match(r'DWORD PTR \[rip[+-]0x[0-9a-f]+\]\s+#\s+0x([0-9a-f]+)', src)
            if op == 'movss' and mm:
                r = int(mm.group(1), 16) - self.pe.base
                return struct.unpack_from('<f', self.pe.img, r)[0], '%s = float [DLL 0x%x] at DLL 0x%x' % (reg, r, self.lst.ins[j][0])
            mm = re.match(r'(xmm\d+)$', src.strip())
            if op in ('movaps', 'movss', 'movups', 'movapd') and mm:
                v, how = self._xmm_source(j, mm.group(1), lo)
                return v, '%s = %s at DLL 0x%x; %s' % (reg, mm.group(1), self.lst.ins[j][0], how)
            return None, '%s written by `%s` at DLL 0x%x (not decoded)' % (reg, t, self.lst.ins[j][0])
        return None, '%s not written in the function before the call' % reg

    def key_read(self, i):
        """the read that follows the key's lea at listing index i: the first direct call is the std::string constructor, the next call
        to another function is the reader.  -> dict(reader, default, default_type, default_how)"""
        a0 = self.lst.ins[i][0]
        f = self.pe.func_of(a0)
        fr = self.funcs.get(f, []) if f is not None else []
        lo = self.lst.idx.get(fr[0][0], i) if fr else i
        ctor = reader = None
        j = i + 1
        while j < len(self.lst.ins) and j < i + 120:
            a, t = self.lst.ins[j]
            if fr and not any(b <= a < e for b, e in fr):
                break
            if re.match(r'ret\b', t):
                break
            m = re.match(r'call\s+0x([0-9a-f]+)$', t)
            if m:
                tgt = int(m.group(1), 16) - self.pe.base
                if ctor is None:
                    ctor = tgt
                elif tgt != ctor:
                    reader = tgt
                    break
            j += 1
        if reader is None:
            return dict(reader=None, default=None, default_type=None, default_how='no reader call follows the key at DLL 0x%x' % a0)
        for k in range(j - 1, i, -1):
            t = self.lst.ins[k][1]
            if re.match(r'\w+\s+xmm3,', t):
                v, how = self._xmm_source(k + 1, 'xmm3', lo)
                return dict(reader=reader, default=v, default_type='float', default_how=how)
            m = re.match(r'(xor|mov)\s+(r9d|r9),(.*)$', t)
            if m:
                if m.group(1) == 'xor' and m.group(3) == m.group(2):
                    return dict(reader=reader, default=0, default_type='int', default_how='r9d = 0 at DLL 0x%x' % self.lst.ins[k][0])
                mm = re.match(r'0x([0-9a-f]+)$', m.group(3))
                if m.group(1) == 'mov' and mm:
                    return dict(reader=reader, default=int(mm.group(1), 16), default_type='int',
                                default_how='r9d = 0x%s at DLL 0x%x' % (mm.group(1), self.lst.ins[k][0]))
                return dict(reader=reader, default=None, default_type='int', default_how='r9 written by `%s` (not decoded)' % t)
            if re.match(r'\w+\s+r9[dwb]?,', t):
                return dict(reader=reader, default=None, default_type='int', default_how='r9 written by `%s` (not decoded)' % t)
        return dict(reader=reader, default=None, default_type=None,
                    default_how='no 4th argument written before the reader call (a reader without a default: absent = off / empty)')

    def ini_key_record(self, key):
        """-> dict(named, sites, functions, reader, default, default_type, default_how) for one ini key"""
        ss = self.key_sites().get(key.lower(), [])
        rec = dict(named=bool(ss), sites=[a for i, a in ss], functions=sorted({self.pe.func_of(a) for i, a in ss} - {None}))
        rec.update(self.key_read(ss[0][0]) if ss else dict(reader=None, default=None, default_type=None, default_how='not named'))
        return rec

    # ---- KH2Tweaks_Refactor.dll: the script system call table (VM directory slot 3) -------------------------------------------------
    def syscall_table(self):
        """re-read the table builder: the function with the most `lea reg,[exported function]`; it allocates the table, keeps its
        address in a global, and stores {handler, flags} pairs through a register loaded from that global.  -> dict(builder, table
        global, entries=[{index, handler, names, flags}], error)"""
        R = dict(builder=None, table_global=None, entries=[], error=None)
        if not (self.lst and self.lst.ok):
            R['error'] = self.lst.err if self.lst else 'no listing'
            return R
        cnt = collections.Counter()
        for a, t in self.lst.ins:
            m = re.match(r'lea\s+\w+,\[rip[+-]0x[0-9a-f]+\]\s+#\s+0x([0-9a-f]+)', t)
            if m and int(m.group(1), 16) - self.pe.base in self.exports:
                f = self.pe.func_of(a)
                if f is not None:
                    cnt[f] += 1
        if not cnt:
            R['error'] = 'no function takes the address of exported functions: table builder not found'
            return R
        bld, n = cnt.most_common(1)[0]
        if n < 50:
            R['error'] = 'table builder candidate 0x%x names only %d exported functions' % (bld, n)
            return R
        R['builder'] = bld
        regs, slots, gl = {}, {}, collections.Counter()
        for b, e in self.funcs[bld]:
            for a, t in self.lst.range(b, e):
                m = re.match(r'lea\s+(\w+),\[rip[+-]0x[0-9a-f]+\]\s+#\s+0x([0-9a-f]+)', t)
                if m:
                    regs[m.group(1)] = ('fn', int(m.group(2), 16) - self.pe.base)
                    continue
                m = re.match(r'mov\s+(\w+),QWORD PTR \[rip[+-]0x[0-9a-f]+\]\s+#\s+0x([0-9a-f]+)', t)
                if m:
                    regs[m.group(1)] = ('glob', int(m.group(2), 16) - self.pe.base)
                    continue
                m = re.match(r'mov\s+QWORD PTR \[(\w+)(?:\+0x([0-9a-f]+))?\],(\w+|0x[0-9a-f]+)$', t)
                if m and regs.get(m.group(1), ('',))[0] == 'glob':
                    g = regs[m.group(1)][1]
                    off = int(m.group(2) or '0', 16)
                    v = m.group(3)
                    val = ('imm', int(v, 16)) if v.startswith('0x') else regs.get(reg64(v), ('?',))
                    slots.setdefault(g, {})[off] = val
                    gl[g] += 1
                    continue
                m = re.match(r'xor\s+(\w+),(\w+)$', t)
                if m and m.group(1) == m.group(2):
                    regs[reg64(m.group(1))] = ('imm', 0)
                    continue
                m = re.match(r'mov\s+(\w+),(0x[0-9a-f]+)$', t)
                if m:
                    regs[reg64(m.group(1))] = ('imm', int(m.group(2), 16))
                    continue
                m = re.match(r'(?:mov|lea|xor|add|sub|or|and|movsxd|movzx|pop|inc|dec|shl|shr)\s+(\w+)', t)
                if m:
                    regs.pop(reg64(m.group(1)), None)
                if t.startswith('call'):
                    for r in ('rax', 'rcx', 'rdx', 'r8', 'r9', 'r10', 'r11'):
                        regs.pop(r, None)
        if not gl:
            R['error'] = 'no stores through a table global in 0x%x' % bld
            return R
        g = gl.most_common(1)[0][0]
        R['table_global'] = g
        tab = slots[g]
        n = max(tab) // 16 + 1
        for i in range(n):
            h, fl = tab.get(16 * i), tab.get(16 * i + 8)
            ent = dict(index=i, handler=h[1] if h and h[0] == 'fn' else None, flags=fl[1] if fl and fl[0] == 'imm' else None)
            ent['names'] = self.exports.get(ent['handler'], []) if ent['handler'] is not None else []
            R['entries'].append(ent)
        return R


# =====================================================================================================================================
# scripts: table-3 system calls (the mod's added calls) per file
# =====================================================================================================================================
def scan_scripts(root, files=None):
    """-> dict(files_scanned, scripts, uses={relpath: {trap: [entry, callback, sweep, raw]}})"""
    sys.path.insert(0, HERE)
    import bdxscan
    out = {}
    nfiles = nbdx = 0
    rels = sorted(files) if files is not None else None
    if rels is None:
        rels = []
        for dp, dn, fn in os.walk(root):
            dn[:] = sorted(d for d in dn if d != '.git')
            for f in sorted(fn):
                rels.append(os.path.relpath(os.path.join(dp, f), root).replace(os.sep, '/'))
    for rel in rels:
        p = os.path.join(root, rel)
        try:
            with open(p, 'rb') as fh:
                magic = fh.read(4)
        except OSError:
            continue
        if magic != b'BAR\x01' and not p.lower().endswith('.bdx'):
            continue
        nfiles += 1
        for lab, r in bdxscan.scan_file(p):
            nbdx += 1
            for t, tr, pc, cls in r['syscalls']:
                if t != 3:
                    continue
                u = out.setdefault(rel, {}).setdefault(str(tr), [0, 0, 0, 0])
                u[('entry', 'callback', 'sweep', 'raw').index(cls)] += 1
    return dict(files_scanned=nfiles, scripts=nbdx, uses=out)


def traps_used(uses, include_raw=False):
    s = set()
    for rel, d in uses.items():
        for tr, c in d.items():
            if sum(c[:3]) or (include_raw and c[3]):
                s.add(int(tr))
    return s


